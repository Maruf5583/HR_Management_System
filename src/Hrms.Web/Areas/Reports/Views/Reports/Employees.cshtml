@model EmployeeReportViewModel
@{
    ViewData["Title"] = "Employee Directory Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-people me-2 text-primary"></i>Employee Directory Report</h4>
        <p class="text-muted small mb-0">Complete organization headcount, designations, pay scales, and employment details</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportEmployees"
           asp-route-departmentId="@Model.Filter.DepartmentId"
           asp-route-designationId="@Model.Filter.DesignationId"
           asp-route-employmentType="@Model.Filter.EmploymentType"
           asp-route-status="@Model.Filter.Status"
           class="btn btn-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
    </div>
</div>

<!-- Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Department</label>
                <select name="departmentId" class="form-select bg-light border-0" asp-items="Model.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Designation</label>
                <select name="designationId" class="form-select bg-light border-0" asp-items="Model.Designations">
                    <option value="">All Designations</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Employment Type</label>
                <select name="employmentType" class="form-select bg-light border-0">
                    <option value="">All Employment Types</option>
                    @foreach (EmploymentType et in Enum.GetValues(typeof(EmploymentType)))
                    {
                        <option value="@et" selected="@(Model.Filter.EmploymentType == et ? "selected" : null)">@et</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select bg-light border-0">
                    <option value="">All Statuses</option>
                    @foreach (EmployeeStatus st in Enum.GetValues(typeof(EmployeeStatus)))
                    {
                        <option value="@st" selected="@(Model.Filter.Status == st ? "selected" : null)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100" title="Filter"><i class="bi bi-funnel"></i></button>
                <a asp-action="Employees" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3">EMPLOYEE</th>
                        <th class="py-3">DEPARTMENT & DESIGNATION</th>
                        <th class="py-3">CONTACT</th>
                        <th class="py-3">GRADE / SALARY</th>
                        <th class="py-3">JOIN DATE</th>
                        <th class="py-3 text-center" style="width: 130px;">TYPE</th>
                        <th class="py-3 pe-4 text-center" style="width: 110px;">STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Employees.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No employee records found matching the specified filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emp in Model.Employees)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-semibold text-dark">@emp.FullName</div>
                                    <small class="text-muted">@emp.EmployeeCode</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@emp.DepartmentName</div>
                                    <small class="text-muted">@emp.DesignationTitle</small>
                                </td>
                                <td>
                                    <div><i class="bi bi-envelope me-1 text-muted"></i>@emp.Email</div>
                                    <small class="text-muted"><i class="bi bi-telephone me-1"></i>@emp.Phone</small>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@emp.GradeCode</span>
                                    <div class="small fw-semibold text-dark mt-1">@emp.Salary.ToString("N2") ৳</div>
                                </td>
                                <td>
                                    <div class="small">@emp.JoinDate.ToString("yyyy-MM-dd")</div>
                                    @if (emp.ExitDate.HasValue)
                                    {
                                        <small class="text-danger d-block">Exit: @emp.ExitDate.Value.ToString("yyyy-MM-dd")</small>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-secondary border">@emp.EmploymentType</span>
                                </td>
                                <td class="pe-4 text-center">
                                    @switch (emp.Status)
                                    {
                                        case EmployeeStatus.Active:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                            break;
                                        case EmployeeStatus.OnNotice:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">On Notice</span>
                                            break;
                                        case EmployeeStatus.Resigned:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Resigned</span>
                                            break;
                                        case EmployeeStatus.Terminated:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Terminated</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
