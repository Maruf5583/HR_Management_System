@model AssetReportViewModel
@{
    ViewData["Title"] = "Asset Inventory Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-laptop me-2 text-primary"></i>Asset Inventory Report</h4>
        <p class="text-muted small mb-0">Hardware inventory, custodian allocations, conditions, and operational status</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportAssets"
           asp-route-category="@Model.Filter.Category"
           asp-route-status="@Model.Filter.Status"
           asp-route-departmentId="@Model.Filter.DepartmentId"
           class="btn btn-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
    </div>
</div>

<!-- Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Category</label>
                <select name="category" class="form-select bg-light border-0">
                    <option value="">All Categories</option>
                    @foreach (AssetCategory cat in Enum.GetValues(typeof(AssetCategory)))
                    {
                        <option value="@cat" selected="@(Model.Filter.Category == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select bg-light border-0">
                    <option value="">All Statuses</option>
                    @foreach (AssetStatus st in Enum.GetValues(typeof(AssetStatus)))
                    {
                        <option value="@st" selected="@(Model.Filter.Status == st ? "selected" : null)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold mb-1">Assigned Department</label>
                <select name="departmentId" class="form-select bg-light border-0" asp-items="Model.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
                <a asp-action="Assets" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Table Card -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3">ASSET TAG</th>
                        <th class="py-3">NAME & SERIAL</th>
                        <th class="py-3">CATEGORY</th>
                        <th class="py-3 text-center" style="width: 120px;">CONDITION</th>
                        <th class="py-3 text-center" style="width: 120px;">STATUS</th>
                        <th class="py-3">ASSIGNED TO</th>
                        <th class="py-3 pe-4" style="width: 150px;">ASSIGNED DATE</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Assets.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No assets found matching the specified filters.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var a in Model.Assets)
                        {
                            <tr>
                                <td class="ps-4 py-3 fw-semibold">
                                    <span class="badge bg-light text-primary border">@a.AssetTag</span>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@a.Name</div>
                                    <small class="text-muted">@(a.SerialNumber ?? "No S/N")</small>
                                </td>
                                <td>@a.Category</td>
                                <td class="text-center">
                                    @switch (a.Condition)
                                    {
                                        case AssetCondition.New:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">New</span>
                                            break;
                                        case AssetCondition.Good:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Good</span>
                                            break;
                                        case AssetCondition.Fair:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Fair</span>
                                            break;
                                        case AssetCondition.Damaged:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Damaged</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    @switch (a.Status)
                                    {
                                        case AssetStatus.Available:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle">Available</span>
                                            break;
                                        case AssetStatus.Assigned:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Assigned</span>
                                            break;
                                        case AssetStatus.InRepair:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">In Repair</span>
                                            break;
                                        case AssetStatus.Retired:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Retired</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(a.AssignedToFullName))
                                    {
                                        <div class="fw-medium text-dark">@a.AssignedToFullName</div>
                                        <small class="text-muted">@a.AssignedToEmployeeCode (@a.AssignedToDepartment)</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><em>Unassigned</em></span>
                                    }
                                </td>
                                <td class="pe-4 small text-muted">
                                    @(a.AssignedAtUtc?.ToString("yyyy-MM-dd") ?? "-")
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
