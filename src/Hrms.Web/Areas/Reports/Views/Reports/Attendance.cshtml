@model AttendanceReportViewModel
@{
    ViewData["Title"] = "Attendance Report";
    ViewData["Subtitle"] = "Filtered attendance records, work hour calculations, and status summary";
    var summary = Model.Summary;

    var selectedDeptName = "All Departments";
    if (Model.Filter.DepartmentId.HasValue && Model.Departments != null)
    {
        var match = Model.Departments.FirstOrDefault(d => d.Value == Model.Filter.DepartmentId.Value.ToString());
        if (match != null) selectedDeptName = match.Text;
    }

    var selectedStatusText = Model.Filter.Status.HasValue ? Model.Filter.Status.Value.ToString() : "All Statuses";
    var selectedEmpName = "All Employees";
    if (Model.Filter.EmployeeId.HasValue && Model.Employees != null)
    {
        var match = Model.Employees.FirstOrDefault(e => e.Value == Model.Filter.EmployeeId.Value.ToString());
        if (match != null) selectedEmpName = match.Text;
    }
}

<!-- Action Bar (Right-Aligned, Clean Text Only, No Redundant Headings) -->
<div class="d-flex justify-content-end gap-2 mb-3">
    <a asp-action="ExportAttendance"
       asp-route-fromDate="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))"
       asp-route-toDate="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))"
       asp-route-departmentId="@Model.Filter.DepartmentId"
       asp-route-employeeId="@Model.Filter.EmployeeId"
       asp-route-status="@Model.Filter.Status"
       class="btn btn-sm btn-success px-3 py-2 fw-semibold rounded-3 shadow-xs">
        Export to Excel
    </a>
    <a asp-action="Index" class="btn btn-sm btn-light border px-3 py-2 fw-semibold rounded-3 text-secondary shadow-xs">
        Reports Hub
    </a>
</div>

<!-- EmplowHR-Style Filter Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; border: 1px solid #eaecf0 !important; background: #ffffff;">
    <div class="card-body p-3">
        <form method="get" id="reportAttendanceFilterForm" class="row g-2.5 align-items-end">
            <!-- From Date -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">From Date</label>
                <input type="date" name="fromDate" class="form-control bg-light border-0" style="height: 38px; font-size: 0.83rem;" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <!-- To Date -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">To Date</label>
                <input type="date" name="toDate" class="form-control bg-light border-0" style="height: 38px; font-size: 0.83rem;" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>

            <!-- Searchable Department Dropdown (No Icon) -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Department</label>
                <input type="hidden" name="departmentId" id="filterAttDeptId" value="@(Model.Filter.DepartmentId?.ToString() ?? "")" />
                <div class="dropdown">
                    <button class="filter-pill-dropdown w-100 justify-content-between @(Model.Filter.DepartmentId.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="attDeptBtn">
                        <span id="attDeptBtnText" class="text-truncate">@selectedDeptName</span>
                        <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                    </button>
                    <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 250px;">
                        <div class="filter-dropdown-search">
                            <i class="bi bi-search"></i>
                            <input type="text" class="filter-dropdown-search-input" placeholder="Search departments..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                        </div>
                        <ul class="filter-dropdown-list list-unstyled mb-0">
                            <li>
                                <a class="dropdown-item @(!Model.Filter.DepartmentId.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('filterAttDeptId', '', 'All Departments', 'attDeptBtnText')">
                                    <span>All Departments</span>
                                    @if (!Model.Filter.DepartmentId.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                </a>
                            </li>
                            @if (Model.Departments != null)
                            {
                                @foreach (var dept in Model.Departments)
                                {
                                    if (!string.IsNullOrEmpty(dept.Value))
                                    {
                                        var isSel = Model.Filter.DepartmentId.HasValue && Model.Filter.DepartmentId.Value.ToString() == dept.Value;
                                        <li>
                                            <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('filterAttDeptId', '@dept.Value', '@dept.Text', 'attDeptBtnText')">
                                                <span>@dept.Text</span>
                                                @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Searchable Employee Dropdown (No Icon) -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Employee</label>
                <input type="hidden" name="employeeId" id="filterAttEmpId" value="@(Model.Filter.EmployeeId?.ToString() ?? "")" />
                <div class="dropdown">
                    <button class="filter-pill-dropdown w-100 justify-content-between @(Model.Filter.EmployeeId.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="attEmpBtn">
                        <span id="attEmpBtnText" class="text-truncate">@selectedEmpName</span>
                        <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                    </button>
                    <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 260px;">
                        <div class="filter-dropdown-search">
                            <i class="bi bi-search"></i>
                            <input type="text" class="filter-dropdown-search-input" placeholder="Search employees by name..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                        </div>
                        <ul class="filter-dropdown-list list-unstyled mb-0">
                            <li>
                                <a class="dropdown-item @(!Model.Filter.EmployeeId.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('filterAttEmpId', '', 'All Employees', 'attEmpBtnText')">
                                    <span>All Employees</span>
                                    @if (!Model.Filter.EmployeeId.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                </a>
                            </li>
                            @if (Model.Employees != null)
                            {
                                @foreach (var emp in Model.Employees)
                                {
                                    if (!string.IsNullOrEmpty(emp.Value))
                                    {
                                        var isSel = Model.Filter.EmployeeId.HasValue && Model.Filter.EmployeeId.Value.ToString() == emp.Value;
                                        <li>
                                            <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('filterAttEmpId', '@emp.Value', '@emp.Text', 'attEmpBtnText')">
                                                <span>@emp.Text</span>
                                                @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                            </a>
                                        </li>
                                    }
                                }
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Searchable Status Dropdown (No Icon) -->
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-secondary mb-1">Status</label>
                <input type="hidden" name="status" id="filterAttStatusId" value="@(Model.Filter.Status?.ToString() ?? "")" />
                <div class="dropdown">
                    <button class="filter-pill-dropdown w-100 justify-content-between @(Model.Filter.Status.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="attStatusBtn">
                        <span id="attStatusBtnText" class="text-truncate">@selectedStatusText</span>
                        <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                    </button>
                    <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 200px;">
                        <div class="filter-dropdown-search">
                            <i class="bi bi-search"></i>
                            <input type="text" class="filter-dropdown-search-input" placeholder="Search statuses..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                        </div>
                        <ul class="filter-dropdown-list list-unstyled mb-0">
                            <li>
                                <a class="dropdown-item @(!Model.Filter.Status.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('filterAttStatusId', '', 'All Statuses', 'attStatusBtnText')">
                                    <span>All Statuses</span>
                                    @if (!Model.Filter.Status.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                </a>
                            </li>
                            @foreach (var st in Enum.GetValues<AttendanceStatus>())
                            {
                                var isSel = Model.Filter.Status == st;
                                <li>
                                    <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('filterAttStatusId', '@st', '@st', 'attStatusBtnText')">
                                        <span>@st</span>
                                        @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center px-3 flex-grow-1" style="height: 38px;" title="Apply Filter">
                    <i class="bi bi-funnel me-1"></i>
                    <span>Filter</span>
                </button>
                <a asp-action="Attendance" class="btn btn-light border text-secondary d-inline-flex align-items-center justify-content-center px-2.5" style="height: 38px;" title="Reset Filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

@if (summary != null)
{
    <!-- Metrics Row (EmplowHR Top Summary Cards) -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm p-3 h-100 text-center" style="border-radius: 14px; background: #ffffff; border: 1px solid #eaecf0 !important;">
                <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Total Records</span>
                <h3 class="fw-bold text-dark mb-0 mt-1" style="font-size: 1.6rem;">@summary.TotalRecords</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm p-3 h-100 text-center" style="border-radius: 14px; background: #ffffff; border: 1px solid #eaecf0 !important;">
                <span class="text-success small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Present</span>
                <h3 class="fw-bold text-success mb-0 mt-1" style="font-size: 1.6rem;">@summary.PresentCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm p-3 h-100 text-center" style="border-radius: 14px; background: #ffffff; border: 1px solid #eaecf0 !important;">
                <span class="text-warning small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Late</span>
                <h3 class="fw-bold text-warning mb-0 mt-1" style="font-size: 1.6rem;">@summary.LateCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm p-3 h-100 text-center" style="border-radius: 14px; background: #ffffff; border: 1px solid #eaecf0 !important;">
                <span class="text-info small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Half Day</span>
                <h3 class="fw-bold text-info mb-0 mt-1" style="font-size: 1.6rem;">@summary.HalfDayCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm p-3 h-100 text-center" style="border-radius: 14px; background: #ffffff; border: 1px solid #eaecf0 !important;">
                <span class="text-danger small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Absent</span>
                <h3 class="fw-bold text-danger mb-0 mt-1" style="font-size: 1.6rem;">@summary.AbsentCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm p-3 h-100 text-center" style="border-radius: 14px; background: #ffffff; border: 1px solid #eaecf0 !important;">
                <span class="text-primary small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">On Leave</span>
                <h3 class="fw-bold text-primary mb-0 mt-1" style="font-size: 1.6rem;">@summary.OnLeaveCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm p-3 h-100 text-center" style="border-radius: 14px; background: #ffffff; border: 1px solid #eaecf0 !important;">
                <span class="text-secondary small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.05em;">Holiday / Off</span>
                <h3 class="fw-bold text-secondary mb-0 mt-1" style="font-size: 1.6rem;">@(summary.HolidayCount + summary.WeekendCount)</h3>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important; overflow: hidden; background: #ffffff;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                        <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                            <th class="ps-4 py-2.5" style="width: 120px;">Date</th>
                            <th class="py-2.5" style="min-width: 180px;">Employee</th>
                            <th class="py-2.5" style="min-width: 150px;">Department</th>
                            <th class="py-2.5" style="min-width: 120px;">Shift</th>
                            <th class="py-2.5" style="width: 100px;">Check In</th>
                            <th class="py-2.5" style="width: 100px;">Check Out</th>
                            <th class="py-2.5" style="width: 100px;">Late</th>
                            <th class="py-2.5" style="width: 110px;">Worked</th>
                            <th class="py-2.5 text-center" style="width: 110px;">Status</th>
                            <th class="py-2.5 pe-4">Note</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (summary.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No attendance records found matching the specified filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in summary.Items)
                            {
                                <tr>
                                    <td class="ps-4 py-2.5 fw-semibold text-dark">@row.WorkDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@row.FullName</div>
                                        <div class="text-muted small">@row.EmployeeCode</div>
                                    </td>
                                    <td>
                                        <div class="text-dark small">@row.DepartmentName</div>
                                        <div class="text-muted small">@row.DesignationTitle</div>
                                    </td>
                                    <td>
                                        <span class="small text-secondary">@(row.ShiftName ?? "—")</span>
                                    </td>
                                    <td class="small">@(row.CheckInTime?.ToString("HH:mm") ?? "—")</td>
                                    <td class="small">@(row.CheckOutTime?.ToString("HH:mm") ?? "—")</td>
                                    <td>
                                        @if (row.LateMinutes > 0)
                                        {
                                            <span class="text-warning fw-semibold small">@row.LateMinutes m</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.WorkedMinutes > 0)
                                        {
                                            <span class="small text-dark">@(row.WorkedMinutes / 60)h @(row.WorkedMinutes % 60)m</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @switch (row.Status)
                                        {
                                            case AttendanceStatus.Present:
                                                <span class="badge-status-dot badge-status-active">Present</span>
                                                break;
                                            case AttendanceStatus.Late:
                                                <span class="badge-status-dot badge-status-warning">Late</span>
                                                break;
                                            case AttendanceStatus.HalfDay:
                                                <span class="badge-status-dot badge-status-warning">Half Day</span>
                                                break;
                                            case AttendanceStatus.Absent:
                                                <span class="badge-status-dot badge-status-danger">Absent</span>
                                                break;
                                            case AttendanceStatus.OnLeave:
                                                <span class="badge-status-dot badge-status-purple">On Leave</span>
                                                break;
                                            case AttendanceStatus.Holiday:
                                                <span class="badge-status-dot badge-status-neutral">Holiday</span>
                                                break;
                                            case AttendanceStatus.Weekend:
                                                <span class="badge-status-dot badge-status-neutral">Weekend</span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-4 text-muted small">@(string.IsNullOrWhiteSpace(row.Note) ? "—" : row.Note)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function filterDropdownMenuOptions(input) {
            const query = input.value.trim().toLowerCase();
            const list = input.closest('.filter-dropdown-menu').querySelector('.filter-dropdown-list');
            if (!list) return;
            const items = list.querySelectorAll('li');
            items.forEach(li => {
                const text = li.textContent.trim().toLowerCase();
                if (!query || text.includes(query)) {
                    li.style.display = '';
                } else {
                    li.style.display = 'none';
                }
            });
        }

        function selectSearchableReportFilter(inputId, value, label, btnTextId) {
            const input = document.getElementById(inputId);
            if (input) input.value = value;
            const btnText = document.getElementById(btnTextId);
            if (btnText) btnText.textContent = label;
            const btn = btnText ? btnText.closest('.filter-pill-dropdown') : null;
            if (btn) {
                if (value) {
                    btn.classList.add('is-filtered');
                } else {
                    btn.classList.remove('is-filtered');
                }
            }
            if (inputId === 'filterAttDeptId') {
                const empInput = document.getElementById('filterAttEmpId');
                if (empInput) empInput.value = '';
            }
            const form = document.getElementById('reportAttendanceFilterForm');
            if (form) form.submit();
        }
    </script>
}