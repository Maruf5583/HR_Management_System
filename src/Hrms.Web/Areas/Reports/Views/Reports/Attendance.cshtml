@model AttendanceReportViewModel
@{
    ViewData["Title"] = "Attendance Report";
    var summary = Model.Summary;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-calendar-check me-2 text-primary"></i>Attendance Report</h4>
        <p class="text-muted small mb-0">Filtered attendance records, work hour calculations, and status summary</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportAttendance"
           asp-route-fromDate="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))"
           asp-route-toDate="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))"
           asp-route-departmentId="@Model.Filter.DepartmentId"
           asp-route-employeeId="@Model.Filter.EmployeeId"
           asp-route-status="@Model.Filter.Status"
           class="btn btn-success shadow-sm">
            <i class="bi bi-file-earmark-excel me-1"></i> Export to Excel
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
    </div>
</div>

<!-- Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">From Date</label>
                <input type="date" name="fromDate" class="form-control bg-light border-0" value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">To Date</label>
                <input type="date" name="toDate" class="form-control bg-light border-0" value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Department</label>
                <select name="departmentId" class="form-select bg-light border-0" asp-items="Model.Departments">
                    <option value="">All Departments</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-semibold mb-1">Employee</label>
                <select name="employeeId" class="form-select bg-light border-0" asp-items="Model.Employees">
                    <option value="">All Employees</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold mb-1">Status</label>
                <select name="status" class="form-select bg-light border-0">
                    <option value="">All Statuses</option>
                    @foreach (AttendanceStatus st in Enum.GetValues(typeof(AttendanceStatus)))
                    {
                        <option value="@st" selected="@(Model.Filter.Status == st ? "selected" : null)">@st</option>
                    }
                </select>
            </div>
            <div class="col-md-1 d-flex gap-1">
                <button type="submit" class="btn btn-primary w-100" title="Filter"><i class="bi bi-funnel"></i></button>
                <a asp-action="Attendance" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

@if (summary != null)
{
    <!-- Metrics Row -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Total Records</span>
                <h3 class="fw-bold text-dark mb-0 mt-2">@summary.TotalRecords</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Present</span>
                <h3 class="fw-bold text-success mb-0 mt-2">@summary.PresentCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Late</span>
                <h3 class="fw-bold text-warning-emphasis mb-0 mt-2">@summary.LateCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Half Day</span>
                <h3 class="fw-bold text-info-emphasis mb-0 mt-2">@summary.HalfDayCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Absent</span>
                <h3 class="fw-bold text-danger mb-0 mt-2">@summary.AbsentCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">On Leave</span>
                <h3 class="fw-bold text-primary mb-0 mt-2">@summary.OnLeaveCount</h3>
            </div>
        </div>
        <div class="col-6 col-md-3 col-xl">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Holiday / Off</span>
                <h3 class="fw-bold text-secondary mb-0 mt-2">@(summary.HolidayCount + summary.WeekendCount)</h3>
            </div>
        </div>
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4 py-3" style="width: 120px;">DATE</th>
                            <th class="py-3" style="min-width: 180px;">EMPLOYEE</th>
                            <th class="py-3">DEPARTMENT</th>
                            <th class="py-3">SHIFT</th>
                            <th class="py-3" style="width: 100px;">CHECK IN</th>
                            <th class="py-3" style="width: 100px;">CHECK OUT</th>
                            <th class="py-3" style="width: 100px;">LATE</th>
                            <th class="py-3" style="width: 120px;">WORKED</th>
                            <th class="py-3 text-center" style="width: 110px;">STATUS</th>
                            <th class="py-3 pe-4">NOTE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (summary.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No attendance records found matching the specified filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var row in summary.Items)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-semibold">@row.WorkDate.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@row.FullName</div>
                                        <small class="text-muted">@row.EmployeeCode</small>
                                    </td>
                                    <td>
                                        <div>@row.DepartmentName</div>
                                        <small class="text-muted">@row.DesignationTitle</small>
                                    </td>
                                    <td>@(row.ShiftName ?? "-")</td>
                                    <td>@(row.CheckInTime?.ToString("HH:mm") ?? "-")</td>
                                    <td>@(row.CheckOutTime?.ToString("HH:mm") ?? "-")</td>
                                    <td>
                                        @if (row.LateMinutes > 0)
                                        {
                                            <span class="text-danger fw-semibold">@row.LateMinutes m</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (row.WorkedMinutes > 0)
                                        {
                                            <span>@(row.WorkedMinutes / 60)h @(row.WorkedMinutes % 60)m</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @switch (row.Status)
                                        {
                                            case AttendanceStatus.Present:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Present</span>
                                                break;
                                            case AttendanceStatus.Late:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Late</span>
                                                break;
                                            case AttendanceStatus.HalfDay:
                                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">Half Day</span>
                                                break;
                                            case AttendanceStatus.Absent:
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Absent</span>
                                                break;
                                            case AttendanceStatus.OnLeave:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">On Leave</span>
                                                break;
                                            case AttendanceStatus.Holiday:
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Holiday</span>
                                                break;
                                            case AttendanceStatus.Weekend:
                                                <span class="badge bg-light text-muted border px-2 py-1">Weekend</span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-4 text-muted small">@row.Note</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
