@model LeaveReportViewModel
@{
    ViewData["Title"] = "Leave Reports";
    var isBalances = Model.ActiveTab == "balances";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-calendar2-range me-2 text-primary"></i>Leave Reports</h4>
        <p class="text-muted small mb-0">Overview of annual employee leave entitlements, usage, remaining balances, and applications</p>
    </div>
    <div class="d-flex gap-2">
        @if (isBalances)
        {
            <a asp-action="ExportLeaveBalances"
               asp-route-year="@Model.BalanceFilter.Year"
               asp-route-departmentId="@Model.BalanceFilter.DepartmentId"
               asp-route-leaveTypeId="@Model.BalanceFilter.LeaveTypeId"
               class="btn btn-success shadow-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Balances
            </a>
        }
        else
        {
            <a asp-action="ExportLeaveRecords"
               asp-route-fromDate="@(Model.RecordFilter.FromDate?.ToString("yyyy-MM-dd"))"
               asp-route-toDate="@(Model.RecordFilter.ToDate?.ToString("yyyy-MM-dd"))"
               asp-route-departmentId="@Model.RecordFilter.DepartmentId"
               asp-route-leaveTypeId="@Model.RecordFilter.LeaveTypeId"
               asp-route-status="@Model.RecordFilter.Status"
               class="btn btn-success shadow-sm">
                <i class="bi bi-file-earmark-excel me-1"></i> Export Records
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Reports Hub
        </a>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-pills mb-4 bg-white p-2 rounded-4 shadow-sm">
    <li class="nav-item">
        <a class="nav-link @(isBalances ? "active" : "")"
           asp-action="Leave" asp-route-tab="balances">
            <i class="bi bi-wallet2 me-1"></i> Leave Balances (Entitled vs Used)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(!isBalances ? "active" : "")"
           asp-action="Leave" asp-route-tab="records">
            <i class="bi bi-journal-text me-1"></i> Leave Applications & Records
        </a>
    </li>
</ul>

@if (isBalances)
{
    <!-- Balances Filter -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="tab" value="balances" />
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Year</label>
                    <input type="number" name="year" class="form-control bg-light border-0" value="@Model.BalanceFilter.Year" min="2020" max="2050" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold mb-1">Department</label>
                    <select name="departmentId" class="form-select bg-light border-0" asp-items="Model.Departments">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Leave Type</label>
                    <select name="leaveTypeId" class="form-select bg-light border-0" asp-items="Model.LeaveTypes">
                        <option value="">All Leave Types</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i> Filter</button>
                    <a asp-action="Leave" asp-route-tab="balances" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Balances Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4 py-3">EMPLOYEE</th>
                            <th class="py-3">DEPARTMENT</th>
                            <th class="py-3">LEAVE TYPE</th>
                            <th class="py-3 text-center" style="width: 100px;">YEAR</th>
                            <th class="py-3 text-center" style="width: 130px;">ENTITLED</th>
                            <th class="py-3 text-center" style="width: 130px;">USED</th>
                            <th class="py-3 pe-4 text-center" style="width: 130px;">REMAINING</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Balances.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No leave balances found matching the specified filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var b in Model.Balances)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-semibold text-dark">@b.FullName</div>
                                        <small class="text-muted">@b.EmployeeCode</small>
                                    </td>
                                    <td>@b.DepartmentName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@b.LeaveTypeName</span>
                                    </td>
                                    <td class="text-center">@b.Year</td>
                                    <td class="text-center fw-semibold text-muted">@b.Entitled d</td>
                                    <td class="text-center fw-semibold text-danger">@b.Used d</td>
                                    <td class="pe-4 text-center fw-bold text-success">@b.Remaining d</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <!-- Records Filter -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <input type="hidden" name="tab" value="records" />
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">From Date</label>
                    <input type="date" name="fromDate" class="form-control bg-light border-0" value="@(Model.RecordFilter.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">To Date</label>
                    <input type="date" name="toDate" class="form-control bg-light border-0" value="@(Model.RecordFilter.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold mb-1">Department</label>
                    <select name="departmentId" class="form-select bg-light border-0" asp-items="Model.Departments">
                        <option value="">All Departments</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">Leave Type</label>
                    <select name="leaveTypeId" class="form-select bg-light border-0" asp-items="Model.LeaveTypes">
                        <option value="">All Types</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold mb-1">Status</label>
                    <select name="status" class="form-select bg-light border-0">
                        <option value="">All Statuses</option>
                        @foreach (LeaveRecordStatus st in Enum.GetValues(typeof(LeaveRecordStatus)))
                        {
                            <option value="@st" selected="@(Model.RecordFilter.Status == st ? "selected" : null)">@st</option>
                        }
                    </select>
                </div>
                <div class="col-md-1 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100" title="Filter"><i class="bi bi-funnel"></i></button>
                    <a asp-action="Leave" asp-route-tab="records" class="btn btn-outline-secondary" title="Reset"><i class="bi bi-arrow-counterclockwise"></i></a>
                </div>
            </form>
        </div>
    </div>

    <!-- Records Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4 py-3">EMPLOYEE</th>
                            <th class="py-3">DEPARTMENT</th>
                            <th class="py-3">LEAVE TYPE</th>
                            <th class="py-3">PERIOD</th>
                            <th class="py-3 text-center" style="width: 100px;">DAYS</th>
                            <th class="py-3 text-center" style="width: 120px;">STATUS</th>
                            <th class="py-3 pe-4">REASON</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Records.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No leave records found matching the specified filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in Model.Records)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-semibold text-dark">@r.FullName</div>
                                        <small class="text-muted">@r.EmployeeCode</small>
                                    </td>
                                    <td>@r.DepartmentName</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@r.LeaveTypeName</span>
                                    </td>
                                    <td>
                                        <div class="small fw-semibold">@r.StartDate.ToString("yyyy-MM-dd") to @r.EndDate.ToString("yyyy-MM-dd")</div>
                                        @if (r.IsHalfDay)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle mt-1">Half Day</span>
                                        }
                                    </td>
                                    <td class="text-center fw-bold">@r.TotalDays d</td>
                                    <td class="text-center">
                                        @switch (r.Status)
                                        {
                                            case LeaveRecordStatus.Approved:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Approved</span>
                                                break;
                                            case LeaveRecordStatus.Pending:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Pending</span>
                                                break;
                                            case LeaveRecordStatus.Rejected:
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Rejected</span>
                                                break;
                                            case LeaveRecordStatus.Cancelled:
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-4 text-muted small">@r.Reason</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
