@model LeaveReportViewModel
@{
    ViewData["Title"] = "Leave Reports";
    ViewData["Subtitle"] = "Overview of annual employee leave entitlements, usage, remaining balances, and applications";
    var isBalances = Model.ActiveTab == "balances";

    var selectedBalDeptName = "All Departments";
    if (Model.BalanceFilter.DepartmentId.HasValue && Model.Departments != null)
    {
        var match = Model.Departments.FirstOrDefault(d => d.Value == Model.BalanceFilter.DepartmentId.Value.ToString());
        if (match != null) selectedBalDeptName = match.Text;
    }

    var selectedBalTypeName = "All Leave Types";
    if (Model.BalanceFilter.LeaveTypeId.HasValue && Model.LeaveTypes != null)
    {
        var match = Model.LeaveTypes.FirstOrDefault(t => t.Value == Model.BalanceFilter.LeaveTypeId.Value.ToString());
        if (match != null) selectedBalTypeName = match.Text;
    }

    var selectedRecDeptName = "All Departments";
    if (Model.RecordFilter.DepartmentId.HasValue && Model.Departments != null)
    {
        var match = Model.Departments.FirstOrDefault(d => d.Value == Model.RecordFilter.DepartmentId.Value.ToString());
        if (match != null) selectedRecDeptName = match.Text;
    }

    var selectedRecTypeName = "All Leave Types";
    if (Model.RecordFilter.LeaveTypeId.HasValue && Model.LeaveTypes != null)
    {
        var match = Model.LeaveTypes.FirstOrDefault(t => t.Value == Model.RecordFilter.LeaveTypeId.Value.ToString());
        if (match != null) selectedRecTypeName = match.Text;
    }

    var selectedRecStatusText = Model.RecordFilter.Status.HasValue ? Model.RecordFilter.Status.Value.ToString() : "All Statuses";
}

<!-- Action Bar (Right-Aligned, Clean Text Only, No Redundant Headings) -->
<div class="d-flex justify-content-end gap-2 mb-3">
    @if (isBalances)
    {
        <a asp-action="ExportLeaveBalances"
           asp-route-year="@Model.BalanceFilter.Year"
           asp-route-departmentId="@Model.BalanceFilter.DepartmentId"
           asp-route-leaveTypeId="@Model.BalanceFilter.LeaveTypeId"
           class="btn btn-sm btn-success px-3 py-2 fw-semibold rounded-3 shadow-xs">
            Export Balances
        </a>
    }
    else
    {
        <a asp-action="ExportLeaveRecords"
           asp-route-fromDate="@(Model.RecordFilter.FromDate?.ToString("yyyy-MM-dd"))"
           asp-route-toDate="@(Model.RecordFilter.ToDate?.ToString("yyyy-MM-dd"))"
           asp-route-departmentId="@Model.RecordFilter.DepartmentId"
           asp-route-leaveTypeId="@Model.RecordFilter.LeaveTypeId"
           asp-route-status="@Model.RecordFilter.Status"
           class="btn btn-sm btn-success px-3 py-2 fw-semibold rounded-3 shadow-xs">
            Export Records
        </a>
    }
    <a asp-action="Index" class="btn btn-sm btn-light border px-3 py-2 fw-semibold rounded-3 text-secondary shadow-xs">
        Reports Hub
    </a>
</div>

<!-- Tabs -->
<ul class="nav nav-pills mb-4 bg-white p-1.5 rounded-3 border d-inline-flex gap-1" style="border-color: #eaecf0 !important;">
    <li class="nav-item">
        <a class="nav-link @(isBalances ? "active fw-semibold shadow-xs" : "text-secondary") px-3 py-1.5 rounded-2" style="font-size: 0.85rem;"
           asp-action="Leave" asp-route-tab="balances">
            <i class="bi bi-wallet2 me-1.5"></i>Leave Balances (Entitled vs Used)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(!isBalances ? "active fw-semibold shadow-xs" : "text-secondary") px-3 py-1.5 rounded-2" style="font-size: 0.85rem;"
           asp-action="Leave" asp-route-tab="records">
            <i class="bi bi-journal-text me-1.5"></i>Leave Applications &amp; Records
        </a>
    </li>
</ul>

@if (isBalances)
{
    <!-- Balances Filter -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; border: 1px solid #eaecf0 !important; background: #ffffff;">
        <div class="card-body p-3">
            <form method="get" id="reportLeaveBalancesFilterForm" class="row g-2.5 align-items-end">
                <input type="hidden" name="tab" value="balances" />
                
                <!-- Year Input -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Year</label>
                    <input type="number" name="year" class="form-control bg-light border-0" style="height: 38px; font-size: 0.83rem;" value="@Model.BalanceFilter.Year" min="2020" max="2050" />
                </div>

                <!-- Searchable Department Dropdown -->
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary mb-1">Department</label>
                    <input type="hidden" name="departmentId" id="balDeptInput" value="@(Model.BalanceFilter.DepartmentId?.ToString() ?? "")" />
                    <div class="dropdown">
                        <button class="filter-pill-dropdown w-100 justify-content-between @(Model.BalanceFilter.DepartmentId.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="balDeptBtn">
                            <span id="balDeptBtnText" class="text-truncate">@selectedBalDeptName</span>
                            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                        </button>
                        <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 250px;">
                            <div class="filter-dropdown-search">
                                <i class="bi bi-search"></i>
                                <input type="text" class="filter-dropdown-search-input" placeholder="Search departments..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                            </div>
                            <ul class="filter-dropdown-list list-unstyled mb-0">
                                <li>
                                    <a class="dropdown-item @(!Model.BalanceFilter.DepartmentId.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('balDeptInput', '', 'All Departments', 'balDeptBtnText')">
                                        <span>All Departments</span>
                                        @if (!Model.BalanceFilter.DepartmentId.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                    </a>
                                </li>
                                @if (Model.Departments != null)
                                {
                                    @foreach (var dept in Model.Departments)
                                    {
                                        if (!string.IsNullOrEmpty(dept.Value))
                                        {
                                            var isSel = Model.BalanceFilter.DepartmentId.HasValue && Model.BalanceFilter.DepartmentId.Value.ToString() == dept.Value;
                                            <li>
                                                <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('balDeptInput', '@dept.Value', '@dept.Text', 'balDeptBtnText')">
                                                    <span>@dept.Text</span>
                                                    @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Searchable Leave Type Dropdown -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Leave Type</label>
                    <input type="hidden" name="leaveTypeId" id="balTypeInput" value="@(Model.BalanceFilter.LeaveTypeId?.ToString() ?? "")" />
                    <div class="dropdown">
                        <button class="filter-pill-dropdown w-100 justify-content-between @(Model.BalanceFilter.LeaveTypeId.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="balTypeBtn">
                            <span id="balTypeBtnText" class="text-truncate">@selectedBalTypeName</span>
                            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                        </button>
                        <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 250px;">
                            <div class="filter-dropdown-search">
                                <i class="bi bi-search"></i>
                                <input type="text" class="filter-dropdown-search-input" placeholder="Search leave types..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                            </div>
                            <ul class="filter-dropdown-list list-unstyled mb-0">
                                <li>
                                    <a class="dropdown-item @(!Model.BalanceFilter.LeaveTypeId.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('balTypeInput', '', 'All Leave Types', 'balTypeBtnText')">
                                        <span>All Leave Types</span>
                                        @if (!Model.BalanceFilter.LeaveTypeId.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                    </a>
                                </li>
                                @if (Model.LeaveTypes != null)
                                {
                                    @foreach (var lt in Model.LeaveTypes)
                                    {
                                        if (!string.IsNullOrEmpty(lt.Value))
                                        {
                                            var isSel = Model.BalanceFilter.LeaveTypeId.HasValue && Model.BalanceFilter.LeaveTypeId.Value.ToString() == lt.Value;
                                            <li>
                                                <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('balTypeInput', '@lt.Value', '@lt.Text', 'balTypeBtnText')">
                                                    <span>@lt.Text</span>
                                                    @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center px-3 flex-grow-1" style="height: 38px;" title="Apply Filter">
                        <i class="bi bi-funnel me-1"></i>
                        <span>Filter</span>
                    </button>
                    <a asp-action="Leave" asp-route-tab="balances" class="btn btn-light border text-secondary d-inline-flex align-items-center justify-content-center px-2.5" style="height: 38px;" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Balances Table -->
    <div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important; overflow: hidden; background: #ffffff;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                        <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                            <th class="ps-4 py-2.5">Employee</th>
                            <th class="py-2.5">Department</th>
                            <th class="py-2.5">Leave Type</th>
                            <th class="py-2.5 text-center" style="width: 100px;">Year</th>
                            <th class="py-2.5 text-center" style="width: 130px;">Entitled</th>
                            <th class="py-2.5 text-center" style="width: 130px;">Used</th>
                            <th class="py-2.5 pe-4 text-center" style="width: 130px;">Remaining</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Balances.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No leave balances found matching the specified filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Balances)
                            {
                                <tr>
                                    <td class="ps-4 py-2.5">
                                        <div class="fw-semibold text-dark">@item.FullName</div>
                                        <div class="text-muted small">@item.EmployeeCode</div>
                                    </td>
                                    <td>
                                        <span class="small text-dark">@(string.IsNullOrWhiteSpace(item.DepartmentName) ? "—" : item.DepartmentName)</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@item.LeaveTypeName</span>
                                    </td>
                                    <td class="text-center small">@item.Year</td>
                                    <td class="text-center font-medium">@item.Entitled d</td>
                                    <td class="text-center text-warning fw-semibold">@item.Used d</td>
                                    <td class="text-center pe-4">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 rounded-pill">
                                            @item.Remaining d
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
else
{
    <!-- Records Filter -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px; border: 1px solid #eaecf0 !important; background: #ffffff;">
        <div class="card-body p-3">
            <form method="get" id="reportLeaveRecordsFilterForm" class="row g-2.5 align-items-end">
                <input type="hidden" name="tab" value="records" />
                
                <!-- From Date -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">From Date</label>
                    <input type="date" name="fromDate" class="form-control bg-light border-0" style="height: 38px; font-size: 0.83rem;" value="@(Model.RecordFilter.FromDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- To Date -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">To Date</label>
                    <input type="date" name="toDate" class="form-control bg-light border-0" style="height: 38px; font-size: 0.83rem;" value="@(Model.RecordFilter.ToDate?.ToString("yyyy-MM-dd"))" />
                </div>

                <!-- Searchable Department Dropdown (No Icon) -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">Department</label>
                    <input type="hidden" name="departmentId" id="recDeptInput" value="@(Model.RecordFilter.DepartmentId?.ToString() ?? "")" />
                    <div class="dropdown">
                        <button class="filter-pill-dropdown w-100 justify-content-between @(Model.RecordFilter.DepartmentId.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="recDeptBtn">
                            <span id="recDeptBtnText" class="text-truncate">@selectedRecDeptName</span>
                            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                        </button>
                        <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 250px;">
                            <div class="filter-dropdown-search">
                                <i class="bi bi-search"></i>
                                <input type="text" class="filter-dropdown-search-input" placeholder="Search departments..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                            </div>
                            <ul class="filter-dropdown-list list-unstyled mb-0">
                                <li>
                                    <a class="dropdown-item @(!Model.RecordFilter.DepartmentId.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('recDeptInput', '', 'All Departments', 'recDeptBtnText')">
                                        <span>All Departments</span>
                                        @if (!Model.RecordFilter.DepartmentId.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                    </a>
                                </li>
                                @if (Model.Departments != null)
                                {
                                    @foreach (var dept in Model.Departments)
                                    {
                                        if (!string.IsNullOrEmpty(dept.Value))
                                        {
                                            var isSel = Model.RecordFilter.DepartmentId.HasValue && Model.RecordFilter.DepartmentId.Value.ToString() == dept.Value;
                                            <li>
                                                <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('recDeptInput', '@dept.Value', '@dept.Text', 'recDeptBtnText')">
                                                    <span>@dept.Text</span>
                                                    @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Searchable Leave Type Dropdown (No Icon) -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">Leave Type</label>
                    <input type="hidden" name="leaveTypeId" id="recTypeInput" value="@(Model.RecordFilter.LeaveTypeId?.ToString() ?? "")" />
                    <div class="dropdown">
                        <button class="filter-pill-dropdown w-100 justify-content-between @(Model.RecordFilter.LeaveTypeId.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="recTypeBtn">
                            <span id="recTypeBtnText" class="text-truncate">@selectedRecTypeName</span>
                            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                        </button>
                        <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 250px;">
                            <div class="filter-dropdown-search">
                                <i class="bi bi-search"></i>
                                <input type="text" class="filter-dropdown-search-input" placeholder="Search leave types..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                            </div>
                            <ul class="filter-dropdown-list list-unstyled mb-0">
                                <li>
                                    <a class="dropdown-item @(!Model.RecordFilter.LeaveTypeId.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('recTypeInput', '', 'All Types', 'recTypeBtnText')">
                                        <span>All Types</span>
                                        @if (!Model.RecordFilter.LeaveTypeId.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                    </a>
                                </li>
                                @if (Model.LeaveTypes != null)
                                {
                                    @foreach (var lt in Model.LeaveTypes)
                                    {
                                        if (!string.IsNullOrEmpty(lt.Value))
                                        {
                                            var isSel = Model.RecordFilter.LeaveTypeId.HasValue && Model.RecordFilter.LeaveTypeId.Value.ToString() == lt.Value;
                                            <li>
                                                <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('recTypeInput', '@lt.Value', '@lt.Text', 'recTypeBtnText')">
                                                    <span>@lt.Text</span>
                                                    @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                                </a>
                                            </li>
                                        }
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Searchable Status Dropdown (No Icon) -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">Status</label>
                    <input type="hidden" name="status" id="recStatusInput" value="@(Model.RecordFilter.Status?.ToString() ?? "")" />
                    <div class="dropdown">
                        <button class="filter-pill-dropdown w-100 justify-content-between @(Model.RecordFilter.Status.HasValue ? "is-filtered" : "")" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="recStatusBtn">
                            <span id="recStatusBtnText" class="text-truncate">@selectedRecStatusText</span>
                            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
                        </button>
                        <div class="dropdown-menu filter-dropdown-menu w-100 shadow-sm" style="min-width: 200px;">
                            <div class="filter-dropdown-search">
                                <i class="bi bi-search"></i>
                                <input type="text" class="filter-dropdown-search-input" placeholder="Search statuses..." autocomplete="off" oninput="filterDropdownMenuOptions(this)" />
                            </div>
                            <ul class="filter-dropdown-list list-unstyled mb-0">
                                <li>
                                    <a class="dropdown-item @(!Model.RecordFilter.Status.HasValue ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('recStatusInput', '', 'All Statuses', 'recStatusBtnText')">
                                        <span>All Statuses</span>
                                        @if (!Model.RecordFilter.Status.HasValue) { <i class="bi bi-check2 ms-auto"></i> }
                                    </a>
                                </li>
                                @foreach (var st in Enum.GetValues<LeaveRecordStatus>())
                                {
                                    var isSel = Model.RecordFilter.Status == st;
                                    <li>
                                        <a class="dropdown-item @(isSel ? "active" : "")" href="javascript:void(0)" onclick="selectSearchableReportFilter('recStatusInput', '@st', '@st', 'recStatusBtnText')">
                                            <span>@st</span>
                                            @if (isSel) { <i class="bi bi-check2 ms-auto"></i> }
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center px-3 flex-grow-1" style="height: 38px;" title="Apply Filter">
                        <i class="bi bi-funnel me-1"></i>
                        <span>Filter</span>
                    </button>
                    <a asp-action="Leave" asp-route-tab="records" class="btn btn-light border text-secondary d-inline-flex align-items-center justify-content-center px-2.5" style="height: 38px;" title="Reset Filters">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Records Table -->
    <div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important; overflow: hidden; background: #ffffff;">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                        <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                            <th class="ps-4 py-2.5">Employee</th>
                            <th class="py-2.5">Department</th>
                            <th class="py-2.5">Leave Type</th>
                            <th class="py-2.5">Period</th>
                            <th class="py-2.5 text-center" style="width: 100px;">Days</th>
                            <th class="py-2.5 text-center" style="width: 120px;">Status</th>
                            <th class="py-2.5 pe-4">Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Records.Count == 0)
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No leave applications found matching the specified filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var rec in Model.Records)
                            {
                                <tr>
                                    <td class="ps-4 py-2.5">
                                        <div class="fw-semibold text-dark">@rec.FullName</div>
                                        <div class="text-muted small">@rec.EmployeeCode</div>
                                    </td>
                                    <td>
                                        <span class="small text-dark">@(string.IsNullOrWhiteSpace(rec.DepartmentName) ? "—" : rec.DepartmentName)</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@rec.LeaveTypeName</span>
                                        @if (rec.IsHalfDay)
                                        {
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle ms-1">Half Day</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="small text-dark">@rec.StartDate.ToString("yyyy-MM-dd") <span class="text-muted">to</span> @rec.EndDate.ToString("yyyy-MM-dd")</div>
                                    </td>
                                    <td class="text-center fw-semibold">@rec.TotalDays d</td>
                                    <td class="text-center">
                                        @switch (rec.Status)
                                        {
                                            case LeaveRecordStatus.Approved:
                                                <span class="badge-status-dot badge-status-active">Approved</span>
                                                break;
                                            case LeaveRecordStatus.Pending:
                                                <span class="badge-status-dot badge-status-warning">Pending</span>
                                                break;
                                            case LeaveRecordStatus.Rejected:
                                                <span class="badge-status-dot badge-status-danger">Rejected</span>
                                                break;
                                            case LeaveRecordStatus.Cancelled:
                                                <span class="badge-status-dot badge-status-neutral">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td class="pe-4 text-muted small">@(string.IsNullOrWhiteSpace(rec.Reason) ? "—" : rec.Reason)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        function filterDropdownMenuOptions(input) {
            const query = input.value.trim().toLowerCase();
            const list = input.closest('.filter-dropdown-menu').querySelector('.filter-dropdown-list');
            if (!list) return;
            const items = list.querySelectorAll('li');
            items.forEach(li => {
                const text = li.textContent.trim().toLowerCase();
                if (!query || text.includes(query)) {
                    li.style.display = '';
                } else {
                    li.style.display = 'none';
                }
            });
        }

        function selectSearchableReportFilter(inputId, value, label, btnTextId) {
            const input = document.getElementById(inputId);
            if (input) input.value = value;
            const btnText = document.getElementById(btnTextId);
            if (btnText) btnText.textContent = label;
            const btn = btnText ? btnText.closest('.filter-pill-dropdown') : null;
            if (btn) {
                if (value) {
                    btn.classList.add('is-filtered');
                } else {
                    btn.classList.remove('is-filtered');
                }
            }
            const form = input ? input.closest('form') : null;
            if (form) form.submit();
        }
    </script>
}