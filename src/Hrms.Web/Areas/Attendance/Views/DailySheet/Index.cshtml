@model DailySheetViewModel
@{
    ViewData["Title"] = $"Daily Attendance - {Model.WorkDate:yyyy-MM-dd}";
    ViewData["Subtitle"] = "Record and review daily check-ins, check-outs, and calculated attendance";
    var prevDate = Model.WorkDate.AddDays(-1);
    var nextDate = Model.WorkDate.AddDays(1);
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<!-- Action Bar (Right-Aligned, Clean Text Only, No Redundant Headings) -->
<div class="d-flex justify-content-end align-items-center gap-2 mb-3">
    <a asp-action="Index" asp-route-date="@prevDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-light border text-secondary px-2.5 py-1.5 rounded-3 shadow-xs" title="Previous Day">
        <i class="bi bi-chevron-left"></i>
    </a>
    <form method="get" class="d-inline-flex gap-2 align-items-center">
        <input type="date" name="date" class="form-control form-control-sm shadow-sm" value="@Model.WorkDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
    </form>
    <a asp-action="Index" asp-route-date="@nextDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-light border text-secondary px-2.5 py-1.5 rounded-3 shadow-xs" title="Next Day">
        <i class="bi bi-chevron-right"></i>
    </a>
    @if (Model.WorkDate != today)
    {
        <a asp-action="Index" asp-route-date="@today.ToString("yyyy-MM-dd")" class="btn btn-sm btn-primary px-3 py-1.5 rounded-3 shadow-xs ms-2">
            Today
        </a>
    }
</div>

@if (Model.FilterStatus.HasValue)
{
    <div class="alert alert-info border-0 shadow-sm rounded-3 py-2 px-3 mb-3 d-flex justify-content-between align-items-center">
        <span><i class="bi bi-funnel-fill me-1"></i> Showing attendance records filtered by: <strong class="badge bg-primary text-white ms-1">@Model.FilterStatus</strong></span>
        <a asp-action="Index" asp-route-date="@Model.WorkDate.ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-dark py-0 px-2 text-decoration-none">Clear Filter</a>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.IsHoliday || Model.IsWeeklyOff)
{
    <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-4 d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-warning"></i>
        <div>
            @if (Model.IsHoliday)
            {
                <strong class="d-block">Public / Company Holiday: @Model.HolidayName</strong>
                <span class="small text-muted">Attendance defaults to Holiday. Working on holidays can still be recorded if necessary.</span>
            }
            else if (Model.IsWeeklyOff)
            {
                <strong class="d-block">Weekly Off Day (Weekend)</strong>
                <span class="small text-muted">Scheduled non-working day. Active employees default to Weekend status.</span>
            }
        </div>
    </div>
}

<form asp-action="Save" method="post" id="dailySheetForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="WorkDate" value="@Model.WorkDate.ToString("yyyy-MM-dd")" />

    <!-- Table Filter Toolbar with Search and Searchable Status Dropdown -->
    <div class="table-filter-bar mb-3">
        <div class="table-search-box" style="min-width: 260px;">
            <i class="bi bi-search search-icon"></i>
            <input type="text" id="dailySearchInput" class="table-search-input" placeholder="Filter by employee name, code, shift..." onkeyup="filterDailySheet()" oninput="filterDailySheet()" autocomplete="off" />
        </div>

        <div class="dropdown">
            <button class="filter-pill-dropdown" type="button" id="statusFilterBtn" data-bs-toggle="dropdown" aria-expanded="false">
                <span id="selectedStatusText">All Statuses</span>
                <i class="bi bi-chevron-down chevron-icon ms-1"></i>
            </button>
            <div class="dropdown-menu filter-dropdown-menu shadow-sm" style="min-width: 210px;">
                <div class="filter-dropdown-search">
                    <i class="bi bi-search search-icon"></i>
                    <input type="text" class="filter-dropdown-search-input" placeholder="Search status..." autocomplete="off" />
                </div>
                <ul class="filter-dropdown-list list-unstyled mb-0">
                    <li><a class="dropdown-item active" href="javascript:void(0)" onclick="setDailyStatusFilter('', 'All Statuses', this)">All Statuses</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="setDailyStatusFilter('Present', 'Present', this)">Present</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="setDailyStatusFilter('Late', 'Late', this)">Late</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="setDailyStatusFilter('HalfDay', 'Half Day', this)">Half Day</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="setDailyStatusFilter('Absent', 'Absent', this)">Absent</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="setDailyStatusFilter('OnLeave', 'On Leave', this)">On Leave</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="setDailyStatusFilter('Holiday', 'Holiday', this)">Holiday</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="setDailyStatusFilter('Weekend', 'Weekend', this)">Weekend</a></li>
                </ul>
            </div>
        </div>

        <button type="button" id="resetDailyFiltersBtn" class="btn btn-sm btn-light border text-secondary px-2.5 py-1.5 rounded-3 shadow-xs d-none align-items-center gap-1" onclick="resetAllDailyFilters()">
            <i class="bi bi-x-circle me-1"></i> Reset
        </button>
        <div class="table-records-counter ms-auto" id="dailyRecordsCounter">
            <strong>@Model.Items.Count</strong> active employees
        </div>
    </div>

    <div class="card border-0 shadow-xs mb-4" style="border: 1px solid #eaecf0 !important; border-radius: 14px; background: #ffffff;">
        <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center" style="border-color: #eaecf0 !important;">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold text-dark">Active Employees (@Model.Items.Count)</span>
                <span class="badge bg-light text-muted border">@Model.WorkDate.ToString("dddd, MMMM dd, yyyy")</span>
            </div>
            @if (Model.CanManage)
            {
                <button type="submit" class="btn btn-primary px-3 fw-semibold rounded-3 shadow-xs d-inline-flex align-items-center gap-1.5" style="height: 40px; font-size: 0.875rem;">
                    <i class="bi bi-floppy"></i>
                    <span>Save Sheet</span>
                </button>
            }
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-sticky-first">
                    <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                        <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                            <th class="ps-4 py-2.5" style="min-width: 200px;">Employee</th>
                            <th class="py-2.5" style="min-width: 140px;">Assigned Shift</th>
                            <th class="py-2.5" style="width: 140px;">Check In</th>
                            <th class="py-2.5" style="width: 140px;">Check Out</th>
                            <th class="py-2.5 text-center" style="width: 120px;">Status</th>
                            <th class="py-2.5" style="min-width: 150px;">Time Metrics</th>
                            <th class="py-2.5" style="min-width: 180px;">Note</th>
                            <th class="py-2.5 pe-4 text-end" style="width: 90px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                    No active employees found to record attendance.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < Model.Items.Count; i++)
                            {
                                var item = Model.Items[i];
                                <tr class="daily-sheet-row @(item.IsReadonly ? "table-light" : "")" data-emp="@item.FullName.ToLowerInvariant() @item.EmployeeCode.ToLowerInvariant() @(item.ShiftName?.ToLowerInvariant() ?? "")" data-status="@item.Status">
                                    <td class="ps-4 py-3">
                                        <input type="hidden" name="Items[@i].EmployeeId" value="@item.EmployeeId" />
                                        <div class="fw-semibold text-dark">@item.FullName</div>
                                        <small class="text-muted">@item.EmployeeCode</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ShiftName))
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-clock me-1 text-primary"></i>@item.ShiftName
                                            </span>
                                            @if (item.ShiftStartTime.HasValue && item.ShiftEndTime.HasValue)
                                            {
                                                <div class="small text-muted mt-1">
                                                    @item.ShiftStartTime.Value.ToString(@"hh\:mm") - @item.ShiftEndTime.Value.ToString(@"hh\:mm")
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><em>No Shift</em></span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsReadonly)
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                        else
                                        {
                                            <input type="time" name="Items[@i].CheckInTime"
                                                   class="form-control form-control-sm bg-light"
                                                   value="@(item.CheckInTime?.ToString("HH:mm"))"
                                                   @(Model.CanManage ? "" : "disabled") />
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsReadonly)
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                        else
                                        {
                                            <input type="time" name="Items[@i].CheckOutTime"
                                                   class="form-control form-control-sm bg-light"
                                                   value="@(item.CheckOutTime?.ToString("HH:mm"))"
                                                   @(Model.CanManage ? "" : "disabled") />
                                        }
                                    </td>
                                    <td class="text-center">
                                        <partial name="_StatusChip" model="@item.Status.ToString()" />
                                    </td>
                                    <td>
                                        @if (item.WorkedMinutes > 0 || item.LateMinutes > 0)
                                        {
                                            <div class="small">
                                                @if (item.WorkedMinutes > 0)
                                                {
                                                    <span><strong>Worked:</strong> @(item.WorkedMinutes / 60)h @(item.WorkedMinutes % 60)m</span>
                                                }
                                                @if (item.LateMinutes > 0)
                                                {
                                                    <span class="text-danger ms-1">(@(item.LateMinutes)m late)</span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsReadonly)
                                        {
                                            <span class="text-muted small">@item.Note</span>
                                        }
                                        else
                                        {
                                            <input type="text" name="Items[@i].Note"
                                                   class="form-control form-control-sm bg-light"
                                                   placeholder="Optional note"
                                                   value="@item.Note"
                                                   maxlength="500"
                                                   @(Model.CanManage ? "" : "disabled") />
                                        }
                                    </td>
                                    <td class="pe-4 text-end">
                                        @if (item.AttendanceDayId.HasValue && Model.CanManage && !item.IsReadonly)
                                        {
                                            <button type="button" class="btn btn-sm btn-light border text-secondary px-2.5 py-1.5 rounded-3 shadow-xs"
                                                    title="Edit Record with Note"
                                                    onclick="openEditModal('@item.AttendanceDayId.Value', '@item.FullName', '@item.EmployeeCode', '@(item.CheckInTime?.ToString("HH:mm"))', '@(item.CheckOutTime?.ToString("HH:mm"))', '@item.Note', '@item.RowVersionBase64')">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                            <tr id="noDailyResultsRow" class="d-none">
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-search fs-2 d-block mb-2 text-secondary opacity-50"></i>
                                    No employees match your search and filter criteria.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (Model.CanManage && Model.Items.Count > 0)
        {
            <div class="card-footer bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center border-top" style="border-color: #eaecf0 !important;">
                <span class="text-muted small">Total <strong>@Model.Items.Count</strong> active employees</span>
                <button type="submit" class="btn btn-primary px-4 fw-semibold rounded-3 shadow-xs d-inline-flex align-items-center gap-1.5" style="height: 40px; font-size: 0.875rem;">
                    <i class="bi bi-floppy"></i>
                    <span>Save Sheet</span>
                </button>
            </div>
        }
    </div>
</form>

<!-- Edit Modal -->
<div class="modal fade" id="editRecordModal" tabindex="-1" aria-labelledby="editRecordModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editAttendanceDayId" name="AttendanceDayId" />
                <input type="hidden" name="WorkDate" value="@Model.WorkDate.ToString("yyyy-MM-dd")" />
                <input type="hidden" id="editRowVersion" name="RowVersion" />

                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold" id="editRecordModalLabel">
                        <i class="bi bi-pencil-square me-2 text-primary"></i>Edit Attendance Record
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4">
                    <div class="mb-3 p-3 bg-light rounded-3">
                        <div class="fw-semibold text-dark" id="editEmployeeName"></div>
                        <small class="text-muted" id="editEmployeeCode"></small>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Check In</label>
                            <input type="time" id="editCheckInTime" name="CheckInTime" class="form-control" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Check Out</label>
                            <input type="time" id="editCheckOutTime" name="CheckOutTime" class="form-control" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Adjustment Note <span class="text-danger">*</span></label>
                        <textarea id="editNote" name="Note" class="form-control" rows="3" required maxlength="500" placeholder="Please provide reason for this manual adjustment (required for audit logging)..."></textarea>
                        <div class="form-text">A note is required for all manual updates.</div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
function filterDropdownMenuOptions(input) {
            const query = input.value.toLowerCase();
            const list = input.closest('.dropdown-menu').querySelectorAll('.filter-dropdown-list li');
            list.forEach(li => {
                const text = li.textContent.toLowerCase();
                li.style.display = text.includes(query) ? '' : 'none';
            });
        }

        let currentDailyStatusFilter = '';

        function setDailyStatusFilter(status, displayText, element) {
            currentDailyStatusFilter = status.toLowerCase();
            document.getElementById('selectedStatusText').textContent = displayText;
            const btn = document.getElementById('statusFilterBtn');
            if (btn) {
                if (status) {
                    btn.classList.add('is-filtered');
                } else {
                    btn.classList.remove('is-filtered');
                }
            }
            document.querySelectorAll('#statusFilterBtn + .dropdown-menu .dropdown-item').forEach(el => {
                el.classList.remove('active');
                const check = el.querySelector('.bi-check2');
                if (check) check.remove();
            });
            element.classList.add('active');
            if (!element.querySelector('.bi-check2')) {
                const icon = document.createElement('i');
                icon.className = 'bi bi-check2';
                element.appendChild(icon);
            }
            filterDailySheet();
        }

        function filterDailySheet() {
            const query = document.getElementById('dailySearchInput').value.trim().toLowerCase();
            const rows = document.querySelectorAll('.daily-sheet-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const emp = row.getAttribute('data-emp') || '';
                const status = (row.getAttribute('data-status') || '').toLowerCase();

                const matchesSearch = !query || emp.includes(query);
                const matchesStatus = !currentDailyStatusFilter || status === currentDailyStatusFilter;

                if (matchesSearch && matchesStatus) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const resetBtn = document.getElementById('resetDailyFiltersBtn');
            if (resetBtn) {
                if (query || currentDailyStatusFilter) {
                    resetBtn.classList.remove('d-none');
                    resetBtn.classList.add('d-inline-flex');
                } else {
                    resetBtn.classList.add('d-none');
                    resetBtn.classList.remove('d-inline-flex');
                }
            }

            const counter = document.getElementById('dailyRecordsCounter');
            if (counter) {
                counter.innerHTML = `<strong>${visibleCount}</strong> active employees`;
            }

            const noResults = document.getElementById('noDailyResultsRow');
            if (noResults) {
                if (visibleCount === 0 && rows.length > 0) {
                    noResults.classList.remove('d-none');
                } else {
                    noResults.classList.add('d-none');
                }
            }
        }

        function resetAllDailyFilters() {
            const searchInput = document.getElementById('dailySearchInput');
            if (searchInput) searchInput.value = '';

            const btn = document.getElementById('statusFilterBtn');
            if (btn) btn.classList.remove('is-filtered');

            const firstStatusItem = document.querySelector('#statusFilterBtn + .dropdown-menu .dropdown-item');
            if (firstStatusItem) setDailyStatusFilter('', 'All Statuses', firstStatusItem);

            filterDailySheet();
        }

        function openEditModal(id, name, code, checkIn, checkOut, note, rowVersion) {
            document.getElementById('editAttendanceDayId').value = id;
            document.getElementById('editEmployeeName').innerText = name;
            document.getElementById('editEmployeeCode').innerText = code;
            document.getElementById('editCheckInTime').value = checkIn || '';
            document.getElementById('editCheckOutTime').value = checkOut || '';
            document.getElementById('editNote').value = note || '';
            document.getElementById('editRowVersion').value = rowVersion;

            var modal = new bootstrap.Modal(document.getElementById('editRecordModal'));
            modal.show();
        }
    </script>
}
