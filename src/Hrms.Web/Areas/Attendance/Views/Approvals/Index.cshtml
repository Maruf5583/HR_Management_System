@model AttendanceApprovalsViewModel
@{
    ViewData["Title"] = "Attendance Regularization Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-check2-circle me-2 text-primary"></i>Attendance Regularization Approvals</h4>
        <p class="text-muted small mb-0">Review, approve, or reject employee attendance correction requests ("Fix my attendance")</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 bg-white">
    <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">Pending Requests (@Model.PendingRequests.Count)</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3">EMPLOYEE</th>
                        <th class="py-3">WORK DATE</th>
                        <th class="py-3">REQUESTED IN / OUT</th>
                        <th class="py-3" style="max-width: 250px;">REASON</th>
                        <th class="py-3">SUBMITTED</th>
                        <th class="py-3 text-end pe-4">ACTION</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PendingRequests.Count > 0)
                    {
                        foreach (var req in Model.PendingRequests)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-semibold text-dark">@req.EmployeeName</div>
                                    <small class="text-muted font-monospace">@req.EmployeeCode</small>
                                </td>
                                <td class="fw-semibold text-dark">@req.WorkDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1"></i>@req.RequestedCheckInLocal
                                        @if (req.RequestedCheckOutLocal != null)
                                        {
                                            <span> — @req.RequestedCheckOutLocal</span>
                                        }
                                    </span>
                                </td>
                                <td class="small text-muted" style="max-width: 250px;">@req.Reason</td>
                                <td class="small text-muted">@req.CreatedAtUtc.ToString("dd MMM, hh:mm tt")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Approve form -->
                                        <form asp-action="Review" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="RequestId" value="@req.RequestId" />
                                            <input type="hidden" name="Approve" value="true" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                        </form>

                                        <!-- Reject button opening reject modal -->
                                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-semibold"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal-@req.RequestId">
                                            <i class="bi bi-x-lg me-1"></i> Reject
                                        </button>
                                    </div>

                                    <!-- Reject Modal -->
                                    <div class="modal fade text-start" id="rejectModal-@req.RequestId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold">Reject Attendance Request</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-action="Review" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="RequestId" value="@req.RequestId" />
                                                    <input type="hidden" name="Approve" value="false" />
                                                    <div class="modal-body">
                                                        <p class="text-muted small">Please specify the reason for rejecting this regularization request. The employee will receive a notification.</p>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold text-muted">Remarks / Reason</label>
                                                            <textarea name="Remarks" class="form-control rounded-3" rows="3" placeholder="e.g. Invalid time, no manager pre-approval..." required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger rounded-pill px-4 fw-semibold">Confirm Rejection</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-check2-all fs-1 text-success d-block mb-2"></i>
                                All caught up! There are no pending attendance regularization requests.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
