@model AttendanceApprovalsViewModel
@{
    ViewData["Title"] = "Attendance Regularization Approvals";
    ViewData["Subtitle"] = "Review, approve, or reject employee attendance correction requests";
}


<!-- EmplowHR-Inspired Unified Filter Bar -->
<div class="table-filter-bar mb-3">
    <!-- Instant Search Input -->
    <div class="table-search-box">
        <i class="bi bi-search search-icon"></i>
        <input type="text" id="approvalSearchInput" class="table-search-input" placeholder="Search by employee name, code, or reason..." oninput="filterAttendanceApprovals()" />
    </div>

    <!-- Reset Filter Button -->
    <button type="button" class="btn-reset-filters d-none" id="resetFiltersBtn" onclick="resetApprovalFilters()" title="Reset search">
        <i class="bi bi-arrow-counterclockwise"></i>
        <span>Reset</span>
    </button>

    <!-- Total Records Badge -->
    <div class="ms-auto">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-semibold" id="recordsCounter">
            @Model.PendingRequests.Count Pending Request@(Model.PendingRequests.Count == 1 ? "" : "s")
        </span>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important; overflow: hidden;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="attendanceApprovalsTable">
                <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                    <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                        <th class="ps-4 py-2.5">Employee</th>
                        <th class="py-2.5">Work Date</th>
                        <th class="py-2.5">Requested In / Out</th>
                        <th class="py-2.5" style="max-width: 250px;">Reason</th>
                        <th class="py-2.5">Submitted</th>
                        <th class="py-2.5 text-end pe-4">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.PendingRequests.Count > 0)
                    {
                        foreach (var req in Model.PendingRequests)
                        {
                            <tr class="approval-row" data-search="@((req.EmployeeName ?? "").ToLowerInvariant()) @((req.EmployeeCode ?? "").ToLowerInvariant()) @(req.Reason?.ToLowerInvariant() ?? "")">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.82rem;">
                                            @(!string.IsNullOrEmpty(req.EmployeeName) ? req.EmployeeName.Substring(0, 1).ToUpper() : "E")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@req.EmployeeName</div>
                                            <small class="text-muted small" style="font-size: 0.72rem;">@req.EmployeeCode</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="fw-semibold text-dark">@req.WorkDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="bi bi-clock me-1 text-primary"></i>@req.RequestedCheckInLocal
                                        @if (req.RequestedCheckOutLocal != null)
                                        {
                                            <span> — @req.RequestedCheckOutLocal</span>
                                        }
                                    </span>
                                </td>
                                <td class="small text-muted" style="max-width: 250px;">@req.Reason</td>
                                <td class="small text-muted">@req.CreatedAtUtc.ToString("dd MMM, hh:mm tt")</td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <!-- Approve form -->
                                        <form asp-action="Review" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="RequestId" value="@req.RequestId" />
                                            <input type="hidden" name="Approve" value="true" />
                                            <button type="submit" class="btn btn-sm btn-success rounded-3 px-3 fw-semibold shadow-xs">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                        </form>

                                        <!-- Reject button opening reject modal -->
                                        <button type="button" class="btn btn-sm btn-light border text-danger rounded-3 px-3 fw-medium"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal-@req.RequestId">
                                            <i class="bi bi-x-lg me-1"></i> Reject
                                        </button>
                                    </div>

                                    <!-- Reject Modal -->
                                    <div class="modal fade text-start" id="rejectModal-@req.RequestId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content rounded-4 border-0 shadow-lg">
                                                <div class="modal-header border-bottom py-3">
                                                    <h6 class="modal-title fw-bold text-danger">
                                                        <i class="bi bi-x-circle me-1"></i> Reject Attendance Request
                                                    </h6>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <form asp-action="Review" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="RequestId" value="@req.RequestId" />
                                                    <input type="hidden" name="Approve" value="false" />
                                                    <div class="modal-body p-4">
                                                        <p class="small text-muted mb-3">
                                                            Please provide a reason why this attendance regularization request for <strong>@req.EmployeeName</strong> on <strong>@req.WorkDate.ToString("dd MMM yyyy")</strong> is being rejected.
                                                        </p>
                                                        <div>
                                                            <label class="form-label small fw-semibold">Rejection Reason <span class="text-danger">*</span></label>
                                                            <textarea name="ReviewRemarks" class="form-control" rows="3" required placeholder="e.g. Inconsistent swipe logs, manager not notified in advance..."></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top py-2">
                                                        <button type="button" class="btn btn-sm btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-sm btn-danger rounded-3 fw-semibold">
                                                            <i class="bi bi-x-lg me-1"></i> Confirm Reject
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-check-circle fs-1 text-success d-block mb-2"></i>
                                <h6 class="fw-semibold text-dark">No Pending Requests</h6>
                                <p class="small text-muted mb-0">All attendance regularization requests have been reviewed.</p>
                            </td>
                        </tr>
                    }
                    <tr id="noResultsRow" class="d-none">
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-search fs-2 d-block mb-2 text-muted"></i>
                            No requests match your current search query.
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        @if (Model.PendingRequests.Count > 0)
        {
            <div class="card-footer bg-white border-0 py-3 px-4 d-flex justify-content-between align-items-center border-top" style="border-color: #eaecf0 !important;">
                <span class="text-muted small">Total <strong>@Model.PendingRequests.Count</strong> pending regularization request@(Model.PendingRequests.Count == 1 ? "" : "s")</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function filterAttendanceApprovals() {
            const query = document.getElementById('approvalSearchInput').value.trim().toLowerCase();
            const rows = document.querySelectorAll('.approval-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                if (!query || searchData.includes(query)) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const resetBtn = document.getElementById('resetFiltersBtn');
            if (resetBtn) {
                if (query) resetBtn.classList.remove('d-none');
                else resetBtn.classList.add('d-none');
            }

            const counter = document.getElementById('recordsCounter');
            if (counter) {
                counter.innerHTML = `<strong>${visibleCount}</strong> pending requests`;
            }

            const noResults = document.getElementById('noResultsRow');
            if (noResults) {
                if (visibleCount === 0 && rows.length > 0) {
                    noResults.classList.remove('d-none');
                } else {
                    noResults.classList.add('d-none');
                }
            }
        }

        function resetApprovalFilters() {
            const input = document.getElementById('approvalSearchInput');
            if (input) {
                input.value = '';
                filterAttendanceApprovals();
            }
        }
    </script>
}
