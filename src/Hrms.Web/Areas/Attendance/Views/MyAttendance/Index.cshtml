@model MyAttendanceViewModel
@{
    ViewData["Title"] = "My Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-clock-history me-2 text-primary"></i>My Attendance</h4>
        <p class="text-muted small mb-0">View your daily attendance logs, working hours, and monthly overview</p>
    </div>
    @if (Model.HasEmployee && Model.Report != null)
    {
        <form method="get" class="d-flex gap-2 align-items-center">
            <select name="month" class="form-select form-select-sm shadow-sm" onchange="this.form.submit()">
                @for (int m = 1; m <= 12; m++)
                {
                    var mName = new DateTime(2000, m, 1).ToString("MMMM");
                    <option value="@m" selected="@(Model.Month == m ? "selected" : null)">@mName</option>
                }
            </select>
            <input type="number" name="year" class="form-control form-control-sm shadow-sm" value="@Model.Year" min="2020" max="2050" onchange="this.form.submit()" style="width: 90px;" />
        </form>
    }
</div>

@if (!Model.HasEmployee || Model.Report == null)
{
    <div class="alert alert-info border-0 shadow-sm rounded-4 p-4 text-center">
        <i class="bi bi-person-x fs-1 d-block mb-3 text-info"></i>
        <h5 class="fw-bold">No Employee Profile Linked</h5>
        <p class="text-muted mb-0">Your account is not linked to an employee profile. Attendance tracking is available for active employees only.</p>
    </div>
}
else
{
    var rep = Model.Report;

    <!-- Summary Metrics -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Present</span>
                <h3 class="fw-bold text-success mb-0 mt-2">@rep.PresentDays</h3>
                <small class="text-muted mt-1">Days</small>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Late</span>
                <h3 class="fw-bold text-warning-emphasis mb-0 mt-2">@rep.LateDays</h3>
                <small class="text-muted mt-1">Days</small>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Half Day</span>
                <h3 class="fw-bold text-info-emphasis mb-0 mt-2">@rep.HalfDays</h3>
                <small class="text-muted mt-1">Days</small>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Absent</span>
                <h3 class="fw-bold text-danger mb-0 mt-2">@rep.AbsentDays</h3>
                <small class="text-muted mt-1">Days</small>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">On Leave</span>
                <h3 class="fw-bold text-primary mb-0 mt-2">@rep.OnLeaveDays</h3>
                <small class="text-muted mt-1">Days</small>
            </div>
        </div>
        <div class="col-6 col-md-4 col-xl-2">
            <div class="card border-0 shadow-sm rounded-4 text-center p-3">
                <span class="text-muted small text-uppercase fw-semibold">Holidays/Off</span>
                <h3 class="fw-bold text-secondary mb-0 mt-2">@(rep.HolidayDays + rep.WeekendDays)</h3>
                <small class="text-muted mt-1">Days</small>
            </div>
        </div>
    </div>

    <!-- Daily Log Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-white border-0 py-3">
            <span class="fw-semibold text-dark">Daily Attendance Log - @(new DateTime(Model.Year, Model.Month, 1).ToString("MMMM yyyy"))</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-muted small">
                        <tr>
                            <th class="ps-4 py-3" style="width: 140px;">DATE</th>
                            <th class="py-3" style="width: 110px;">DAY</th>
                            <th class="py-3" style="min-width: 150px;">SHIFT</th>
                            <th class="py-3" style="width: 120px;">CHECK IN</th>
                            <th class="py-3" style="width: 120px;">CHECK OUT</th>
                            <th class="py-3" style="width: 130px;">WORKED</th>
                            <th class="py-3" style="width: 110px;">LATE</th>
                            <th class="py-3 text-center" style="width: 120px;">STATUS</th>
                            <th class="py-3 pe-4">NOTE</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in rep.Days)
                        {
                            var isOff = day.Status == AttendanceStatus.Holiday || day.Status == AttendanceStatus.Weekend;
                            <tr class="@(isOff ? "table-light" : "")">
                                <td class="ps-4 py-3 fw-semibold">@day.WorkDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-muted small">@day.DayOfWeek</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(day.ShiftName))
                                    {
                                        <span class="badge bg-light text-dark border">@day.ShiftName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>@(day.CheckInTime?.ToString("hh\\:mm tt") ?? "-")</td>
                                <td>@(day.CheckOutTime?.ToString("hh\\:mm tt") ?? "-")</td>
                                <td>
                                    @if (day.WorkedMinutes > 0)
                                    {
                                        <span>@(day.WorkedMinutes / 60)h @(day.WorkedMinutes % 60)m</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td>
                                    @if (day.LateMinutes > 0)
                                    {
                                        <span class="text-danger fw-semibold">@day.LateMinutes m</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @switch (day.Status)
                                    {
                                        case AttendanceStatus.Present:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Present</span>
                                            break;
                                        case AttendanceStatus.Late:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1">Late</span>
                                            break;
                                        case AttendanceStatus.HalfDay:
                                            <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1">Half Day</span>
                                            break;
                                        case AttendanceStatus.Absent:
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Absent</span>
                                            break;
                                        case AttendanceStatus.OnLeave:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">On Leave</span>
                                            break;
                                        case AttendanceStatus.Holiday:
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Holiday</span>
                                            break;
                                        case AttendanceStatus.Weekend:
                                            <span class="badge bg-light text-muted border px-2 py-1">Weekend</span>
                                            break;
                                    }
                                </td>
                                <td class="pe-4 text-muted small">@day.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
