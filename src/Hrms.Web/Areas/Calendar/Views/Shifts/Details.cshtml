@model ShiftDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Details.Name} - Shift Details";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-light btn-sm border me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <div class="d-flex align-items-center gap-2">
                <h4 class="fw-bold mb-0">@Model.Details.Name</h4>
                @if (Model.Details.Status == ShiftStatus.Active)
                {
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactive</span>
                }
            </div>
            <p class="text-muted small mb-0">Created on @Model.Details.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm UTC")</p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Details.ShiftId" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <i class="bi bi-pencil"></i> Edit Shift
        </a>
        <form asp-action="ToggleStatus" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="shiftId" value="@Model.Details.ShiftId" />
            <input type="hidden" name="newStatus" value="@(Model.Details.Status == ShiftStatus.Active ? ShiftStatus.Inactive : ShiftStatus.Active)" />
            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
            <button type="submit" class="btn @(Model.Details.Status == ShiftStatus.Active ? "btn-outline-danger" : "btn-outline-success") btn-sm">
                <i class="bi @(Model.Details.Status == ShiftStatus.Active ? "bi-slash-circle" : "bi-check2-circle") me-1"></i>
                @(Model.Details.Status == ShiftStatus.Active ? "Deactivate Shift" : "Activate Shift")
            </button>
        </form>
        @if (Model.Details.Status == ShiftStatus.Active)
        {
            <a asp-action="CreateVersion" asp-route-shiftId="@Model.Details.ShiftId" class="btn btn-primary btn-sm d-flex align-items-center gap-1 shadow-sm">
                <i class="bi bi-plus-circle"></i> Schedule New Timings Version
            </a>
            <a asp-controller="ShiftAssignments" asp-action="Assign" asp-route-shiftId="@Model.Details.ShiftId" class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1">
                <i class="bi bi-person-plus"></i> Assign Employees
            </a>
        }
        <button type="button" class="btn btn-outline-danger btn-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#deleteShiftModal">
            <i class="bi bi-trash"></i> Delete Shift
        </button>
    </div>
</div>

<!-- Delete Shift Modal (Placed outside for clean wrapping) -->
<div class="modal fade" id="deleteShiftModal" tabindex="-1" aria-hidden="true" style="white-space: normal;">
    <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 460px;">
        <div class="modal-content border-0 shadow" style="border-radius: 14px;">
            @if (Model.RecentAssignments.Any())
            {
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold text-warning d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill fs-5"></i> Cannot Delete Active Shift
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                    <p class="text-secondary mb-2" style="font-size: 0.95rem; line-height: 1.5;">
                        Shift <strong>'@Model.Details.Name'</strong> has <strong>@Model.RecentAssignments.Count employee assignment(s)</strong> linked to it.
                    </p>
                    <p class="text-muted small mb-0">
                        Please reassign or remove employee shift assignments before deleting this shift.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Close</button>
                    <a asp-controller="ShiftAssignments" asp-action="Index" asp-route-shiftId="@Model.Details.ShiftId" class="btn btn-sm btn-primary px-3 fw-semibold">
                        <i class="bi bi-person-lines-fill me-1"></i>Manage Assignments
                    </a>
                </div>
            }
            else
            {
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Details.ShiftId" />
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                            <i class="bi bi-trash fs-5"></i> Delete Work Shift
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                        <p class="text-secondary mb-0" style="font-size: 0.95rem; line-height: 1.5;">
                            Are you sure you want to permanently delete shift <strong>'@Model.Details.Name'</strong> and all its schedule version records?
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold">Confirm Delete</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Version History Table -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-layers text-primary me-2"></i>Timing Versions History (@Model.Details.Versions.Count)
        </h6>
        <span class="text-muted small">
            <i class="bi bi-info-circle me-1"></i>Only one open version (EffectiveTo = null) is active at any point.
        </span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Operating Hours</th>
                        <th>Type</th>
                        <th>Grace</th>
                        <th>Break</th>
                        <th>Net Duration</th>
                        <th>Effective Period</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.Details.Versions)
                    {
                        var isCurrent = v.EffectiveTo == null;
                        <tr class="@(isCurrent ? "table-active" : "")">
                            <td class="ps-4">
                                <span class="fw-bold fs-6 text-dark">
                                    @DateTime.Today.Add(v.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(v.EndTime).ToString("hh:mm tt")
                                </span>
                            </td>
                            <td>
                                @if (v.IsNightShift)
                                {
                                    <span class="badge bg-dark text-white px-2 py-1">
                                        <i class="bi bi-moon-stars me-1 text-warning"></i>Overnight
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1">
                                        <i class="bi bi-sun me-1 text-warning"></i>Day Shift
                                    </span>
                                }
                            </td>
                            <td>@v.GraceMinutes m</td>
                            <td>@v.BreakMinutes m</td>
                            <td><strong>@v.NetWorkingSpan.TotalHours.ToString("0.#") hrs</strong></td>
                            <td>
                                <div>
                                    <span class="fw-semibold">@v.EffectiveFrom.ToString("yyyy-MM-dd")</span>
                                    <span class="text-muted mx-1">to</span>
                                    <span class="fw-semibold">@(v.EffectiveTo?.ToString("yyyy-MM-dd") ?? "Present (Active)")</span>
                                </div>
                            </td>
                            <td>
                                @if (isCurrent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Current
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1">Archived</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Assigned Employees -->
<div class="card border-0 shadow-sm" style="border-radius: 14px;">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0 text-dark">
            <i class="bi bi-people text-primary me-2"></i>Assigned Employees
        </h6>
        <a asp-controller="ShiftAssignments" asp-action="Assign" asp-route-shiftId="@Model.Details.ShiftId" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-person-plus me-1"></i>Assign Employee
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Effective From</th>
                        <th>Effective To</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentAssignments.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                No employees currently assigned to this shift.
                            </td>
                        </tr>
                    }
                    @foreach (var a in Model.RecentAssignments)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-semibold text-dark">@a.EmployeeName</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">@a.EmployeeCode</div>
                            </td>
                            <td>@a.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                            <td>@(a.EffectiveTo?.ToString("yyyy-MM-dd") ?? "Ongoing")</td>
                            <td>
                                @if (a.IsCurrent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1">Past</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
