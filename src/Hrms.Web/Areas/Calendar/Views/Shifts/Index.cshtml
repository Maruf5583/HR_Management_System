@model ShiftListViewModel
@{
    ViewData["Title"] = "Work Shifts Management";
}

<partial name="_CalendarNav" />

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-clock-history me-2 text-primary"></i>Work Shifts</h4>
        <p class="text-muted small mb-0">Manage organizational shift schedules, timing versions, and overnight shifts</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="ShiftAssignments" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-2">
            <i class="bi bi-person-lines-fill"></i> Shift Assignments
        </a>
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Add New Shift
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Bar with Explicit Count Badges -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body py-3">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="btn-group">
                <a asp-action="Index" asp-route-status="" class="btn btn-sm @(!Model.StatusFilter.HasValue ? "btn-primary" : "btn-light border")">
                    All Shifts <span class="badge @(!Model.StatusFilter.HasValue ? "bg-white text-primary" : "bg-secondary") ms-1">@Model.TotalCount</span>
                </a>
                <a asp-action="Index" asp-route-status="Active" class="btn btn-sm @(Model.StatusFilter == ShiftStatus.Active ? "btn-success text-white" : "btn-light border")">
                    Active <span class="badge @(Model.StatusFilter == ShiftStatus.Active ? "bg-white text-success" : "bg-success-subtle text-success border") ms-1">@Model.ActiveCount</span>
                </a>
                <a asp-action="Index" asp-route-status="Inactive" class="btn btn-sm @(Model.StatusFilter == ShiftStatus.Inactive ? "btn-secondary" : "btn-light border")">
                    Inactive <span class="badge @(Model.StatusFilter == ShiftStatus.Inactive ? "bg-white text-secondary" : "bg-secondary-subtle text-secondary border") ms-1">@Model.InactiveCount</span>
                </a>
            </div>
            <span class="text-muted small">
                <i class="bi bi-shield-lock me-1"></i>Modifying shift timings creates a new version to preserve historical schedule accuracy.
            </span>
        </div>
    </div>
</div>

<!-- Shifts Cards Grid -->
@if (!Model.Shifts.Any())
{
    <div class="card border-0 shadow-sm text-center py-5" style="border-radius: 14px;">
        <div class="card-body">
            <i class="bi bi-calendar-x fs-1 text-muted d-block mb-3"></i>
            <h5 class="fw-semibold text-dark">No Shifts Found</h5>
            <p class="text-muted small mb-3">
                @(Model.StatusFilter.HasValue ? $"There are currently no {Model.StatusFilter.Value.ToString().ToLower()} shifts." : "Get started by creating your first organizational work shift schedule.")
            </p>
            @if (Model.StatusFilter.HasValue)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-primary me-2">
                    <i class="bi bi-list-ul me-1"></i>View All Shifts
                </a>
            }
            <a asp-action="Create" class="btn btn-primary px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i>Create First Shift
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var s in Model.Shifts)
        {
            var v = s.CurrentVersion;
            var isNight = v?.IsNightShift ?? false;
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 position-relative" style="border-radius: 14px; transition: transform 0.15s ease;">
                    <div class="card-body p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1 text-dark">@s.Name</h5>
                                    <span class="text-muted small" style="font-size: 0.8rem;">
                                        <i class="bi bi-layers me-1"></i>@s.VersionCount Version(s)
                                    </span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    @if (s.Status == ShiftStatus.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Inactive</span>
                                    }
                                </div>
                            </div>

                            @if (v != null)
                            {
                                <div class="p-3 rounded bg-light mb-3">
                                    <div class="d-flex align-items-center justify-content-between mb-2">
                                        <span class="fw-bold fs-5 text-dark">
                                            <i class="bi bi-clock me-1 text-primary"></i>
                                            @DateTime.Today.Add(v.StartTime).ToString("hh:mm tt") - @DateTime.Today.Add(v.EndTime).ToString("hh:mm tt")
                                        </span>
                                        @if (isNight)
                                        {
                                            <span class="badge bg-dark text-white px-2 py-1" title="Shift spans across midnight">
                                                <i class="bi bi-moon-stars me-1 text-warning"></i>Overnight
                                            </span>
                                        }
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small" style="font-size: 0.78rem;">
                                        <span>Grace: <strong>@v.GraceMinutes m</strong></span>
                                        <span>Break: <strong>@v.BreakMinutes m</strong></span>
                                        <span>Net Work: <strong>@v.NetWorkingSpan.TotalHours.ToString("0.#") hrs</strong></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 px-3 small border-0 mb-3">
                                    <i class="bi bi-exclamation-triangle me-1"></i>No version timings configured.
                                </div>
                            }

                            <div class="d-flex justify-content-between align-items-center text-muted small mb-3">
                                <div>
                                    <i class="bi bi-person-check fs-6 text-primary me-1"></i>
                                    <span><strong>@s.ActiveEmployeeCount</strong> Active Employees</span>
                                </div>
                                <!-- 1-Click Status Toggle -->
                                <form asp-action="ToggleStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="shiftId" value="@s.ShiftId" />
                                    <input type="hidden" name="newStatus" value="@(s.Status == ShiftStatus.Active ? ShiftStatus.Inactive : ShiftStatus.Active)" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn btn-sm py-0 px-2 @(s.Status == ShiftStatus.Active ? "btn-outline-secondary" : "btn-outline-success")" style="font-size: 0.75rem;" title="Click to @(s.Status == ShiftStatus.Active ? "Deactivate" : "Activate")">
                                        <i class="bi @(s.Status == ShiftStatus.Active ? "bi-slash-circle" : "bi-check2-circle") me-1"></i>
                                        @(s.Status == ShiftStatus.Active ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Card Action Buttons -->
                        <div class="pt-3 border-top mt-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <a asp-action="Details" asp-route-id="@s.ShiftId" class="btn btn-outline-primary btn-sm px-3 fw-semibold flex-grow-1 me-2">
                                    <i class="bi bi-eye me-1"></i>View Details & Versions
                                </a>
                                <a asp-action="Edit" asp-route-id="@s.ShiftId" class="btn btn-outline-secondary btn-sm px-2 me-1" title="Edit Shift Name">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <!-- ALWAYS VISIBLE DELETE BUTTON -->
                                <button type="button" class="btn btn-outline-danger btn-sm px-2" data-bs-toggle="modal" data-bs-target="#deleteShiftModal-@s.ShiftId" title="Delete Shift">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                            <div>
                                <a asp-controller="ShiftAssignments" asp-action="Assign" asp-route-shiftId="@s.ShiftId" class="btn btn-light btn-sm border w-100 text-muted fw-semibold">
                                    <i class="bi bi-person-plus text-primary me-1"></i>Assign Employee to this Shift
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- ========================================== -->
<!-- ALL DELETE SHIFT MODALS PLACED CLEANLY AT BOTTOM -->
<!-- ========================================== -->

@foreach (var s in Model.Shifts)
{
    <div class="modal fade" id="deleteShiftModal-@s.ShiftId" tabindex="-1" aria-hidden="true" style="white-space: normal;">
        <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 460px;">
            <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                @if (s.ActiveEmployeeCount > 0)
                {
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold text-warning d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill fs-5"></i> Cannot Delete Active Shift
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                        <p class="text-secondary mb-2" style="font-size: 0.95rem; line-height: 1.5;">
                            Shift <strong>'@s.Name'</strong> currently has <strong>@s.ActiveEmployeeCount active employee(s)</strong> assigned to it.
                        </p>
                        <p class="text-muted small mb-0">
                            To maintain audit integrity, you must first reassign or remove employees from this shift before deleting it.
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Close</button>
                        <a asp-controller="ShiftAssignments" asp-action="Index" asp-route-shiftId="@s.ShiftId" class="btn btn-sm btn-primary px-3 fw-semibold">
                            <i class="bi bi-person-lines-fill me-1"></i>Manage Shift Employees
                        </a>
                    </div>
                }
                else
                {
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@s.ShiftId" />
                        <div class="modal-header border-0 pb-0">
                            <h6 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                                <i class="bi bi-trash fs-5"></i> Delete Work Shift
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                            <p class="text-secondary mb-0" style="font-size: 0.95rem; line-height: 1.5;">
                                Are you sure you want to permanently delete shift <strong>'@s.Name'</strong> and all its schedule versions? This action cannot be undone.
                            </p>
                        </div>
                        <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold">Confirm Delete</button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
}
