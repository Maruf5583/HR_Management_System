@model ShiftAssignmentListViewModel
@{
    ViewData["Title"] = "Shift Assignments Management";
}

<partial name="_CalendarNav" />

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Employee Shift Assignments</h4>
        <p class="text-muted small mb-0">Assign employees to work shifts, schedule transfers, and track shift history</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Shifts" asp-action="Index" class="btn btn-outline-primary d-flex align-items-center gap-2">
            <i class="bi bi-clock-history"></i> Work Shifts
        </a>
        <a asp-action="Assign" class="btn btn-primary d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg"></i> Assign Shift
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Shift:</label>
                <select name="shiftId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Shifts</option>
                    @foreach (var s in Model.Shifts)
                    {
                        <option value="@s.ShiftId" selected="@(s.ShiftId == Model.SelectedShiftId)">@s.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold text-muted mb-1">Filter by Employee:</label>
                <select name="employeeId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">All Employees</option>
                    @foreach (var e in Model.Employees)
                    {
                        <option value="@e.EmployeeId" selected="@(e.EmployeeId == Model.SelectedEmployeeId)">@e.FullName (@e.EmployeeCode)</option>
                    }
                </select>
            </div>
            @if (Model.SelectedShiftId.HasValue || Model.SelectedEmployeeId.HasValue)
            {
                <div class="col-md-4 d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-sm btn-light border text-muted">
                        <i class="bi bi-x-circle me-1"></i>Reset Filters
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<!-- Assignments Table -->
<div class="card border-0 shadow-sm" style="border-radius: 14px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Assigned Shift</th>
                        <th>Effective Period</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Assignments.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-person-x fs-1 d-block mb-2"></i>
                                <h6 class="fw-semibold text-dark">No Shift Assignments Found</h6>
                                <p class="small text-muted mb-3">No employees are currently assigned matching the filter criteria.</p>
                                <a asp-action="Assign" class="btn btn-primary btn-sm px-3">
                                    <i class="bi bi-plus-lg me-1"></i>Assign an Employee Now
                                </a>
                            </td>
                        </tr>
                    }
                    @foreach (var a in Model.Assignments)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold text-dark">@a.EmployeeName</div>
                                <div class="text-muted small" style="font-size: 0.75rem;">@a.EmployeeCode</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
                                    <i class="bi bi-clock me-1 text-primary"></i>@a.ShiftName
                                </span>
                            </td>
                            <td>
                                <span class="fw-semibold">@a.EffectiveFrom.ToString("yyyy-MM-dd")</span>
                                <span class="text-muted mx-1">to</span>
                                <span class="fw-semibold">@(a.EffectiveTo?.ToString("yyyy-MM-dd") ?? "Ongoing")</span>
                            </td>
                            <td>
                                @if (a.IsCurrent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check-circle me-1"></i>Active Current
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border px-2 py-1">Closed / Past</span>
                                }
                            </td>
                            <td class="text-end pe-4 text-nowrap">
                                <!-- View Details Trigger -->
                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" data-bs-toggle="modal" data-bs-target="#viewModal-@a.ShiftAssignmentId" title="View Assignment Details">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <!-- Edit Assignment -->
                                <a asp-action="Edit" asp-route-id="@a.ShiftAssignmentId" class="btn btn-sm btn-outline-primary me-1" title="Edit Assignment Dates">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                @if (a.IsCurrent)
                                {
                                    <!-- Transfer -->
                                    <a asp-action="Transfer" asp-route-employeeId="@a.EmployeeId" class="btn btn-sm btn-outline-info me-1 text-dark" title="Transfer to Another Shift">
                                        <i class="bi bi-arrow-left-right me-1"></i>Transfer
                                    </a>

                                    <!-- End Shift Trigger -->
                                    <button type="button" class="btn btn-sm btn-outline-warning text-dark me-1" data-bs-toggle="modal" data-bs-target="#endModal-@a.ShiftAssignmentId" title="End / Close Assignment">
                                        <i class="bi bi-stop-circle"></i> End
                                    </button>
                                }

                                <!-- Delete Trigger Button -->
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@a.ShiftAssignmentId" title="Delete / Remove from Shift">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- ALL MODALS PLACED OUTSIDE TABLE FOR CLEAN WRAPPING -->
<!-- ========================================== -->

@foreach (var a in Model.Assignments)
{
    <!-- View Details Modal -->
    <div class="modal fade" id="viewModal-@a.ShiftAssignmentId" tabindex="-1" aria-hidden="true" style="white-space: normal;">
        <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 460px;">
            <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold d-flex align-items-center gap-2">
                        <i class="bi bi-info-circle text-primary fs-5"></i> Shift Assignment Details
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3" style="white-space: normal;">
                    <div class="list-group list-group-flush border-0">
                        <div class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted small">Employee:</span>
                            <span class="fw-bold">@a.EmployeeName (@a.EmployeeCode)</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted small">Shift:</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">@a.ShiftName</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted small">Effective From:</span>
                            <span class="fw-semibold">@a.EffectiveFrom.ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted small">Effective To:</span>
                            <span class="fw-semibold">@(a.EffectiveTo?.ToString("yyyy-MM-dd") ?? "Ongoing (Indefinite)")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted small">Assignment Status:</span>
                            <span class="badge @(a.IsCurrent ? "bg-success-subtle text-success" : "bg-light text-muted")">@(a.IsCurrent ? "Active Current" : "Closed")</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between px-0 py-2">
                            <span class="text-muted small">Assigned On:</span>
                            <span class="text-muted small">@a.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm UTC")</span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@a.ShiftAssignmentId" class="btn btn-sm btn-primary px-3">
                        <i class="bi bi-pencil me-1"></i>Edit Dates
                    </a>
                    <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    @if (a.IsCurrent)
    {
        <!-- End Assignment Modal -->
        <div class="modal fade" id="endModal-@a.ShiftAssignmentId" tabindex="-1" aria-hidden="true" style="white-space: normal;">
            <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 440px;">
                <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                    <form asp-action="End" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="shiftAssignmentId" value="@a.ShiftAssignmentId" />
                        <div class="modal-header border-0 pb-0">
                            <h6 class="modal-title fw-bold text-dark d-flex align-items-center gap-2">
                                <i class="bi bi-stop-circle text-warning fs-5"></i> Close Shift Assignment
                            </h6>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                            <p class="text-secondary small mb-3">
                                Select the last effective date for <strong>@a.EmployeeName</strong> on <strong>@a.ShiftName</strong>:
                            </p>
                            <input type="date" name="effectiveTo" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" min="@a.EffectiveFrom.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-sm btn-warning text-dark px-3 fw-semibold">Confirm End</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <!-- Delete / Remove Assignment Modal -->
    <div class="modal fade" id="deleteModal-@a.ShiftAssignmentId" tabindex="-1" aria-hidden="true" style="white-space: normal;">
        <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 440px;">
            <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@a.ShiftAssignmentId" />
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle fs-5"></i> Delete Assignment
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                        <p class="text-secondary mb-0" style="font-size: 0.95rem; line-height: 1.5;">
                            Are you sure you want to remove <strong>@a.EmployeeName</strong> from shift <strong>@a.ShiftName</strong>?
                        </p>
                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold">Confirm Delete</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
