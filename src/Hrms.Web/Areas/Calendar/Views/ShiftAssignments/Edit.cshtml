@model EditShiftAssignmentViewModel
@{
    ViewData["Title"] = $"Edit Shift Assignment - {Model.EmployeeName}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-light btn-sm border me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Shift Assignment</h4>
                <p class="text-muted small mb-0">Adjust effective schedule dates for the assigned employee</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ShiftAssignmentId" />
                    <input type="hidden" asp-for="EmployeeId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                    <div class="p-3 bg-light rounded mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Employee:</span>
                            <span class="fw-bold text-dark">@Model.EmployeeName</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Assigned Shift:</span>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fw-semibold">
                                <i class="bi bi-clock me-1"></i>@Model.ShiftName
                            </span>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="EffectiveFrom" class="form-label fw-semibold small">Effective From <span class="text-danger">*</span></label>
                            <input asp-for="EffectiveFrom" type="date" class="form-control" required />
                            <span asp-validation-for="EffectiveFrom" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EffectiveTo" class="form-label fw-semibold small">Effective To (Optional)</label>
                            <input asp-for="EffectiveTo" type="date" class="form-control" />
                            <span asp-validation-for="EffectiveTo" class="text-danger small"></span>
                            <div class="form-text" style="font-size: 0.75rem;">Leave empty for ongoing/open assignment.</div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
