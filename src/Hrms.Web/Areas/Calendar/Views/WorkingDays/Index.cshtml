@model WorkingDaysFormViewModel
@{
    ViewData["Title"] = "Working Days & Weekend Configuration";
}

<partial name="_CalendarNav" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-calendar2-week me-2 text-primary"></i>Working Days & Weekend</h4>
        <p class="text-muted small mb-0">Configure company-wide standard weekly working days and weekly holidays</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Index" method="post">
    @Html.AntiForgeryToken()
    <div class="card border-0 shadow-sm mb-4" style="border-radius: 14px;">
        <div class="card-header bg-white py-3 border-0">
            <h6 class="fw-bold mb-0 text-dark"><i class="bi bi-sliders me-2 text-primary"></i>Weekly Schedule Settings</h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Day of Week</th>
                            <th>Status Indicator</th>
                            <th class="text-center" style="width: 200px;">Working Day Toggle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Days.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="text-center py-4 text-muted">
                                    <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                                    Initializing weekly schedule... Please refresh this page.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.Days.Count; i++)
                            {
                                var day = Model.Days[i];
                                var isWeekend = !day.IsWorkingDay;
                                <tr id="row-day-@i">
                                    <td class="ps-4">
                                        <input type="hidden" name="Days[@i].DayOfWeek" value="@day.DayOfWeek" />
                                        <input type="hidden" name="Days[@i].DayName" value="@day.DayName" />
                                        <span class="day-label fw-bold fs-6 @(isWeekend ? "text-danger" : "text-dark")">
                                            <i class="day-icon bi @(isWeekend ? "bi-sun" : "bi-briefcase") me-2"></i>@day.DayName
                                        </span>
                                    </td>
                                    <td class="indicator-cell">
                                        @if (day.IsWorkingDay)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                <i class="bi bi-check2-circle me-1"></i>Official Working Day
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                                <i class="bi bi-pause-circle me-1"></i>Weekly Off (Weekend)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input fs-5 day-toggle" type="checkbox" role="switch"
                                                   data-index="@i"
                                                   name="Days[@i].IsWorkingDay" value="true" @(day.IsWorkingDay ? "checked" : "") />
                                            <input type="hidden" name="Days[@i].IsWorkingDay" value="false" />
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-light border-0 py-3 d-flex justify-content-between align-items-center">
            <span class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>Toggling a day off sets it as an official weekly holiday across the organization.
            </span>
            <div class="d-flex align-items-center gap-2">
                <a asp-controller="Holidays" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-calendar3 me-1"></i>View in Calendar
                </a>
                <button type="submit" class="btn btn-primary px-4 fw-semibold shadow-sm">
                    <i class="bi bi-save me-1"></i>Save Schedule Changes
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    document.querySelectorAll('.day-toggle').forEach(function(toggle) {
        toggle.addEventListener('change', function() {
            var idx = this.getAttribute('data-index');
            var row = document.getElementById('row-day-' + idx);
            if (!row) return;

            var indicatorCell = row.querySelector('.indicator-cell');
            var label = row.querySelector('.day-label');
            var icon = row.querySelector('.day-icon');

            if (this.checked) {
                indicatorCell.innerHTML = '<span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2"><i class="bi bi-check2-circle me-1"></i>Official Working Day</span>';
                label.classList.remove('text-danger');
                label.classList.add('text-dark');
                icon.className = 'day-icon bi bi-briefcase me-2';
            } else {
                indicatorCell.innerHTML = '<span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2"><i class="bi bi-pause-circle me-1"></i>Weekly Off (Weekend)</span>';
                label.classList.remove('text-dark');
                label.classList.add('text-danger');
                icon.className = 'day-icon bi bi-sun me-2';
            }
        });
    });
</script>
}
