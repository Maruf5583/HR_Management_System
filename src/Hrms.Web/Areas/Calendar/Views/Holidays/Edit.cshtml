@model HolidayFormViewModel
@{
    ViewData["Title"] = "Edit Holiday";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-light btn-sm border me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold mb-0"><i class="bi bi-pencil-square me-2 text-primary"></i>Edit Holiday</h4>
                <p class="text-muted small mb-0">Update holiday title, date or classification</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 14px;">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="HolidayId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold small">Holiday Name <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="HolidayDate" class="form-label fw-semibold small">Holiday Date <span class="text-danger">*</span></label>
                        <input asp-for="HolidayDate" type="date" class="form-control" />
                        <span asp-validation-for="HolidayDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Type" class="form-label fw-semibold small">Holiday Type <span class="text-danger">*</span></label>
                        <select asp-for="Type" class="form-select">
                            <option value="Government">Government / Statutory Holiday</option>
                            <option value="Company">Company / Organization Holiday</option>
                        </select>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-save me-1"></i>Update Holiday
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
