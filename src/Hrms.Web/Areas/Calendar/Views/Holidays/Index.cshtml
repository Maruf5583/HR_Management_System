@model HolidayListViewModel
@{
    ViewData["Title"] = "Holidays Calendar";
    ViewData["Subtitle"] = "View statutory government holidays and organization-specific days off";
    var months = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    var viewDate = new DateTime(Model.ViewYear, Model.ViewMonth, 1);
    var firstDayOfWeek = (int)viewDate.DayOfWeek; // 0 = Sunday
    var daysInMonth = DateTime.DaysInMonth(Model.ViewYear, Model.ViewMonth);
    var prevMonthYear = Model.ViewMonth == 1 ? Model.ViewYear - 1 : Model.ViewYear;
    var prevMonth = Model.ViewMonth == 1 ? 12 : Model.ViewMonth - 1;
    var nextMonthYear = Model.ViewMonth == 12 ? Model.ViewYear + 1 : Model.ViewYear;
    var nextMonth = Model.ViewMonth == 12 ? 1 : Model.ViewMonth + 1;
}

<partial name="_CalendarNav" />


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Filters Bar with Quick Month & Year Stepper -->
<div class="card border-0 shadow-xs mb-4" style="border: 1px solid #eaecf0 !important; border-radius: 14px; background: #ffffff;">
    <div class="card-body py-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-auto">
                <label class="form-label small fw-semibold text-secondary mb-0 me-2">Month:</label>
                <select name="month" class="form-select form-select-sm d-inline-block" style="width: auto; min-width: 160px;" onchange="this.form.submit()">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(m == Model.ViewMonth)">@months[m - 1]</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small fw-semibold text-secondary mb-0 me-2">Year:</label>
                <select name="year" class="form-select form-select-sm d-inline-block" style="width: auto; min-width: 120px;" onchange="this.form.submit()">
                    @foreach (var y in Model.AvailableYears)
                    {
                        <option value="@y" selected="@(y == Model.SelectedYear)">@y</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small fw-semibold text-muted mb-0 me-2">Type:</label>
                <select name="type" class="form-select form-select-sm d-inline-block" style="width: auto; min-width: 140px;" onchange="this.form.submit()">
                    <option value="">All Types</option>
                    <option value="Government" selected="@(Model.SelectedType == HolidayType.Government)">Government</option>
                    <option value="Company" selected="@(Model.SelectedType == HolidayType.Company)">Company</option>
                </select>
            </div>
            @if (Model.SelectedType.HasValue)
            {
                <div class="col-auto">
                    <a asp-action="Index" asp-route-year="@Model.SelectedYear" asp-route-month="@Model.ViewMonth" class="btn btn-sm btn-light border text-muted">
                        <i class="bi bi-x-circle me-1"></i>Reset Filter
                    </a>
                </div>
            }
            @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
            {
                <div class="col-auto ms-auto d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary shadow-xs px-3 fw-semibold rounded-3" data-bs-toggle="modal" data-bs-target="#multiDayModal" style="height: 40px; font-size: 0.875rem; white-space: nowrap;">
                        Add multi-day vacation
                    </button>
                    <a asp-action="Create" class="btn btn-primary px-3 fw-semibold rounded-3 shadow-xs d-inline-flex align-items-center gap-1.5" style="height: 40px; font-size: 0.875rem; white-space: nowrap;">
                        <i class="bi bi-plus-lg"></i>
                        <span>Add holiday</span>
                    </a>
                </div>
            }
        </form>
    </div>
</div>

<div class="row g-4 align-items-start">
    <!-- Visual Calendar View -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-xs" style="border: 1px solid #eaecf0 !important; border-radius: 14px; background: #ffffff;">
            <div class="card-header bg-white py-3 border-0">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-calendar3 me-2 text-primary"></i>@months[Model.ViewMonth - 1] @Model.ViewYear
                    </h6>
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Index" asp-route-year="@prevMonthYear" asp-route-month="@prevMonth" asp-route-type="@Model.SelectedType" class="btn btn-light border text-secondary shadow-xs" title="Previous Month">
                            <i class="bi bi-chevron-left"></i> Prev
                        </a>
                        <a asp-action="Index" asp-route-year="@DateTime.UtcNow.Year" asp-route-month="@DateTime.UtcNow.Month" class="btn btn-primary shadow-xs">
                            Current Month
                        </a>
                        <a asp-action="Index" asp-route-year="@nextMonthYear" asp-route-month="@nextMonth" asp-route-type="@Model.SelectedType" class="btn btn-light border text-secondary shadow-xs" title="Next Month">
                            Next <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-2 pt-2 border-top" style="font-size: 0.78rem;">
                    <span class="text-muted fw-semibold"><i class="bi bi-calendar2-week me-1"></i>Weekly Off:</span>
                    @{
                        var weeklyOffs = Model.WorkingDays.Where(w => !w.IsWorkingDay).ToList();
                    }
                    @if (weeklyOffs.Count > 0)
                    {
                        @foreach (var w in weeklyOffs)
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                <i class="bi bi-sun me-1"></i>@w.DayName
                            </span>
                        }
                    }
                    else
                    {
                        <span class="badge bg-light text-muted border px-2 py-1">None (All 7 Days Working)</span>
                    }
                    @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                    {
                        <a asp-controller="WorkingDays" asp-action="Index" class="text-primary text-decoration-none ms-auto small" title="Configure Working Days & Weekly Off">
                            <i class="bi bi-sliders me-1"></i>Change Schedule
                        </a>
                    }
                </div>
            </div>
            <div class="card-body p-3">
                <div class="row g-1 text-center fw-bold small mb-2">
                    @{
                        var daysList = new (DayOfWeek Day, string ShortName)[]
                        {
                            (DayOfWeek.Sunday, "Sun"),
                            (DayOfWeek.Monday, "Mon"),
                            (DayOfWeek.Tuesday, "Tue"),
                            (DayOfWeek.Wednesday, "Wed"),
                            (DayOfWeek.Thursday, "Thu"),
                            (DayOfWeek.Friday, "Fri"),
                            (DayOfWeek.Saturday, "Sat")
                        };
                    }
                    @foreach (var d in daysList)
                    {
                        var isOff = Model.IsWeekend(d.Day);
                        <div class="col @(isOff ? "text-danger" : "text-muted")">
                            @d.ShortName
                            @if (isOff)
                            {
                                <span class="d-none d-sm-inline" style="font-size: 0.65rem;">(Off)</span>
                            }
                        </div>
                    }
                </div>

                <div class="row g-1 text-center">
                    @for (int p = 0; p < firstDayOfWeek; p++)
                    {
                        <div class="col py-3 bg-light rounded opacity-25"></div>
                    }

                    @for (int day = 1; day <= daysInMonth; day++)
                    {
                        var cellDate = new DateOnly(Model.ViewYear, Model.ViewMonth, day);
                        var holiday = Model.Holidays.FirstOrDefault(h => h.HolidayDate == cellDate);
                        var isToday = cellDate == DateOnly.FromDateTime(DateTime.UtcNow);
                        var isWeekendDay = Model.IsWeekend(cellDate.DayOfWeek);

                        <div class="col p-1">
                            <div class="p-2 rounded border position-relative @(holiday != null ? "bg-warning-subtle border-warning shadow-sm" : (isWeekendDay ? "bg-light text-danger" : "bg-white")) @(isToday ? "border-primary border-2 shadow-sm" : "")" style="min-height: 70px;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold @(isToday ? "text-primary" : (isWeekendDay ? "text-danger" : "text-dark")) small">@day</span>
                                    @if (holiday == null && CurrentUser.HasPermission(Permissions.Holidays.Manage))
                                    {
                                        <button type="button" class="btn btn-link p-0 text-muted opacity-50" style="font-size: 0.7rem; text-decoration: none;" data-bs-toggle="modal" data-bs-target="#quickAddModal-@cellDate.ToString("yyyyMMdd")" title="Add Holiday on @cellDate.ToString("yyyy-MM-dd")">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    }
                                </div>

                                @if (holiday != null)
                                {
                                    <div class="badge @(holiday.Type == HolidayType.Government ? "bg-danger" : "bg-primary") text-truncate w-100 p-1 small"
                                         style="font-size: 0.65rem; cursor: pointer;"
                                         data-bs-toggle="modal"
                                         data-bs-target="#editHolidayModal-@holiday.HolidayId"
                                         title="Click to Edit / Change: @holiday.Name (@holiday.Type)">
                                        <i class="bi bi-pencil-fill me-1" style="font-size: 0.55rem;"></i>@holiday.Name
                                    </div>
                                }
                                else if (isWeekendDay)
                                {
                                    <div class="text-danger-emphasis text-truncate w-100 px-1 py-0 rounded text-center small"
                                         style="font-size: 0.62rem; background-color: rgba(220, 53, 69, 0.08); border: 1px dashed rgba(220, 53, 69, 0.25);"
                                         title="Weekly Off (Weekend)">
                                        <i class="bi bi-sun me-1"></i>Weekly Off
                                    </div>
                                }
                            </div>
                        </div>

                        @if ((firstDayOfWeek + day) % 7 == 0 && day != daysInMonth)
                        {
                            @:</div><div class="row g-1 text-center mt-1">
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Tabular List View with Single & Multiple / Bulk Delete -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-xs" style="border: 1px solid #eaecf0 !important; border-radius: 14px; background: #ffffff;">
            <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-list-stars me-2 text-primary"></i>Holidays in @Model.SelectedYear (@Model.Holidays.Count)
                    </h6>
                </div>
                @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                {
                    <button type="button" class="btn btn-sm btn-danger d-none align-items-center gap-1 shadow-xs px-2.5 py-1" id="bulkDeleteTriggerBtn" data-bs-toggle="modal" data-bs-target="#bulkDeleteModal">
                        <i class="bi bi-trash"></i>
                        <span>Delete Selected (<span id="selectedCountBadge">0</span>)</span>
                    </button>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                                {
                                    <th class="ps-3" style="width: 36px;">
                                        <input type="checkbox" class="form-check-input" id="selectAllHolidays" title="Select All Holidays" />
                                    </th>
                                }
                                <th class="@(CurrentUser.HasPermission(Permissions.Holidays.Manage) ? "" : "ps-3")">Date</th>
                                <th>Holiday Name</th>
                                <th>Type</th>
                                @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                                {
                                    <th class="text-end pe-3">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Holidays.Any())
                            {
                                <tr>
                                    <td colspan="@(CurrentUser.HasPermission(Permissions.Holidays.Manage) ? 5 : 4)" class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                                        No holidays recorded for @Model.SelectedYear.
                                    </td>
                                </tr>
                            }
                            @foreach (var h in Model.Holidays)
                            {
                                var sameNameHolidays = Model.Holidays.Where(x => string.Equals(x.Name.Trim(), h.Name.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
                                var isMultiDay = sameNameHolidays.Count > 1;
                                <tr>
                                    @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                                    {
                                        <td class="ps-3">
                                            <input type="checkbox" class="form-check-input holiday-checkbox" name="holidayIds" value="@h.HolidayId" form="bulkDeleteForm" />
                                        </td>
                                    }
                                    <td class="@(CurrentUser.HasPermission(Permissions.Holidays.Manage) ? "" : "ps-3") text-nowrap">
                                        <div class="fw-bold text-dark">@h.HolidayDate.ToString("MMM dd")</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">@h.HolidayDate.DayOfWeek</div>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                            <span class="fw-semibold text-dark">@h.Name</span>
                                            @if (isMultiDay)
                                            {
                                                <span class="badge bg-light text-muted border px-1.5 py-0.5 rounded-pill" style="font-size: 0.68rem;" title="Part of a @sameNameHolidays.Count day series">
                                                    @sameNameHolidays.Count days
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        @if (h.Type == HolidayType.Government)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">Govt</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">Company</span>
                                        }
                                    </td>
                                    @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                                    {
                                        <td class="text-end pe-3 text-nowrap">
                                            <!-- Single Edit -->
                                            <a asp-action="Edit" asp-route-id="@h.HolidayId" class="btn btn-sm btn-outline-secondary me-1" title="Edit / Change">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <!-- Delete Trigger Button -->
                                            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteSingleModal-@h.HolidayId" title="@(isMultiDay ? "Delete single date or full series" : "Delete holiday")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- ALL MODALS PLACED OUTSIDE TABLE FOR CLEAN WRAPPING -->
<!-- ========================================== -->

@if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
{
    <!-- Delete Modals for Each Holiday in Table -->
    @foreach (var h in Model.Holidays)
    {
        var sameNameHolidays = Model.Holidays.Where(x => string.Equals(x.Name.Trim(), h.Name.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        var isMultiDay = sameNameHolidays.Count > 1;

        <div class="modal fade" id="deleteSingleModal-@h.HolidayId" tabindex="-1" aria-hidden="true" style="white-space: normal;">
            <div class="modal-dialog modal-dialog-centered text-start" style="max-width: @(isMultiDay ? "520px" : "440px");">
                <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                    <div class="modal-header border-0 pb-0">
                        <h6 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                            <i class="bi bi-trash fs-5"></i> Delete Holiday
                        </h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                        @if (isMultiDay)
                        {
                            <div class="p-3 rounded-3 bg-light border mb-3">
                                <div class="fw-bold text-dark mb-1">
                                    <i class="bi bi-calendar-range text-primary me-1"></i>'@h.Name' is a Multi-Day Vacation
                                </div>
                                <div class="text-secondary small">
                                    Total: <strong>@sameNameHolidays.Count days</strong> (@sameNameHolidays.Min(x => x.HolidayDate).ToString("MMM dd") – @sameNameHolidays.Max(x => x.HolidayDate).ToString("MMM dd")).
                                </div>
                            </div>
                            <p class="text-secondary mb-0" style="font-size: 0.95rem;">
                                Choose whether you want to remove <strong>only this single date (@h.HolidayDate.ToString("yyyy-MM-dd"))</strong> or remove the <strong>entire '@h.Name' series (all @sameNameHolidays.Count days)</strong> at once.
                            </p>
                        }
                        else
                        {
                            <p class="text-secondary mb-0" style="font-size: 0.95rem; line-height: 1.5;">
                                Are you sure you want to delete holiday <strong>'@h.Name'</strong> on <strong>@h.HolidayDate.ToString("yyyy-MM-dd")</strong>?
                            </p>
                        }
                    </div>
                    <div class="modal-footer border-0 pt-0 d-flex flex-wrap justify-content-end gap-2">
                        <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Cancel</button>

                        <form asp-action="Delete" asp-route-id="@h.HolidayId" method="post" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnYear" value="@Model.ViewYear" />
                            <input type="hidden" name="returnMonth" value="@Model.ViewMonth" />
                            <button type="submit" class="btn btn-sm @(isMultiDay ? "btn-outline-danger" : "btn-danger") px-3 fw-semibold">
                                @(isMultiDay ? $"Delete Only {h.HolidayDate:MMM dd}" : "Confirm Delete")
                            </button>
                        </form>

                        @if (isMultiDay)
                        {
                            <form asp-action="DeleteGroup" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="holidayName" value="@h.Name" />
                                <input type="hidden" name="returnYear" value="@Model.ViewYear" />
                                <input type="hidden" name="returnMonth" value="@Model.ViewMonth" />
                                <button type="submit" class="btn btn-sm btn-danger px-3 fw-semibold">
                                    <i class="bi bi-trash me-1"></i>Delete All @sameNameHolidays.Count Days
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Edit Holiday Modals for Visual Calendar Grid Items -->
    @for (int day = 1; day <= daysInMonth; day++)
    {
        var cellDate = new DateOnly(Model.ViewYear, Model.ViewMonth, day);
        var holiday = Model.Holidays.FirstOrDefault(h => h.HolidayDate == cellDate);
        if (holiday != null)
        {
            <div class="modal fade" id="editHolidayModal-@holiday.HolidayId" tabindex="-1" aria-hidden="true" style="white-space: normal;">
                <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 460px;">
                    <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                        <form asp-action="Edit" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="HolidayId" value="@holiday.HolidayId" />
                            <div class="modal-header border-0 pb-0">
                                <h6 class="modal-title fw-bold d-flex align-items-center gap-2">
                                    <i class="bi bi-calendar-event text-primary fs-5"></i> Change Holiday
                                </h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body py-3" style="white-space: normal;">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Holiday Name <span class="text-danger">*</span></label>
                                    <input type="text" name="Name" class="form-control" value="@holiday.Name" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Date <span class="text-danger">*</span></label>
                                    <input type="date" name="HolidayDate" class="form-control" value="@holiday.HolidayDate.ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label fw-semibold small">Type <span class="text-danger">*</span></label>
                                    <select name="Type" class="form-select">
                                        <option value="Government" selected="@(holiday.Type == HolidayType.Government)">Government Holiday</option>
                                        <option value="Company" selected="@(holiday.Type == HolidayType.Company)">Company Holiday</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0 d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteSingleModal-@holiday.HolidayId">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </button>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold">Save Changes</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Quick Add Modal for Empty Dates -->
            <div class="modal fade" id="quickAddModal-@cellDate.ToString("yyyyMMdd")" tabindex="-1" aria-hidden="true" style="white-space: normal;">
                <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 450px;">
                    <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                        <form asp-action="Create" method="post">
                            @Html.AntiForgeryToken()
                            <div class="modal-header border-0 pb-0">
                                <h6 class="modal-title fw-bold d-flex align-items-center gap-2">
                                    <i class="bi bi-plus-circle text-primary fs-5"></i> Add Holiday
                                </h6>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body py-3" style="white-space: normal;">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Holiday Name <span class="text-danger">*</span></label>
                                    <input type="text" name="Name" class="form-control" placeholder="e.g. National Day" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold small">Date <span class="text-danger">*</span></label>
                                    <input type="date" name="HolidayDate" class="form-control" value="@cellDate.ToString("yyyy-MM-dd")" required />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label fw-semibold small">Type <span class="text-danger">*</span></label>
                                    <select name="Type" class="form-select">
                                        <option value="Government">Government Holiday</option>
                                        <option value="Company">Company Holiday</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0">
                                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-sm btn-primary px-3 fw-semibold">Save Holiday</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Bulk / Multiple Delete Confirmation Modal -->
    <div class="modal fade" id="bulkDeleteModal" tabindex="-1" aria-hidden="true" style="white-space: normal;">
        <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 440px;">
            <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold text-danger d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle fs-5"></i> Delete Selected Holidays
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                    <p class="text-secondary mb-0" style="font-size: 0.95rem; line-height: 1.5;">
                        Are you sure you want to permanently delete the <strong id="modalSelectedCount">0</strong> selected holiday(s)? This action cannot be undone.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" form="bulkDeleteForm" class="btn btn-sm btn-danger px-3 fw-semibold">Confirm Delete All</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Multi-Day Vacation Modal -->
<div class="modal fade" id="multiDayModal" tabindex="-1" aria-labelledby="multiDayModalLabel" aria-hidden="true" style="white-space: normal;">
    <div class="modal-dialog modal-dialog-centered text-start">
        <div class="modal-content border-0 shadow" style="border-radius: 14px;">
            <form asp-action="CreateMultiDay" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold d-flex align-items-center gap-2" id="multiDayModalLabel">
                        <i class="bi bi-calendar-range text-primary"></i> Add Multi-Day Vacation / Holiday
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-4" style="white-space: normal;">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Holiday Name <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Eid-ul-Fitr Vacation" required />
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">Start Date <span class="text-danger">*</span></label>
                            <input type="date" name="StartDate" class="form-control" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold small">End Date <span class="text-danger">*</span></label>
                            <input type="date" name="EndDate" class="form-control" value="@DateTime.UtcNow.AddDays(2).ToString("yyyy-MM-dd")" required />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Holiday Type <span class="text-danger">*</span></label>
                        <select name="Type" class="form-select" required>
                            <option value="Government">Government Holiday</option>
                            <option value="Company">Company Holiday</option>
                        </select>
                    </div>
                    <div class="alert alert-info py-2 px-3 small border-0 mb-0">
                        <i class="bi bi-info-circle me-1"></i>This will automatically generate consecutive daily holiday records for all dates within the chosen range.
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-plus-lg me-1"></i>Add Vacation Range
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<form id="bulkDeleteForm" asp-action="DeleteMultiple" method="post" class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnYear" value="@Model.ViewYear" />
    <input type="hidden" name="returnMonth" value="@Model.ViewMonth" />
</form>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const selectAll = document.getElementById('selectAllHolidays');
            const checkboxes = document.querySelectorAll('.holiday-checkbox');
            const bulkBtn = document.getElementById('bulkDeleteTriggerBtn');
            const countBadge = document.getElementById('selectedCountBadge');
            const modalCount = document.getElementById('modalSelectedCount');

            function updateBulkDeleteState() {
                const checked = document.querySelectorAll('.holiday-checkbox:checked');
                const checkedCount = checked.length;
                if (bulkBtn) {
                    if (checkedCount > 0) {
                        bulkBtn.classList.remove('d-none');
                        bulkBtn.classList.add('d-inline-flex');
                    } else {
                        bulkBtn.classList.add('d-none');
                        bulkBtn.classList.remove('d-inline-flex');
                    }
                }
                if (countBadge) countBadge.textContent = checkedCount;
                if (modalCount) modalCount.textContent = checkedCount;

                if (selectAll) {
                    selectAll.checked = checkboxes.length > 0 && checkedCount === checkboxes.length;
                    selectAll.indeterminate = checkedCount > 0 && checkedCount < checkboxes.length;
                }
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checkboxes.forEach(cb => cb.checked = selectAll.checked);
                    updateBulkDeleteState();
                });
            }

            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateBulkDeleteState);
            });
        });
    </script>
}


