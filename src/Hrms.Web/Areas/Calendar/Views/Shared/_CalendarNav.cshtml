@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString();
}

<div class="d-flex flex-wrap align-items-center mb-4">
    <div class="d-inline-flex p-1 bg-white border rounded-3 shadow-xs" style="border-color: #eaecf0 !important;">
        <a class="btn btn-sm rounded-2 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 @(currentCtrl == "Holidays" ? "btn-primary text-white shadow-xs" : "btn-link text-secondary text-decoration-none")"
           asp-area="Calendar" asp-controller="Holidays" asp-action="Index">
            <span>Holidays Calendar</span>
        </a>
        <a class="btn btn-sm rounded-2 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 @(currentCtrl == "Shifts" ? "btn-primary text-white shadow-xs" : "btn-link text-secondary text-decoration-none")"
           asp-area="Calendar" asp-controller="Shifts" asp-action="Index">
            <span>Work Shifts</span>
        </a>
        <a class="btn btn-sm rounded-2 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 @(currentCtrl == "ShiftAssignments" ? "btn-primary text-white shadow-xs" : "btn-link text-secondary text-decoration-none")"
           asp-area="Calendar" asp-controller="ShiftAssignments" asp-action="Index">
            <span>Shift Assignments</span>
        </a>
        <a class="btn btn-sm rounded-2 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 @(currentCtrl == "WorkingDays" ? "btn-primary text-white shadow-xs" : "btn-link text-secondary text-decoration-none")"
           asp-area="Calendar" asp-controller="WorkingDays" asp-action="Index">
            <span>Working Days & Weekend</span>
        </a>
    </div>
</div>