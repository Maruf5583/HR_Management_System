@section Scripts {
    <script>
        function handleEmployeeRowClick(event, url) {
            if (event.target.closest('.dropdown, .dropdown-menu, button, a, input, label, select, textarea')) {
                return;
            }
            window.location.href = url;
        }

        function filterDropdownMenuOptions(input) {
            const query = input.value.trim().toLowerCase();
            const list = input.closest('.filter-dropdown-menu').querySelector('.filter-dropdown-list');
            if (!list) return;
            const items = list.querySelectorAll('li');
            items.forEach(li => {
                const text = li.textContent.trim().toLowerCase();
                if (!query || text.includes(query)) {
                    li.style.display = '';
                } else {
                    li.style.display = 'none';
                }
            });
        }

        let currentDeptText = '';
        function setEmployeeClientFilter(type, val, label, el) {
            let inputId = '';
            let btnId = '';

            if (type === 'dept') {
                inputId = 'filterDepartmentInput';
                btnId = 'empDeptBtn';
                currentDeptText = val ? label.trim().toLowerCase() : '';
            } else if (type === 'status') {
                inputId = 'filterStatusInput';
                btnId = 'empStatusBtn';
            } else if (type === 'type') {
                inputId = 'filterEmpTypeInput';
                btnId = 'empTypeBtn';
            }

            const input = document.getElementById(inputId);
            if (input) input.value = val;

            const btn = document.getElementById(btnId);
            if (btn) {
                const span = btn.querySelector('span');
                if (span) span.textContent = label;
                if (val) {
                    btn.classList.add('is-filtered');
                } else {
                    btn.classList.remove('is-filtered');
                }
            }

            if (el) {
                const parentUl = el.closest('.filter-dropdown-list');
                if (parentUl) {
                    parentUl.querySelectorAll('.dropdown-item').forEach(item => {
                        item.classList.remove('active');
                        const checkIcon = item.querySelector('.bi-check2');
                        if (checkIcon) checkIcon.remove();
                    });
                    el.classList.add('active');
                    const check = document.createElement('i');
                    check.className = 'bi bi-check2 ms-auto';
                    el.appendChild(check);
                }
            }

            filterEmployeesRealtime();
        }

        function filterEmployeesRealtime() {
            const query = (document.getElementById('employeeSearchInput')?.value || '').trim().toLowerCase();
            const deptVal = (document.getElementById('filterDepartmentInput')?.value || '').trim();
            const statusVal = (document.getElementById('filterStatusInput')?.value || '').trim();
            const typeVal = (document.getElementById('filterEmpTypeInput')?.value || '').trim();

            if (deptVal && !currentDeptText) {
                const btnSpan = document.querySelector('#empDeptBtn span');
                if (btnSpan && btnSpan.textContent.trim() !== 'All Departments') {
                    currentDeptText = btnSpan.textContent.trim().toLowerCase();
                }
            }

            const rows = document.querySelectorAll('tbody tr.employee-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = (row.getAttribute('data-search') || '').toLowerCase();
                const rowDept = (row.getAttribute('data-dept') || '').toLowerCase();
                const rowStatus = row.getAttribute('data-status') || '';
                const rowType = row.getAttribute('data-type') || '';

                const matchesSearch = !query || searchData.includes(query);
                const matchesDept = !deptVal || !currentDeptText || rowDept === currentDeptText;
                const matchesStatus = !statusVal || rowStatus === statusVal;
                const matchesType = !typeVal || rowType === typeVal;

                if (matchesSearch && matchesDept && matchesStatus && matchesType) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const noResultsRow = document.getElementById('noEmployeeClientResultsRow');
            if (noResultsRow) {
                if (visibleCount === 0 && rows.length > 0) {
                    noResultsRow.classList.remove('d-none');
                } else {
                    noResultsRow.classList.add('d-none');
                }
            }

            const counterEl = document.getElementById('employeesRecordsCounter');
            if (counterEl) {
                counterEl.textContent = visibleCount;
            }

            const resetBtn = document.getElementById('resetEmployeesFiltersBtn');
            if (resetBtn) {
                const isFiltered = query || deptVal || statusVal || typeVal;
                if (isFiltered) {
                    resetBtn.classList.remove('d-none');
                    resetBtn.classList.add('d-flex');
                } else {
                    resetBtn.classList.remove('d-flex');
                    resetBtn.classList.add('d-none');
                }
            }
        }

        // Interactive Slide-Over Drawer
        function showEmployeeDrawer(name, code, email, phone, dept, designation, status, empType, joinDate, completionPct, photoUrl, editUrl, detailsUrl) {
            document.getElementById('drawerFullName').textContent = name;
            document.getElementById('drawerCode').textContent = code;
            document.getElementById('drawerEmail').textContent = email;
            document.getElementById('drawerPhone').textContent = phone;
            document.getElementById('drawerDepartment').textContent = dept;
            document.getElementById('drawerDesignation').textContent = designation;
            document.getElementById('drawerEmploymentType').textContent = empType;
            document.getElementById('drawerJoinDate').textContent = joinDate;
            document.getElementById('drawerCompletionText').textContent = completionPct + '%';
            document.getElementById('drawerCompletionBar').style.width = completionPct + '%';

            // Edit & Details Links
            document.getElementById('drawerEditLink').href = editUrl;
            document.getElementById('drawerFullProfileLink').href = detailsUrl;

            // Status Badge
            const statusBadge = document.getElementById('drawerStatusBadge');
            statusBadge.className = 'badge-status-dot';
            if (status === 'Active') {
                statusBadge.classList.add('badge-status-active');
            } else if (status === 'Probation' || status === 'OnNotice') {
                statusBadge.classList.add('badge-status-warning');
            } else if (status === 'Terminated') {
                statusBadge.classList.add('badge-status-danger');
            } else {
                statusBadge.classList.add('badge-status-neutral');
            }
            statusBadge.textContent = status;

            // Avatar
            const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            const fallback = document.getElementById('drawerAvatarFallback');
            const img = document.getElementById('drawerAvatarImg');

            fallback.textContent = initials;
            if (photoUrl) {
                img.src = photoUrl;
                img.classList.remove('d-none');
                fallback.classList.add('d-none');
            } else {
                img.classList.add('d-none');
                fallback.classList.remove('d-none');
            }

            // Open Bootstrap Offcanvas
            const drawerEl = document.getElementById('employeeDetailsDrawer');
            if (drawerEl && typeof bootstrap !== 'undefined') {
                const offcanvas = bootstrap.Offcanvas.getOrCreateInstance(drawerEl);
                offcanvas.show();
            }
        }

        function updateBulkToolbar() {
            const checkedBoxes = document.querySelectorAll('.employee-checkbox:checked');
            const allBoxes = document.querySelectorAll('.employee-checkbox');
            const count = checkedBoxes.length;
            const bar = document.getElementById('bulkActionsBar');
            const countText = document.getElementById('selectedCountText');
            const selectAll = document.getElementById('selectAllEmployees');

            if (bar && countText) {
                if (count > 0) {
                    bar.classList.remove('d-none');
                    bar.classList.add('d-flex');
                    countText.textContent = count + ' selected';
                } else {
                    bar.classList.add('d-none');
                    bar.classList.remove('d-flex');
                }
            }

            if (selectAll) {
                if (allBoxes.length > 0 && count === allBoxes.length) {
                    selectAll.checked = true;
                    selectAll.indeterminate = false;
                } else if (count > 0 && count < allBoxes.length) {
                    selectAll.checked = false;
                    selectAll.indeterminate = true;
                } else {
                    selectAll.checked = false;
                    selectAll.indeterminate = false;
                }
            }
        }

        function clearAllSelections() {
            document.querySelectorAll('.employee-checkbox').forEach(cb => cb.checked = false);
            const selectAll = document.getElementById('selectAllEmployees');
            if (selectAll) {
                selectAll.checked = false;
                selectAll.indeterminate = false;
            }
            updateBulkToolbar();
        }

        function submitBulkAction(actionType) {
            const checkedBoxes = document.querySelectorAll('.employee-checkbox:checked');
            if (checkedBoxes.length === 0) return;

            const performSubmit = () => {
                const form = document.getElementById('bulkActionForm');
                document.getElementById('bulkActionType').value = actionType;
                const container = document.getElementById('bulkEmployeeIdsContainer');
                container.innerHTML = '';
                checkedBoxes.forEach(cb => {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'employeeIds';
                    input.value = cb.value;
                    container.appendChild(input);
                });
                form.submit();
            };

            if (actionType === 'deactivate') {
                window.hrmsConfirm(`Are you sure you want to deactivate <strong>${checkedBoxes.length}</strong> selected employee(s)?`, performSubmit, {
                    title: 'Deactivate Employees',
                    btnText: 'Confirm Deactivation'
                });
            } else {
                performSubmit();
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            const selectAll = document.getElementById('selectAllEmployees');
            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    document.querySelectorAll('.employee-checkbox').forEach(cb => {
                        cb.checked = selectAll.checked;
                    });
                    updateBulkToolbar();
                });
            }

            document.querySelectorAll('.employee-checkbox').forEach(cb => {
                cb.addEventListener('change', updateBulkToolbar);
            });
        });
    </script>
}
