@model EmployeeIndexViewModel
@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-people-fill me-2 text-primary"></i>Employees Directory</h4>
        <p class="text-muted small mb-0">View, search and manage company employee records</p>
    </div>
    @if (CurrentUser.HasPermission(Permissions.Employees.Manage))
    {
        <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
            <i class="bi bi-person-plus-fill"></i> Add Employee
        </a>
    }
</div>

<!-- Search and Filter Form -->
<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Search</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="Search" value="@Model.Filter.Search" class="form-control" placeholder="Name, code, email, phone..." />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Department</label>
                <select name="DepartmentId" asp-items="Model.DepartmentOptions" class="form-select form-select-sm">
                    <option value="">-- All --</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="Status" class="form-select form-select-sm">
                    <option value="">-- All --</option>
                    @foreach (var status in Enum.GetValues<EmployeeStatus>())
                    {
                        <option value="@status" selected="@(Model.Filter.Status == status)">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Employment</label>
                <select name="EmploymentType" class="form-select form-select-sm">
                    <option value="">-- All --</option>
                    @foreach (var type in Enum.GetValues<EmploymentType>())
                    {
                        <option value="@type" selected="@(Model.Filter.EmploymentType == type)">@type</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    Clear
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Employee List Table -->
<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Employee</th>
                        <th>Code</th>
                        <th>Department & Role</th>
                        <th>Grade</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Join Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.PagedEmployees.Items.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-people fs-1 d-block mb-2"></i>
                                No employee records found matching criteria.
                            </td>
                        </tr>
                    }
                    @foreach (var emp in Model.PagedEmployees.Items)
                    {
                        var initials = (emp.FirstName.Length > 0 ? emp.FirstName[..1] : "") + (emp.LastName.Length > 0 ? emp.LastName[..1] : "");
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(emp.PhotoKey))
                                    {
                                        <img src="/uploads/@emp.PhotoKey" alt="@emp.FullName" class="rounded-circle border" style="width: 40px; height: 40px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; font-size: 0.85rem;">
                                            @initials.ToUpper()
                                        </div>
                                    }
                                    <div>
                                        <a asp-action="Details" asp-route-id="@emp.EmployeeId" class="fw-semibold text-dark text-decoration-none d-block">
                                            @emp.FullName
                                        </a>
                                        <small class="text-muted d-block">@(emp.Email ?? emp.Phone ?? "No contact")</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border font-monospace">@emp.EmployeeCode</span>
                            </td>
                            <td>
                                <div class="fw-medium text-dark">@emp.DesignationTitle</div>
                                <small class="text-muted">@emp.DepartmentName</small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@emp.GradeCode</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@emp.EmploymentType</span>
                            </td>
                            <td>
                                @switch (emp.Status)
                                {
                                    case EmployeeStatus.Active:
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                        break;
                                    case EmployeeStatus.OnNotice:
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">On Notice</span>
                                        break;
                                    case EmployeeStatus.Resigned:
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Resigned</span>
                                        break;
                                    case EmployeeStatus.Terminated:
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Terminated</span>
                                        break;
                                }
                            </td>
                            <td class="text-muted small">@emp.JoinDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Details" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (CurrentUser.HasPermission(Permissions.Employees.Manage))
                                    {
                                        <a asp-action="Edit" asp-route-id="@emp.EmployeeId" class="btn btn-sm btn-outline-secondary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Controls -->
        @if (Model.PagedEmployees.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center p-3 border-top">
                <small class="text-muted">
                    Showing @(((Model.PagedEmployees.PageNumber - 1) * Model.PagedEmployees.PageSize) + (Model.PagedEmployees.Items.Count > 0 ? 1 : 0)) to
                    @(((Model.PagedEmployees.PageNumber - 1) * Model.PagedEmployees.PageSize) + Model.PagedEmployees.Items.Count) of @Model.PagedEmployees.TotalCount employees
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.PagedEmployees.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageNumber="@(Model.PagedEmployees.PageNumber - 1)"
                               asp-route-PageSize="@Model.Filter.PageSize"
                               asp-route-Search="@Model.Filter.Search"
                               asp-route-DepartmentId="@Model.Filter.DepartmentId"
                               asp-route-Status="@Model.Filter.Status"
                               asp-route-EmploymentType="@Model.Filter.EmploymentType">Previous</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="page-link">Page @Model.PagedEmployees.PageNumber of @Model.PagedEmployees.TotalPages</span>
                        </li>
                        <li class="page-item @(!Model.PagedEmployees.HasNextPage ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-PageNumber="@(Model.PagedEmployees.PageNumber + 1)"
                               asp-route-PageSize="@Model.Filter.PageSize"
                               asp-route-Search="@Model.Filter.Search"
                               asp-route-DepartmentId="@Model.Filter.DepartmentId"
                               asp-route-Status="@Model.Filter.Status"
                               asp-route-EmploymentType="@Model.Filter.EmploymentType">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>
