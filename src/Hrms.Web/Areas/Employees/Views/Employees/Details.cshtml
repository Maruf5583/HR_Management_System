@model EmployeeDetailsDto
@{
    ViewData["Title"] = $"{Model.FullName} ({Model.EmployeeCode})";
    var initials = (Model.FirstName.Length > 0 ? Model.FirstName[..1] : "") + (Model.LastName.Length > 0 ? Model.LastName[..1] : "");
    var canManage = CurrentUser.HasPermission(Permissions.Employees.Manage);
    var canViewNid = CurrentUser.HasPermission(Permissions.Employees.ViewNid);
    var rowVersionBase64 = Model.RowVersion != null ? Convert.ToBase64String(Model.RowVersion) : "";
    var bankProfile = ViewBag.BankProfile as EmployeeBankProfileDto;
    var activeBank = bankProfile?.ActiveBankDetail;
    var pendingBank = bankProfile?.PendingRequest;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div class="d-flex align-items-center">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="fw-bold mb-0">@Model.FullName</h4>
            <p class="text-muted small mb-0 font-monospace">@Model.EmployeeCode &bull; @Model.DesignationTitle</p>
        </div>
    </div>
    @if (canManage)
    {
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-warning" data-bs-toggle="modal" data-bs-target="#changeStatusModal">
                <i class="bi bi-arrow-repeat me-1"></i> Change Status
            </button>
            <a asp-action="Edit" asp-route-id="@Model.EmployeeId" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i> Edit Employee
            </a>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteEmployeeModal">
                <i class="bi bi-trash me-1"></i> Delete
            </button>
        </div>
    }
</div>

<div class="row g-4">
    <!-- Left Column: Profile Card & Photo -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm text-center p-4 mb-4" style="border-radius: 12px;">
            <div class="position-relative d-inline-block mx-auto mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoKey))
                {
                    <img src="/uploads/@Model.PhotoKey" alt="@Model.FullName" class="rounded-circle border shadow-sm" style="width: 140px; height: 140px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center justify-content-center fw-bold shadow-sm mx-auto" style="width: 140px; height: 140px; font-size: 3rem;">
                        @initials.ToUpper()
                    </div>
                }
            </div>

            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <div class="text-muted mb-2">@Model.DesignationTitle</div>
            <div class="mb-3">
                @switch (Model.Status)
                {
                    case EmployeeStatus.Active:
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 fs-6">Active</span>
                        break;
                    case EmployeeStatus.OnNotice:
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 fs-6">On Notice</span>
                        break;
                    case EmployeeStatus.Resigned:
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 fs-6">Resigned</span>
                        break;
                    case EmployeeStatus.Terminated:
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 fs-6">Terminated</span>
                        break;
                }
            </div>

            @if (canManage)
            {
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#uploadPhotoModal">
                        <i class="bi bi-camera me-1"></i> @(string.IsNullOrWhiteSpace(Model.PhotoKey) ? "Upload Photo" : "Change Photo")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(Model.PhotoKey))
                    {
                        <form asp-action="RemovePhoto" asp-route-id="@Model.EmployeeId" method="post" class="d-inline" data-confirm="Are you sure you want to remove this profile photo?" data-confirm-title="Remove Profile Photo" data-confirm-btn="Remove Photo">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    }
                </div>
            }

            <hr class="my-4" />

            <div class="text-start">
                <div class="mb-2">
                    <small class="text-muted d-block">Department</small>
                    <span class="fw-semibold">@Model.DepartmentName</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">Grade Level & Code</small>
                    <span class="fw-semibold">@Model.GradeLevel (@Model.GradeCode)</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">Base Salary</small>
                    <span class="fw-bold text-success font-monospace">@Model.Salary.ToString("C2")</span>
                </div>
                <div>
                    <small class="text-muted d-block">Employment Type</small>
                    <span class="badge bg-light text-secondary border">@Model.EmploymentType</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Details & Information -->
    <div class="col-lg-8">
        <!-- Personal & Identity Details -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Personal & Identity Information</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Date of Birth</small>
                        <span class="fw-medium">@(Model.DateOfBirth?.ToString("dd MMMM yyyy") ?? "Not recorded")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Gender</small>
                        <span class="fw-medium">@(Model.Gender ?? "Not recorded")</span>
                    </div>
                    @if (canViewNid)
                    {
                        <div class="col-sm-6">
                            <small class="text-muted d-block"><i class="bi bi-shield-lock me-1 text-warning"></i>National ID (Decrypted)</small>
                            <span class="fw-bold font-monospace text-dark">@(Model.NidNumber ?? "Not provided")</span>
                        </div>
                    }
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Join Date</small>
                        <span class="fw-medium">@Model.JoinDate.ToString("dd MMMM yyyy")</span>
                    </div>
                    @if (Model.ExitDate.HasValue)
                    {
                        <div class="col-sm-6">
                            <small class="text-muted d-block text-danger">Exit Date</small>
                            <span class="fw-bold text-danger">@Model.ExitDate.Value.ToString("dd MMMM yyyy")</span>
                        </div>
                    }
                    <div class="col-12">
                        <small class="text-muted d-block">Residential Address</small>
                        <span class="fw-medium">@(string.IsNullOrWhiteSpace(Model.Address) ? "No address specified" : Model.Address)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact & Emergency Details -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-telephone-inbound me-2"></i>Contact Details</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Work Email</small>
                        <span class="fw-medium">@(Model.Email ?? "No email provided")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Phone Number</small>
                        <span class="fw-medium">@(Model.Phone ?? "No phone provided")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Emergency Contact Person</small>
                        <span class="fw-medium">@(Model.EmergencyContactName ?? "Not specified")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Emergency Contact Phone</small>
                        <span class="fw-medium">@(Model.EmergencyContactPhone ?? "Not specified")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bank Details Section -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-bank me-2"></i>Bank Details</h6>
                    @if (pendingBank != null)
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                            <i class="bi bi-hourglass-split me-1"></i>Pending Review
                        </span>
                    }
                    else if (activeBank != null)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <i class="bi bi-check-circle me-1"></i>Approved & Active
                        </span>
                    }
                </div>
                @if (pendingBank != null && canManage)
                {
                    <a asp-controller="BankApprovals" asp-action="Index" class="btn btn-sm btn-outline-warning">
                        <i class="bi bi-clipboard-check me-1"></i>Go to Approvals
                    </a>
                }
            </div>
            <div class="card-body p-4">
                @if (pendingBank != null && canManage)
                {
                    <div class="alert alert-warning border-0 bg-warning-subtle p-3 mb-4 rounded-3">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <div class="fw-bold text-dark"><i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>Pending Bank Details Submission</div>
                                <div class="small text-muted">Submitted on @pendingBank.CreatedAtUtc.ToString("dd MMM yyyy, hh:mm tt")</div>
                            </div>
                            <div class="d-flex gap-2">
                                <form asp-controller="BankApprovals" asp-action="Approve" method="post" class="d-inline" data-confirm="Are you sure you want to approve bank details for <strong>@Model.FullName</strong>?" data-confirm-title="Approve Bank Details" data-confirm-btn="Approve Details">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pendingBank.EmployeeBankDetailId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn btn-sm btn-success px-3">
                                        <i class="bi bi-check-lg me-1"></i> Approve
                                    </button>
                                </form>
                                <form asp-controller="BankApprovals" asp-action="Reject" method="post" class="d-inline" data-confirm="Are you sure you want to reject bank details for <strong>@Model.FullName</strong>?" data-confirm-title="Reject Bank Details" data-confirm-btn="Reject Details">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@pendingBank.EmployeeBankDetailId" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <input type="hidden" name="reviewRemarks" value="Rejected from Employee Details" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger px-3">
                                        <i class="bi bi-x-lg me-1"></i> Reject
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }

                @if (activeBank == null && pendingBank == null)
                {
                    <div class="text-muted mb-0">No bank details on file for this employee.</div>
                }
                else
                {
                    var displayBank = activeBank ?? pendingBank;
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Bank Name</small>
                            <span class="fw-semibold">@displayBank!.BankName</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Account Holder Name</small>
                            <span class="fw-semibold">@displayBank.AccountHolderName</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Account Number</small>
                            <span class="fw-bold font-monospace text-primary fs-6">@displayBank.AccountNumber</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Branch Name</small>
                            <span class="fw-medium">@displayBank.BranchName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(displayBank.RoutingNumber))
                        {
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Routing Number</small>
                                <span class="fw-medium font-monospace">@displayBank.RoutingNumber</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(displayBank.SwiftCode))
                        {
                            <div class="col-sm-6">
                                <small class="text-muted d-block">SWIFT Code</small>
                                <span class="fw-medium font-monospace">@displayBank.SwiftCode</span>
                            </div>
                        }
                    </div>

                    @if (pendingBank != null && activeBank != null)
                    {
                        <div class="border-top pt-3 mt-3">
                            <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.75rem;">Pending Update Submitted</small>
                            <div class="small text-muted">
                                <strong>@pendingBank.BankName</strong> &bull; A/C: @pendingBank.AccountNumber &bull; Branch: @pendingBank.BranchName (Awaiting Approval)
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Metadata Information -->
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-3 text-muted small d-flex justify-content-between">
                <span>Record Created: @Model.CreatedAtUtc.ToString("dd MMM yyyy, hh:mm tt UTC")</span>
                @if (Model.UpdatedAtUtc.HasValue)
                {
                    <span>Last Updated: @Model.UpdatedAtUtc.Value.ToString("dd MMM yyyy, hh:mm tt UTC")</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Change Status Modal -->
@if (canManage)
{
    <div class="modal fade" id="changeStatusModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <form asp-action="ChangeStatus" method="post">
                    <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />
                    <input type="hidden" name="RowVersion" value="@rowVersionBase64" />
                    <div class="modal-header border-bottom">
                        <h5 class="modal-title fw-bold">Change Status - @Model.EmployeeCode</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">New Status <span class="text-danger">*</span></label>
                            <select name="NewStatus" id="statusSelect" class="form-select">
                                @foreach (var status in Enum.GetValues<EmployeeStatus>())
                                {
                                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3" id="exitDateContainer" style="display: @(Model.Status is EmployeeStatus.Resigned or EmployeeStatus.Terminated ? "block" : "none");">
                            <label class="form-label fw-semibold">Exit Date <span class="text-danger">*</span></label>
                            <input type="date" name="ExitDate" id="exitDateInput" value="@(Model.ExitDate?.ToString("yyyy-MM-dd"))" min="@Model.JoinDate.ToString("yyyy-MM-dd")" class="form-control" />
                            <small class="text-muted">Required when Resigned or Terminated. Cannot be earlier than Join Date (@Model.JoinDate.ToString("dd MMM yyyy")).</small>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">Update Status</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Upload Photo Modal -->
    <div class="modal fade" id="uploadPhotoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow" style="border-radius: 12px;">
                <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />
                    <div class="modal-header border-bottom">
                        <h5 class="modal-title fw-bold">Upload Profile Photo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Choose Photo File <span class="text-danger">*</span></label>
                            <input type="file" name="Photo" class="form-control" accept=".jpg,.jpeg,.png" required />
                            <small class="text-muted d-block mt-2">
                                Allowed formats: <strong>.jpg, .jpeg, .png</strong>.<br />
                                Maximum file size: <strong>1 MB</strong>.
                            </small>
                        </div>
                    </div>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4">Upload</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- Delete Employee Confirmation Modal -->
    <div class="modal fade" id="deleteEmployeeModal" tabindex="-1" aria-labelledby="deleteEmployeeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                <form asp-action="Delete" asp-route-id="@Model.EmployeeId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-header border-bottom py-3">
                        <h5 class="modal-title fw-bold text-danger" id="deleteEmployeeModalLabel">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Employee Record
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="alert alert-danger bg-danger-subtle border-0 mb-3 rounded-3 small">
                            <i class="bi bi-shield-exclamation me-1"></i>
                            <strong>Warning:</strong> You are about to remove <strong>@Model.FullName</strong> (@Model.EmployeeCode).
                        </div>
                        <p class="text-muted small mb-0">
                            Are you sure you want to delete this employee? If there are compliance, payroll, attendance, or audit histories, the record will be safely archived and marked as Terminated.
                        </p>
                    </div>
                    <div class="modal-footer border-top py-2">
                        <button type="button" class="btn btn-secondary-modern" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger fw-semibold px-4">
                            <i class="bi bi-trash me-1"></i> Confirm Delete
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const statusSelect = document.getElementById('statusSelect');
            const exitDateContainer = document.getElementById('exitDateContainer');
            const exitDateInput = document.getElementById('exitDateInput');

            if (statusSelect && exitDateContainer) {
                statusSelect.addEventListener('change', function () {
                    const val = this.value;
                    if (val === 'Resigned' || val === 'Terminated') {
                        exitDateContainer.style.display = 'block';
                        if (exitDateInput && !exitDateInput.value) {
                            exitDateInput.value = new Date().toISOString().split('T')[0];
                        }
                    } else {
                        exitDateContainer.style.display = 'none';
                        if (exitDateInput) exitDateInput.value = '';
                    }
                });
            }
        });
    </script>
}
