@{
    ViewData["Title"] = "Profile Not Linked";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm p-5" style="border-radius: 16px;">
            <div class="mb-4 text-warning">
                <i class="bi bi-person-exclamation" style="font-size: 4rem;"></i>
            </div>
            <h4 class="fw-bold mb-2">No Employee Record Linked</h4>
            <p class="text-muted mb-4">
                Your login account is not currently linked to an active employee profile in the system.<br />
                Please contact your HR department or system administrator to link your account.
            </p>
            <div>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary px-4">
                    <i class="bi bi-house me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
