@model EmployeeDetailsDto
@{
    ViewData["Title"] = "My Profile";
    var initials = (Model.FirstName.Length > 0 ? Model.FirstName[..1] : "") + (Model.LastName.Length > 0 ? Model.LastName[..1] : "");
    var bankProfile = ViewBag.BankProfile as EmployeeBankProfileDto;
    var activeBank = bankProfile?.ActiveBankDetail;
    var pendingBank = bankProfile?.PendingRequest;
    var rejectedBank = bankProfile?.LastRejectedRequest;
    var currentForEdit = pendingBank ?? activeBank;
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-person-circle me-2 text-primary"></i>My Profile</h4>
        <p class="text-muted small mb-0">Your employee records and company profile</p>
    </div>
    <span class="badge bg-light text-primary border font-monospace fs-6 px-3 py-2">@Model.EmployeeCode</span>
</div>

<div class="row g-4">
    <!-- Left Column: Profile Card -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm text-center p-4 mb-4" style="border-radius: 12px;">
            <div class="position-relative d-inline-block mx-auto mb-3">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoKey))
                {
                    <img src="/uploads/@Model.PhotoKey" alt="@Model.FullName" class="rounded-circle border shadow-sm" style="width: 140px; height: 140px; object-fit: cover;" />
                }
                else
                {
                    <div class="rounded-circle bg-primary-subtle text-primary border border-primary-subtle d-flex align-items-center justify-content-center fw-bold shadow-sm mx-auto" style="width: 140px; height: 140px; font-size: 3rem;">
                        @initials.ToUpper()
                    </div>
                }
            </div>

            <h5 class="fw-bold mb-1">@Model.FullName</h5>
            <div class="text-muted mb-2">@Model.DesignationTitle</div>
            <div class="mb-3">
                @switch (Model.Status)
                {
                    case EmployeeStatus.Active:
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 fs-6">Active</span>
                        break;
                    case EmployeeStatus.OnNotice:
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 fs-6">On Notice</span>
                        break;
                    case EmployeeStatus.Resigned:
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1 fs-6">Resigned</span>
                        break;
                    case EmployeeStatus.Terminated:
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 fs-6">Terminated</span>
                        break;
                }
            </div>

            <div class="d-flex justify-content-center gap-2 mt-2">
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#uploadPhotoModal">
                    <i class="bi bi-camera me-1"></i> @(string.IsNullOrWhiteSpace(Model.PhotoKey) ? "Upload Photo" : "Change Photo")
                </button>
                @if (!string.IsNullOrWhiteSpace(Model.PhotoKey))
                {
                    <form asp-action="RemovePhoto" asp-route-id="@Model.EmployeeId" method="post" class="d-inline" onsubmit="return confirm('Remove profile photo?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Photo">
                            <i class="bi bi-trash"></i>
                        </button>
                    </form>
                }
            </div>

            <hr class="my-4" />

            <div class="text-start">
                <div class="mb-2">
                    <small class="text-muted d-block">Department</small>
                    <span class="fw-semibold">@Model.DepartmentName</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">Grade Level & Code</small>
                    <span class="fw-semibold">@Model.GradeLevel (@Model.GradeCode)</span>
                </div>
                <div class="mb-2">
                    <small class="text-muted d-block">Base Salary</small>
                    <span class="fw-bold text-success font-monospace">@Model.Salary.ToString("C2")</span>
                </div>
                <div>
                    <small class="text-muted d-block">Employment Type</small>
                    <span class="badge bg-light text-secondary border">@Model.EmploymentType</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Details & Information -->
    <div class="col-lg-8">
        <!-- Personal Information -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-person-lines-fill me-2"></i>Personal Information</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Date of Birth</small>
                        <span class="fw-medium">@(Model.DateOfBirth?.ToString("dd MMMM yyyy") ?? "Not recorded")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Gender</small>
                        <span class="fw-medium">@(Model.Gender ?? "Not recorded")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Join Date</small>
                        <span class="fw-medium">@Model.JoinDate.ToString("dd MMMM yyyy")</span>
                    </div>
                    @if (Model.ExitDate.HasValue)
                    {
                        <div class="col-sm-6">
                            <small class="text-muted d-block text-danger">Exit Date</small>
                            <span class="fw-bold text-danger">@Model.ExitDate.Value.ToString("dd MMMM yyyy")</span>
                        </div>
                    }
                    <div class="col-12">
                        <small class="text-muted d-block">Residential Address</small>
                        <span class="fw-medium">@(string.IsNullOrWhiteSpace(Model.Address) ? "No address specified" : Model.Address)</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Information -->
        <div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-telephone-inbound me-2"></i>Contact & Emergency Details</h6>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Work Email</small>
                        <span class="fw-medium">@(Model.Email ?? "No email provided")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Phone Number</small>
                        <span class="fw-medium">@(Model.Phone ?? "No phone provided")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Emergency Contact Person</small>
                        <span class="fw-medium">@(Model.EmergencyContactName ?? "Not specified")</span>
                    </div>
                    <div class="col-sm-6">
                        <small class="text-muted d-block">Emergency Contact Phone</small>
                        <span class="fw-medium">@(Model.EmergencyContactPhone ?? "Not specified")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bank Details Section -->
        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <h6 class="fw-bold mb-0 text-primary"><i class="bi bi-bank me-2"></i>Bank Details</h6>
                    @if (pendingBank != null)
                    {
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                            <i class="bi bi-hourglass-split me-1"></i>Pending Approval
                        </span>
                    }
                    else if (activeBank != null)
                    {
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                            <i class="bi bi-check-circle me-1"></i>Approved
                        </span>
                    }
                </div>
                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editBankModal">
                    <i class="bi bi-pencil me-1"></i> @(activeBank == null && pendingBank == null ? "Add Bank Details" : "Edit Bank Details")
                </button>
            </div>
            <div class="card-body p-4">
                @if (pendingBank != null)
                {
                    <div class="alert alert-warning border-0 bg-warning-subtle p-3 mb-4 rounded-3 d-flex align-items-start gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-warning fs-5 flex-shrink-0 mt-1"></i>
                        <div>
                            <div class="fw-bold text-dark">Bank Details Request Pending Approval</div>
                            <div class="small text-muted">
                                You submitted updated bank details on <strong>@pendingBank.CreatedAtUtc.ToString("dd MMM yyyy, hh:mm tt")</strong>.
                                An Admin or HR administrator must review and approve this submission before it becomes active.
                            </div>
                        </div>
                    </div>
                }

                @if (activeBank == null && pendingBank == null)
                {
                    <div class="text-muted mb-4">No bank details on file.</div>

                    <div class="alert alert-danger bg-danger-subtle border-0 p-3 rounded-3">
                        <div class="d-flex align-items-center gap-2 text-danger fw-bold mb-1">
                            <i class="bi bi-exclamation-diamond-fill"></i> Payroll Warning
                        </div>
                        <ul class="mb-0 small text-danger ps-3">
                            <li>Missing bank details: Salary disbursement cannot be processed without an approved bank account.</li>
                        </ul>
                    </div>
                }
                else
                {
                    var displayBank = pendingBank ?? activeBank;
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Bank Name</small>
                            <span class="fw-semibold">@displayBank!.BankName</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Account Holder Name</small>
                            <span class="fw-semibold">@displayBank.AccountHolderName</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Account Number</small>
                            <span class="fw-bold font-monospace text-primary fs-6">@displayBank.AccountNumber</span>
                        </div>
                        <div class="col-sm-6">
                            <small class="text-muted d-block">Branch Name</small>
                            <span class="fw-medium">@displayBank.BranchName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(displayBank.RoutingNumber))
                        {
                            <div class="col-sm-6">
                                <small class="text-muted d-block">Routing Number</small>
                                <span class="fw-medium font-monospace">@displayBank.RoutingNumber</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(displayBank.SwiftCode))
                        {
                            <div class="col-sm-6">
                                <small class="text-muted d-block">SWIFT Code</small>
                                <span class="fw-medium font-monospace">@displayBank.SwiftCode</span>
                            </div>
                        }
                    </div>

                    @if (pendingBank != null && activeBank != null)
                    {
                        <div class="border-top pt-3 mt-4">
                            <small class="text-muted d-block mb-1 fw-bold text-uppercase" style="font-size: 0.75rem;">Currently Active Bank Details</small>
                            <div class="small text-muted">
                                <strong>@activeBank.BankName</strong> &bull; A/C: @activeBank.AccountNumber &bull; Branch: @activeBank.BranchName
                            </div>
                        </div>
                    }
                }

                @if (rejectedBank != null && pendingBank == null)
                {
                    <div class="alert alert-danger bg-danger-subtle border-0 p-3 mt-3 rounded-3">
                        <div class="fw-bold text-danger mb-1"><i class="bi bi-x-circle me-1"></i>Previous Submission Rejected</div>
                        <div class="small text-danger">
                            Your previous bank details submission was rejected by Admin/HR.
                            @if (!string.IsNullOrWhiteSpace(rejectedBank.ReviewRemarks))
                            {
                                <span><strong>Reason:</strong> @rejectedBank.ReviewRemarks</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Submit / Edit Bank Details Modal -->
<div class="modal fade" id="editBankModal" tabindex="-1" aria-labelledby="editBankModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 12px;">
            <form asp-area="Employees" asp-controller="BankDetails" asp-action="Submit" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold" id="editBankModalLabel">
                        <i class="bi bi-bank me-2 text-primary"></i>@(activeBank == null && pendingBank == null ? "Add Bank Details" : "Edit Bank Details")
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="alert alert-info bg-info-subtle border-0 small mb-3 rounded-3">
                        <i class="bi bi-info-circle me-1"></i> <strong>Note:</strong> Bank account submissions and edits require verification and approval by HR or Admin before becoming active.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Bank Name <span class="text-danger">*</span></label>
                        <input type="text" name="BankName" class="form-control" placeholder="e.g. Dutch-Bangla Bank PLC" value="@(currentForEdit?.BankName)" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Holder Name <span class="text-danger">*</span></label>
                        <input type="text" name="AccountHolderName" class="form-control" placeholder="e.g. @Model.FullName" value="@(currentForEdit?.AccountHolderName ?? Model.FullName)" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Account Number <span class="text-danger">*</span></label>
                        <input type="text" name="AccountNumber" class="form-control font-monospace" placeholder="e.g. 115.120.987654" value="@(currentForEdit?.AccountNumber)" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Branch Name <span class="text-danger">*</span></label>
                        <input type="text" name="BranchName" class="form-control" placeholder="e.g. Dhanmondi Branch" value="@(currentForEdit?.BranchName)" required maxlength="100" />
                    </div>
                    <div class="row g-2">
                        <div class="col-sm-6 mb-3">
                            <label class="form-label fw-semibold small">Routing Number <span class="text-muted">(Optional)</span></label>
                            <input type="text" name="RoutingNumber" class="form-control font-monospace" placeholder="e.g. 090271234" value="@(currentForEdit?.RoutingNumber)" maxlength="50" />
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label class="form-label fw-semibold small">SWIFT Code <span class="text-muted">(Optional)</span></label>
                            <input type="text" name="SwiftCode" class="form-control font-monospace" placeholder="e.g. DBBLBDDH" value="@(currentForEdit?.SwiftCode)" maxlength="50" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-send me-1"></i> Submit for Approval
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Upload Profile Photo Modal -->
<div class="modal fade" id="uploadPhotoModal" tabindex="-1" aria-labelledby="uploadPhotoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow" style="border-radius: 12px;">
            <form asp-action="UploadPhoto" method="post" enctype="multipart/form-data">
                <input type="hidden" name="EmployeeId" value="@Model.EmployeeId" />
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold" id="uploadPhotoModalLabel">
                        <i class="bi bi-camera me-2 text-primary"></i>Profile Photo
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Upload a JPG, JPEG, or PNG profile picture (maximum 1 MB).</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Photo File</label>
                        <input type="file" name="Photo" class="form-control" accept=".jpg,.jpeg,.png" required />
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload me-1"></i> Upload Photo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
