@model IReadOnlyList<DesignationDto>
@{
    ViewData["Title"] = "Designations";
    var departments = ViewBag.Departments as List<SelectListItem> ?? new List<SelectListItem>();
    var selectedDept = ViewBag.SelectedDepartmentId as Guid?;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-person-badge me-2 text-primary"></i>Designations</h4>
        <p class="text-muted small mb-0">Manage job titles and department roles</p>
    </div>
    <a asp-action="Create" asp-route-departmentId="@selectedDept" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Add Designation
    </a>
</div>

<div class="card border-0 shadow-sm mb-4" style="border-radius: 12px;">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Filter by Department</label>
                <select name="departmentId" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="">-- All Departments --</option>
                    @foreach (var dept in departments)
                    {
                        <option value="@dept.Value" selected="@dept.Selected">@dept.Text</option>
                    }
                </select>
            </div>
            @if (selectedDept.HasValue)
            {
                <div class="col-md-2 mt-4">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Clear Filter</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Designation Title</th>
                        <th>Department</th>
                        <th>Grades</th>
                        <th>Employees</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-award fs-1 d-block mb-2"></i>
                                No designations found.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                <i class="bi bi-briefcase me-2 text-muted"></i>@item.Title
                            </td>
                            <td>
                                <span class="badge bg-light text-primary border">@item.DepartmentName</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-sort-numeric-up me-1 text-primary"></i>@item.GradeCount
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-people me-1 text-primary"></i>@item.EmployeeCount
                                </span>
                            </td>
                            <td>
                                @if (item.Status == EntityStatus.Active)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactive</span>
                                }
                            </td>
                            <td class="text-muted small">@item.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        @if (item.Status == EntityStatus.Active)
                                        {
                                            <input type="hidden" name="status" value="@EntityStatus.Inactive" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Deactivate" onclick="return confirm('Deactivate designation \'@item.Title\'?');">
                                                <i class="bi bi-slash-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="status" value="@EntityStatus.Active" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Activate">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
