@model IReadOnlyList<DepartmentDto>
@{
    ViewData["Title"] = "Departments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-building me-2 text-primary"></i>Departments</h4>
        <p class="text-muted small mb-0">Manage organization departments and organizational structure</p>
    </div>
    <a asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-lg"></i> Add Department
    </a>
</div>

<div class="card border-0 shadow-sm" style="border-radius: 12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Department Name</th>
                        <th>Designations</th>
                        <th>Employees</th>
                        <th>Status</th>
                        <th>Created Date</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-folder-x fs-1 d-block mb-2"></i>
                                No departments found. Click "Add Department" to create one.
                            </td>
                        </tr>
                    }
                    @foreach (var dept in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-dark">
                                <i class="bi bi-diagram-3 me-2 text-muted"></i>@dept.Name
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-award me-1 text-primary"></i>@dept.DesignationCount
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-people me-1 text-primary"></i>@dept.EmployeeCount
                                </span>
                            </td>
                            <td>
                                @if (dept.Status == EntityStatus.Active)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">Inactive</span>
                                }
                            </td>
                            <td class="text-muted small">@dept.CreatedAtUtc.ToString("dd MMM yyyy")</td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-sm btn-outline-secondary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="ToggleStatus" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@dept.Id" />
                                        @if (dept.Status == EntityStatus.Active)
                                        {
                                            <input type="hidden" name="status" value="@EntityStatus.Inactive" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning" title="Deactivate" onclick="return confirm('Deactivate department \'@dept.Name\'?');">
                                                <i class="bi bi-slash-circle"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <input type="hidden" name="status" value="@EntityStatus.Active" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Activate">
                                                <i class="bi bi-check-circle"></i>
                                            </button>
                                        }
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
