@model GradeFormViewModel
@{
    ViewData["Title"] = "Add Grade";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold mb-0">Add Grade</h4>
                <p class="text-muted small mb-0">Define grade level, code and salary for designation</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius: 12px;">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="DesignationId" class="form-label fw-semibold">Designation <span class="text-danger">*</span></label>
                        <select asp-for="DesignationId" asp-items="Model.DesignationOptions" class="form-select">
                            <option value="">-- Select Designation --</option>
                        </select>
                        <span asp-validation-for="DesignationId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Level" class="form-label fw-semibold">Level <span class="text-danger">*</span></label>
                        <input asp-for="Level" class="form-control" placeholder="e.g. Junior, Mid, Senior, Lead" autofocus />
                        <span asp-validation-for="Level" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Code" class="form-label fw-semibold">Grade Code <span class="text-danger">*</span></label>
                        <input asp-for="Code" class="form-control" placeholder="e.g. L-1, L-2, G-101" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Salary" class="form-label fw-semibold">Base Salary <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Salary" type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Salary" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-light px-4">Cancel</a>
                        <button type="submit" class="btn btn-primary px-4">
                            <i class="bi bi-check-lg me-1"></i> Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
