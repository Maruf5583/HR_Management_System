@model List<BankDetailDto>
@{
    ViewData["Title"] = "Bank Details Approvals";
    ViewData["Subtitle"] = "Review and verify employee bank account submissions and changes for payroll processing";
    var distinctBanks = Model.Select(b => b.BankName).Where(b => !string.IsNullOrEmpty(b)).Distinct().OrderBy(b => b).ToList();
}


<!-- EmplowHR-Inspired Unified Filter Bar -->
<div class="table-filter-bar">
    <!-- Instant Search Input -->
    <div class="table-search-box">
        <i class="bi bi-search search-icon"></i>
        <input type="text" id="bankSearchInput" class="table-search-input" placeholder="Search by employee, code, bank or account number..." oninput="filterBankApprovalsTable()" />
    </div>

    <!-- Bank Pill Dropdown -->
    <div class="dropdown">
        <button class="filter-pill-dropdown" id="bankFilterBtn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span id="selectedBankText">All Banks</span>
            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
        </button>
        <div class="dropdown-menu filter-dropdown-menu">
            <div class="filter-dropdown-search">
                <i class="bi bi-search"></i>
                <input type="text" class="filter-dropdown-search-input" placeholder="Search banks..." autocomplete="off" />
            </div>
            <ul class="filter-dropdown-list list-unstyled mb-0">
                <li>
                    <a class="dropdown-item active" href="javascript:void(0)" onclick="setBankFilter('', 'All Banks', this)">
                        <span>All Banks</span>
                        <i class="bi bi-check2"></i>
                    </a>
                </li>
                @foreach (var bank in distinctBanks)
                {
                    <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="setBankFilter('@bank', '@bank', this)">
                            <span>@bank</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Reset Filter Button -->
    <button type="button" class="btn-reset-filters d-none" id="resetFiltersBtn" onclick="resetAllFilters()" title="Reset all filters">
        <i class="bi bi-arrow-counterclockwise"></i>
        <span>Reset</span>
    </button>

    <!-- Total Records Badge -->
    <div class="ms-auto">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-semibold" id="recordsCounter">
            @Model.Count Pending Request@(Model.Count == 1 ? "" : "s")
        </span>
    </div>
</div>

<!-- Main Approvals Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important; overflow: hidden;">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                <h5 class="fw-bold mt-3 mb-1">All Caught Up!</h5>
                <p class="text-muted small mb-0">There are no pending bank detail approval requests right now.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="bankApprovalsTable">
                    <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                        <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                            <th class="ps-4 py-2.5">Employee</th>
                            <th class="py-2.5">Department & Role</th>
                            <th class="py-2.5">Bank & Branch</th>
                            <th class="py-2.5">Account Holder</th>
                            <th class="py-2.5">Account Number</th>
                            <th class="py-2.5">Submitted At</th>
                            <th class="text-end pe-4 py-2.5">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="bank-row" data-search="@item.EmployeeName.ToLowerInvariant() @item.EmployeeCode.ToLowerInvariant() @item.BankName.ToLowerInvariant() @item.AccountNumber.ToLowerInvariant()" data-bank="@item.BankName">
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.82rem;">
                                            @(item.EmployeeName.Length > 0 ? item.EmployeeName.Substring(0, 1).ToUpper() : "E")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">
                                                <a asp-area="Employees" asp-controller="Employees" asp-action="Details" asp-route-id="@item.EmployeeId" class="text-decoration-none text-dark hover-primary">
                                                    @item.EmployeeName
                                                </a>
                                            </div>
                                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.72rem;">@item.EmployeeCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@item.DepartmentName</div>
                                    <small class="text-muted">@item.DesignationTitle</small>
                                </td>
                                <td>
                                    <div class="fw-semibold text-primary">@item.BankName</div>
                                    <small class="text-muted">@item.BranchName</small>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@item.AccountHolderName</div>
                                    @if (!string.IsNullOrWhiteSpace(item.RoutingNumber))
                                    {
                                        <small class="text-muted small d-block">Routing: @item.RoutingNumber</small>
                                    }
                                </td>
                                <td>
                                    <span class="font-monospace fw-bold text-dark fs-6">@item.AccountNumber</span>
                                    @if (!string.IsNullOrWhiteSpace(item.SwiftCode))
                                    {
                                        <div class="small text-muted small">SWIFT: @item.SwiftCode</div>
                                    }
                                </td>
                                <td>
                                    <div class="small fw-medium text-dark">@item.CreatedAtUtc.ToString("dd MMM yyyy")</div>
                                    <small class="text-muted">@item.CreatedAtUtc.ToString("hh:mm tt")</small>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <form asp-action="Approve" method="post" class="d-inline" data-confirm="Are you sure you want to approve bank details for <strong>'@item.EmployeeName'</strong>?" data-confirm-title="Approve Bank Details" data-confirm-btn="Approve Details">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.EmployeeBankDetailId" />
                                            <button type="submit" class="btn btn-sm btn-success px-3 fw-semibold shadow-xs">
                                                <i class="bi bi-check-lg me-1"></i> Approve
                                            </button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-light border text-danger px-3 fw-medium" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.EmployeeBankDetailId">
                                            <i class="bi bi-x-lg me-1"></i> Reject
                                        </button>
                                    </div>

                                    <!-- Reject Modal -->
                                    <div class="modal fade" id="rejectModal-@item.EmployeeBankDetailId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered text-start">
                                            <div class="modal-content border-0 shadow-lg" style="border-radius: 14px;">
                                                <form asp-action="Reject" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.EmployeeBankDetailId" />
                                                    <div class="modal-header border-bottom py-3">
                                                        <h5 class="modal-title fw-bold text-danger">
                                                            <i class="bi bi-exclamation-triangle-fill me-2"></i>Reject Bank Details Submission
                                                        </h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <p class="text-muted small mb-3">
                                                            Rejecting the submission for <strong>@item.EmployeeName</strong>. Please provide a clear explanation for the employee.
                                                        </p>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold small">Reason for Rejection <span class="text-danger">*</span></label>
                                                            <textarea name="remarks" class="form-control" rows="3" placeholder="e.g. Invalid account number format or name mismatch with NID." required></textarea>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-top py-2">
                                                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="bi bi-x-circle me-1"></i> Confirm Rejection
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                        <tr id="noResultsRow" class="d-none">
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-search fs-2 d-block mb-2 text-muted"></i>
                                No pending requests match your current search and filter criteria.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <!-- Clean Table Footer with Count -->
            <div class="d-flex justify-content-between align-items-center px-4 py-2.5 bg-white border-top text-muted small" style="border-color: #eaecf0 !important;">
                <span>Showing <strong class="text-dark tabular-nums" id="visibleCounter">@Model.Count</strong> of <strong class="text-dark tabular-nums">@Model.Count</strong> pending requests</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        let currentBankFilter = '';

        function setBankFilter(bankName, displayText, element) {
            currentBankFilter = bankName.toLowerCase();
            document.getElementById('selectedBankText').textContent = displayText;
            document.querySelectorAll('#bankFilterBtn + .dropdown-menu .dropdown-item').forEach(el => {
                el.classList.remove('active');
                const check = el.querySelector('.bi-check2');
                if (check) check.remove();
            });
            element.classList.add('active');
            if (!element.querySelector('.bi-check2')) {
                const icon = document.createElement('i');
                icon.className = 'bi bi-check2';
                element.appendChild(icon);
            }
            filterBankApprovalsTable();
        }

        function filterBankApprovalsTable() {
            const searchInput = document.getElementById('bankSearchInput');
            const query = searchInput ? searchInput.value.trim().toLowerCase() : '';
            const rows = document.querySelectorAll('.bank-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                const bank = (row.getAttribute('data-bank') || '').toLowerCase();

                const matchesSearch = !query || searchData.includes(query);
                const matchesBank = !currentBankFilter || bank === currentBankFilter;

                if (matchesSearch && matchesBank) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const resetBtn = document.getElementById('resetFiltersBtn');
            if (resetBtn) {
                if (query || currentBankFilter) {
                    resetBtn.classList.remove('d-none');
                } else {
                    resetBtn.classList.add('d-none');
                }
            }

            const counter = document.getElementById('recordsCounter');
            if (counter) {
                counter.innerHTML = `<strong>${visibleCount}</strong> pending requests`;
            }

            const noResults = document.getElementById('noResultsRow');
            if (noResults) {
                if (visibleCount === 0 && rows.length > 0) {
                    noResults.classList.remove('d-none');
                } else {
                    noResults.classList.add('d-none');
                }
            }
        }

        function resetAllFilters() {
            const searchInput = document.getElementById('bankSearchInput');
            if (searchInput) searchInput.value = '';

            const firstBankItem = document.querySelector('#bankFilterBtn + .dropdown-menu .dropdown-item');
            if (firstBankItem) setBankFilter('', 'All Banks', firstBankItem);

            filterBankApprovalsTable();
        }
    </script>
}
