@{
    ViewData["Title"] = "No Employee Profile";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card-modern p-5 text-center">
            <div class="proto-stat-icon-box proto-icon-orange mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.5rem;">
                <i class="bi bi-person-x-fill"></i>
            </div>
            <h4 class="fw-bold text-dark mb-1">No Linked Employee Record</h4>
            <p class="text-muted small mb-4">
                Your user account (<strong class="text-dark">@CurrentUser.Email</strong>) is not linked to an employee profile. Equipment allocation is only available for employees with an active profile.
            </p>
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary-modern">
                <i class="bi bi-arrow-left"></i> Return to Dashboard
            </a>
        </div>
    </div>
</div>
