@model IReadOnlyList<MyAssetDto>
@{
    ViewData["Title"] = "My Assets";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h4 class="fw-bold text-dark mb-1">My Allocated Equipment</h4>
        <p class="text-muted small mb-0">Hardware, devices, and company assets assigned to your custody.</p>
    </div>
</div>

<div class="row g-4">
    @if (Model.Count == 0)
    {
        <div class="col-12">
            <div class="card-modern p-5 text-center text-muted">
                <i class="bi bi-laptop fs-1 text-slate-400 d-block mb-3"></i>
                <h5 class="fw-bold text-dark mb-1">No Assets Allocated</h5>
                <p class="small text-muted mb-0">You currently do not have any company hardware or devices checked out to your profile.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var asset in Model)
        {
            var categoryIcon = asset.Category switch
            {
                AssetCategory.Laptop => "bi-laptop",
                AssetCategory.Monitor => "bi-display",
                AssetCategory.Phone => "bi-phone",
                AssetCategory.SIM => "bi-sim",
                AssetCategory.IDCard => "bi-person-badge",
                _ => "bi-box-seam"
            };

            var conditionBadgeClass = asset.Condition switch
            {
                AssetCondition.New => "badge-soft-success",
                AssetCondition.Good => "badge-soft-primary",
                AssetCondition.Fair => "badge-soft-warning",
                AssetCondition.Damaged => "badge-soft-danger",
                _ => "badge-soft-secondary"
            };

            <div class="col-md-6 col-xl-4">
                <div class="card-modern h-100 p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="proto-stat-icon-box proto-icon-purple">
                                <i class="bi @categoryIcon"></i>
                            </span>
                            <span class="badge @conditionBadgeClass">@asset.Condition</span>
                        </div>

                        <div class="font-monospace fw-bold text-primary small mb-1">@asset.AssetTag</div>
                        <h5 class="fw-bold text-dark mb-1">@asset.Name</h5>
                        <div class="text-muted small mb-3">@asset.Category</div>

                        <dl class="row small mb-0">
                            <dt class="col-5 text-muted">Serial No:</dt>
                            <dd class="col-7 font-monospace text-dark">@(asset.SerialNumber ?? "—")</dd>

                            <dt class="col-5 text-muted">Issued Date:</dt>
                            <dd class="col-7 text-dark">@asset.AssignedAtUtc.ToString("dd MMM yyyy")</dd>

                            @if (!string.IsNullOrWhiteSpace(asset.Note))
                            {
                                <dt class="col-5 text-muted">Note:</dt>
                                <dd class="col-7 text-dark">@asset.Note</dd>
                            }
                        </dl>
                    </div>

                    <div class="pt-3 mt-3 border-top small text-muted d-flex align-items-center gap-1">
                        <i class="bi bi-shield-check text-success"></i>
                        <span>Under your personal custody</span>
                    </div>
                </div>
            </div>
        }
    }
</div>
