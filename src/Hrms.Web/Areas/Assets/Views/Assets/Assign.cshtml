@model AssignAssetViewModel
@{
    ViewData["Title"] = $"Assign {Model.AssetTag}";
    var employees = ViewBag.Employees as List<SelectListItem> ?? new List<SelectListItem>();
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="d-flex align-items-center gap-2 mb-3">
            <a asp-action="Details" asp-route-id="@Model.AssetId" class="btn btn-sm btn-secondary-modern">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h4 class="fw-bold text-dark mb-0">Assign Equipment to Employee</h4>
                <small class="text-muted">Deploy <strong class="font-monospace">@Model.AssetTag</strong> (@Model.AssetName) to staff custody.</small>
            </div>
        </div>

        <div class="card-modern p-4">
            <form asp-action="Assign" asp-route-id="@Model.AssetId" method="post">
                <input type="hidden" asp-for="AssetId" />
                <input type="hidden" asp-for="AssetTag" />
                <input type="hidden" asp-for="AssetName" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger border-0 small py-2 px-3 mb-3 d-flex align-items-center gap-2" style="border-radius: 8px;">
                        <i class="bi bi-exclamation-circle-fill fs-5"></i>
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <div class="p-3 bg-light rounded-3 border mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-laptop text-primary fs-5"></i>
                        <div>
                            <span class="font-monospace fw-bold text-dark">@Model.AssetTag</span> &bull; @Model.AssetName
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="EmployeeId" class="form-label"></label>
                    <input type="hidden" asp-for="EmployeeId" id="assignEmployeeInput" value="@Model.EmployeeId" />
                    @{
                        var selectedEmployee = Model.EmployeeId != Guid.Empty ? employees.FirstOrDefault(e => e.Value == Model.EmployeeId.ToString()) : null;
                        var initialEmpText = selectedEmployee != null ? selectedEmployee.Text : "-- Select Active Employee --";
                    }
                    <div class="dropdown">
                        <button class="form-select text-start d-flex justify-content-between align-items-center" type="button" id="assignEmployeeDropdownBtn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span id="assignEmployeeLabel">@initialEmpText</span>
                            <i class="bi bi-chevron-down text-muted small"></i>
                        </button>
                        <div class="dropdown-menu filter-dropdown-menu w-100 shadow border-0 p-2" aria-labelledby="assignEmployeeDropdownBtn" style="border-radius: 10px; max-height: 320px;">
                            <div class="filter-dropdown-search mb-2 px-1">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                                    <input type="text" class="form-control filter-dropdown-search-input bg-light border-start-0" placeholder="Type employee name or code..." autocomplete="off" />
                                </div>
                            </div>
                            <ul class="filter-dropdown-list list-unstyled mb-0" style="max-height: 220px; overflow-y: auto;">
                                <li>
                                    <a class="dropdown-item rounded-2 py-2 text-muted" href="javascript:void(0)" onclick="selectFormDropdown('assignEmployeeInput', 'assignEmployeeLabel', '', '-- Select Active Employee --', 'assignEmployeeDropdownBtn')">
                                        <span>-- Select Active Employee --</span>
                                    </a>
                                </li>
                                @foreach (var emp in employees)
                                {
                                    if (!string.IsNullOrEmpty(emp.Value))
                                    {
                                        var isSel = Model.EmployeeId != Guid.Empty && Model.EmployeeId.ToString() == emp.Value;
                                        <li>
                                            <a class="dropdown-item rounded-2 py-2 d-flex align-items-center justify-content-between" href="javascript:void(0)" onclick="selectFormDropdown('assignEmployeeInput', 'assignEmployeeLabel', '@emp.Value', '@emp.Text', 'assignEmployeeDropdownBtn')">
                                                <span>@emp.Text</span>
                                                @if (isSel)
                                                {
                                                    <i class="bi bi-check2 text-primary"></i>
                                                }
                                            </a>
                                        </li>
                                    }
                                }
                            </ul>
                        </div>
                    </div>
                    <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="AssignedAtUtc" class="form-label"></label>
                    <input asp-for="AssignedAtUtc" type="datetime-local" class="form-control" />
                    <span asp-validation-for="AssignedAtUtc" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Note" class="form-label"></label>
                    <textarea asp-for="Note" class="form-control" rows="3" placeholder="Condition upon handover, accessories included (charger, bag, mouse), etc..."></textarea>
                    <span asp-validation-for="Note" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Details" asp-route-id="@Model.AssetId" class="btn btn-secondary-modern">Cancel</a>
                    <button type="submit" class="btn btn-primary-modern">
                        <i class="bi bi-person-check-fill"></i>
                        <span>Confirm Assignment</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
