@model PagedResult<LeaveBalanceItemDto>
@{
    ViewData["Title"] = "Leave Balances";
    int selectedYear = ViewBag.SelectedYear ?? DateTime.UtcNow.Year;
    ViewData["Subtitle"] = $"Overview of entitled, used, and remaining leave days per employee for year {selectedYear}";
    var leaveTypes = ViewBag.LeaveTypes as SelectList;
    var search = ViewBag.Search as string;
    var hasActiveFilters = !string.IsNullOrEmpty(search) || (leaveTypes?.SelectedValue != null) || (ViewBag.SelectedLeaveTypeId != null);
}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3" role="alert" style="border-radius: 12px; background-color: #ecfdf3; color: #027a48;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert" style="border-radius: 12px; background-color: #fef3f2; color: #b42318;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- EmplowHR-Inspired Unified Filter Bar -->
<form method="get" asp-action="Index" id="leaveBalancesFilterForm" class="table-filter-bar mb-3">
    <!-- Search Input -->
    <div class="table-search-box">
        <i class="bi bi-search search-icon"></i>
        <input type="text" name="search" class="table-search-input" value="@search" placeholder="Search employee name or code..." onkeydown="if(event.key==='Enter'){ this.form.submit(); }" />
    </div>

    <!-- Year Input Pill -->
    <div class="d-inline-flex align-items-center bg-white border px-2.5 rounded-3" style="height: 38px; border-color: #d0d5dd !important;">
        <span class="text-secondary small fw-medium me-1">Year:</span>
        <input type="number" name="year" class="border-0 shadow-none text-dark fw-semibold" style="width: 60px; font-size: 0.84rem; outline: none;" value="@selectedYear" min="2020" max="2050" onchange="this.form.submit()" />
    </div>

    <!-- Leave Type Dropdown Pill -->
    <div class="dropdown">
        <button class="filter-pill-dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span>@(leaveTypes?.FirstOrDefault(x => x.Selected)?.Text ?? "All Leave Types")</span>
            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
        </button>
        <div class="dropdown-menu filter-dropdown-menu">
            <div class="filter-dropdown-search">
                <i class="bi bi-search"></i>
                <input type="text" class="filter-dropdown-search-input" placeholder="Search leave type..." autocomplete="off" />
            </div>
            <ul class="filter-dropdown-list list-unstyled mb-0">
                <li>
                    <a class="dropdown-item @(leaveTypes?.SelectedValue == null ? "active" : "")" href="javascript:void(0)" onclick="setLeaveTypeFilter('')">
                        <span>All Leave Types</span>
                        @if (leaveTypes?.SelectedValue == null) { <i class="bi bi-check2"></i> }
                    </a>
                </li>
                @if (leaveTypes != null)
                {
                    foreach (var lt in leaveTypes)
                    {
                        <li>
                            <a class="dropdown-item @(lt.Selected ? "active" : "")" href="javascript:void(0)" onclick="setLeaveTypeFilter('@lt.Value')">
                                <span>@lt.Text</span>
                                @if (lt.Selected) { <i class="bi bi-check2"></i> }
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
        <input type="hidden" name="leaveTypeId" id="hiddenLeaveTypeId" value="@(leaveTypes?.SelectedValue?.ToString() ?? "")" />
    </div>

    <!-- Reset Filter Button -->
    @if (hasActiveFilters)
    {
        <a asp-action="Index" class="btn-reset-filters" title="Reset all filters">
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Reset</span>
        </a>
    }

    <div class="ms-auto">
        @if (CurrentUser.HasPermission(Permissions.Leave.Manage))
        {
            <a asp-action="StartYear" class="btn btn-primary px-3 fw-semibold rounded-3 shadow-xs d-inline-flex align-items-center gap-1.5" style="height: 40px; font-size: 0.875rem; white-space: nowrap;">
                <i class="bi bi-calendar-plus"></i>
                <span>Start new leave year</span>
            </a>
        }
    </div>
</form>

<!-- Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important; overflow: hidden;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                    <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                        <th class="ps-4 py-2.5">Employee</th>
                        <th class="py-2.5">Leave Type</th>
                        <th class="py-2.5 text-center">Year</th>
                        <th class="py-2.5 text-center">Entitled</th>
                        <th class="py-2.5 text-center">Used</th>
                        <th class="pe-4 py-2.5 text-center">Remaining</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                                No leave balances found for year <strong>@selectedYear</strong>.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.82rem;">
                                            @(item.EmployeeName.Length > 0 ? item.EmployeeName.Substring(0, 1).ToUpper() : "E")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@item.EmployeeName</div>
                                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.72rem;">@item.EmployeeCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@item.LeaveTypeName</span>
                                </td>
                                <td class="text-center fw-semibold text-dark">@item.Year</td>
                                <td class="text-center fw-semibold text-secondary">@item.Entitled.ToString("0.#")</td>
                                <td class="text-center fw-semibold text-danger">@item.Used.ToString("0.#")</td>
                                <td class="pe-4 text-center">
                                    <span class="badge @(item.Remaining > 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") fs-6 px-3 py-1 rounded-pill font-monospace">
                                        @item.Remaining.ToString("0.#")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 border-top" style="border-color: #eaecf0 !important;">
                <div class="text-muted small">Showing @Model.Items.Count of @Model.TotalCount balance records</div>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-year="@selectedYear"
                           asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString() ?? ViewBag.SelectedLeaveTypeId?.ToString())"
                           asp-route-search="@search"
                           asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-year="@selectedYear"
                               asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString() ?? ViewBag.SelectedLeaveTypeId?.ToString())"
                               asp-route-search="@search"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-year="@selectedYear"
                           asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString() ?? ViewBag.SelectedLeaveTypeId?.ToString())"
                           asp-route-search="@search"
                           asp-route-page="@(Model.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </div>
        }
        else if (Model != null && Model.Items.Any())
        {
            <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 border-top" style="border-color: #eaecf0 !important;">
                <span class="text-muted small">Showing <strong>@Model.Items.Count</strong> balance records</span>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function setLeaveTypeFilter(id) {
            document.getElementById('hiddenLeaveTypeId').value = id;
            document.getElementById('leaveBalancesFilterForm').submit();
        }
    </script>
}
