@model PagedResult<PendingApprovalItemDto>
@{
    ViewData["Title"] = "Leave Approvals";
    ViewData["Subtitle"] = "Review, approve, or reject employee leave requests and time off";
    var leaveTypes = ViewBag.LeaveTypes as SelectList;
    var search = ViewBag.Search as string;
    var hasActiveFilters = !string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(ViewBag.FromDate) || !string.IsNullOrEmpty(ViewBag.ToDate) || (leaveTypes?.SelectedValue != null);
}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3" role="alert" style="border-radius: 12px; background-color: #ecfdf3; color: #027a48;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert" style="border-radius: 12px; background-color: #fef3f2; color: #b42318;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- EmplowHR-Inspired Unified Filter Bar -->
<form method="get" asp-action="Index" id="leaveApprovalsForm" class="table-filter-bar mb-3">
    <!-- Search Input -->
    <div class="table-search-box">
        <i class="bi bi-search search-icon"></i>
        <input type="text" name="search" class="table-search-input" value="@search" placeholder="Search employee name or code..." onkeydown="if(event.key==='Enter'){ this.form.submit(); }" />
    </div>

    <!-- Leave Type Dropdown Pill -->
    <div class="dropdown">
        <button class="filter-pill-dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span>@(leaveTypes?.FirstOrDefault(x => x.Selected)?.Text ?? "All Leave Types")</span>
            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
        </button>
        <div class="dropdown-menu filter-dropdown-menu">
            <div class="filter-dropdown-search">
                <i class="bi bi-search"></i>
                <input type="text" class="filter-dropdown-search-input" placeholder="Search leave type..." autocomplete="off" />
            </div>
            <ul class="filter-dropdown-list list-unstyled mb-0">
                <li>
                    <a class="dropdown-item @(leaveTypes?.SelectedValue == null ? "active" : "")" href="javascript:void(0)" onclick="setLeaveTypeFilter('')">
                        <span>All Leave Types</span>
                        @if (leaveTypes?.SelectedValue == null) { <i class="bi bi-check2"></i> }
                    </a>
                </li>
                @if (leaveTypes != null)
                {
                    foreach (var lt in leaveTypes)
                    {
                        <li>
                            <a class="dropdown-item @(lt.Selected ? "active" : "")" href="javascript:void(0)" onclick="setLeaveTypeFilter('@lt.Value')">
                                <span>@lt.Text</span>
                                @if (lt.Selected) { <i class="bi bi-check2"></i> }
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
        <input type="hidden" name="leaveTypeId" id="hiddenLeaveTypeId" value="@(leaveTypes?.SelectedValue?.ToString() ?? "")" />
    </div>

    <!-- Reset Filter Button -->
    @if (hasActiveFilters)
    {
        <a asp-action="Index" class="btn-reset-filters" title="Reset all filters">
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Reset</span>
        </a>
    }

    <!-- Total Records Badge -->
    <div class="ms-auto">
        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-2 rounded-pill fw-semibold">
            @(Model?.TotalCount ?? 0) Pending Request@((Model?.TotalCount ?? 0) == 1 ? "" : "s")
        </span>
    </div>
</form>

<!-- Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important; overflow: hidden;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                    <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                        <th class="ps-4 py-2.5">Employee</th>
                        <th class="py-2.5">Leave Type</th>
                        <th class="py-2.5">Dates</th>
                        <th class="py-2.5 text-center">Days</th>
                        <th class="py-2.5">Reason</th>
                        <th class="py-2.5">Applied On</th>
                        <th class="pe-4 py-2.5 text-end">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-check2-circle fs-1 d-block mb-2 text-success opacity-50"></i>
                                All caught up! There are no pending leave requests to review.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.82rem;">
                                            @(item.EmployeeName.Length > 0 ? item.EmployeeName.Substring(0, 1).ToUpper() : "E")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@item.EmployeeName</div>
                                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.72rem;">@item.EmployeeCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@item.LeaveTypeName</span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        @item.StartDate.ToString("dd MMM yyyy")
                                        @if (item.StartDate != item.EndDate)
                                        {
                                            <span> - @item.EndDate.ToString("dd MMM yyyy")</span>
                                        }
                                    </div>
                                    @if (item.IsHalfDay)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-1">Half Day</span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-dark">@item.TotalDays.ToString("0.#")</td>
                                <td>
                                    <div class="small text-muted text-truncate" style="max-width: 220px;" title="@item.Reason">
                                        @(string.IsNullOrWhiteSpace(item.Reason) ? "-" : item.Reason)
                                    </div>
                                </td>
                                <td class="small text-muted">
                                    @item.AppliedAtUtc.ToString("dd MMM yyyy hh:mm tt")
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-action="Details" asp-route-id="@item.LeaveRecordId" class="btn btn-sm btn-primary rounded-3 px-3 fw-semibold shadow-xs">
                                        <i class="bi bi-pencil-square me-1"></i> Review
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <div class="text-muted small">Showing @Model.Items.Count of @Model.TotalCount pending requests</div>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString())"
                           asp-route-fromDate="@ViewBag.FromDate"
                           asp-route-toDate="@ViewBag.ToDate"
                           asp-route-search="@search"
                           asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString())"
                               asp-route-fromDate="@ViewBag.FromDate"
                               asp-route-toDate="@ViewBag.ToDate"
                               asp-route-search="@search"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString())"
                           asp-route-fromDate="@ViewBag.FromDate"
                           asp-route-toDate="@ViewBag.ToDate"
                           asp-route-search="@search"
                           asp-route-page="@(Model.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function setLeaveTypeFilter(id) {
            document.getElementById('hiddenLeaveTypeId').value = id;
            document.getElementById('leaveApprovalsForm').submit();
        }
    </script>
}
