@model ApprovalDetailsDto
@{
    ViewData["Title"] = "Review Leave Request";
    bool canCover = Model.Remaining >= Model.TotalDays;
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-circle" style="width: 36px; height: 36px; padding: 6px 0; text-align: center;">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h4 class="fw-bold mb-1">Review Leave Request</h4>
                    <p class="text-muted small mb-0">Pending Request ID: <span class="font-monospace">@Model.LeaveRecordId</span></p>
                </div>
            </div>
            <span class="badge bg-warning text-dark fs-6 px-3 py-2"><i class="bi bi-hourglass-split me-1"></i>Pending Review</span>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <!-- Employee Info -->
                <div class="d-flex justify-content-between align-items-start pb-3 border-bottom mb-4">
                    <div>
                        <h5 class="fw-bold text-dark mb-1">@Model.EmployeeName</h5>
                        <div class="badge bg-secondary-subtle text-secondary font-monospace">@Model.EmployeeCode</div>
                    </div>
                    <div class="text-end">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 px-3 py-1">@Model.LeaveTypeName</span>
                        <div class="small text-muted mt-1">Applied: @Model.AppliedAtUtc.ToString("dd MMM yyyy hh:mm tt")</div>
                    </div>
                </div>

                <!-- Leave Request Details -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Requested Dates</label>
                        <span class="fw-semibold text-dark fs-6">@Model.StartDate.ToString("dd MMM yyyy")</span>
                        @if (Model.StartDate != Model.EndDate)
                        {
                            <span class="text-muted"> to </span>
                            <span class="fw-semibold text-dark fs-6">@Model.EndDate.ToString("dd MMM yyyy")</span>
                        }
                        @if (Model.IsHalfDay)
                        {
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle ms-2">Half Day</span>
                        }
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small d-block">Total Working Days Requested</label>
                        <span class="fw-bold text-primary fs-3">@Model.TotalDays.ToString("0.#") <small class="fs-6 text-muted fw-normal">working day(s)</small></span>
                    </div>
                    <div class="col-12">
                        <label class="text-muted small d-block">Employee Reason</label>
                        <div class="p-3 bg-light rounded-3 text-secondary">
                            @(string.IsNullOrWhiteSpace(Model.Reason) ? "No reason specified." : Model.Reason)
                        </div>
                    </div>
                </div>

                <!-- Current Balance Card -->
                <div class="card bg-light border-0 rounded-4 p-3 mb-4">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-wallet2 text-primary me-2"></i>Current Leave Balance for Year @Model.Year</h6>
                    <div class="row text-center g-2">
                        <div class="col-4">
                            <div class="bg-white p-3 rounded-3 shadow-sm">
                                <div class="text-muted small">Entitled</div>
                                <div class="fs-4 fw-bold text-secondary">@Model.Entitled.ToString("0.#")</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white p-3 rounded-3 shadow-sm">
                                <div class="text-muted small">Used</div>
                                <div class="fs-4 fw-bold text-danger">@Model.Used.ToString("0.#")</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="bg-white p-3 rounded-3 shadow-sm">
                                <div class="text-muted small">Remaining</div>
                                <div class="fs-4 fw-bold @(canCover ? "text-success" : "text-danger")">@Model.Remaining.ToString("0.#")</div>
                            </div>
                        </div>
                    </div>

                    @if (!canCover)
                    {
                        <div class="alert alert-danger border-0 rounded-3 mt-3 mb-0 small">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Insufficient Balance:</strong> Employee only has <strong>@Model.Remaining.ToString("0.#")</strong> day(s) remaining, which cannot cover the requested <strong>@Model.TotalDays.ToString("0.#")</strong> day(s).
                        </div>
                    }
                </div>

                <!-- Actions -->
                <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Approvals
                    </a>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger px-4" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            <i class="bi bi-x-circle me-1"></i> Reject
                        </button>

                        <form asp-action="Approve" asp-route-id="@Model.LeaveRecordId" method="post" class="d-inline" onsubmit="return confirm('Approve this leave request? Leave balance will be updated and attendance marked as OnLeave.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success px-4 shadow-sm" @(!canCover ? "disabled" : "")>
                                <i class="bi bi-check-circle me-1"></i> Approve Leave
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="rejectModalLabel">Reject Leave Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Reject" asp-route-id="@Model.LeaveRecordId" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-4">
                    <p class="text-muted small mb-3">Please provide a reason or note explaining why this leave request is being rejected. The employee will be able to see this note.</p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Review Note / Reason for Rejection <span class="text-danger">*</span></label>
                        <textarea name="reviewNote" class="form-control bg-light border-0" rows="3" maxlength="500" placeholder="State reason for rejection..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger px-4">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>
