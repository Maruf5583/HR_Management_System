@model IReadOnlyList<LeaveTypeDto>
@{
    ViewData["Title"] = "Leave Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-tags me-2 text-primary"></i>Leave Types</h4>
        <p class="text-muted small mb-0">Manage leave categories, entitlements, and status</p>
    </div>
    @if (CurrentUser.HasPermission(Permissions.Leave.Manage))
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Leave Type
        </a>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small">
                    <tr>
                        <th class="ps-4 py-3">NAME</th>
                        <th class="py-3">CODE</th>
                        <th class="py-3">TYPE</th>
                        <th class="py-3 text-center">DAYS PER YEAR</th>
                        <th class="py-3 text-center">DOC REQUIRED</th>
                        <th class="py-3 text-center">STATUS</th>
                        <th class="pe-4 py-3 text-end">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary opacity-50"></i>
                                No leave types found. Click <strong>Add Leave Type</strong> to create one.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-dark">@item.Name</td>
                                <td><span class="badge bg-secondary-subtle text-secondary font-monospace">@item.Code</span></td>
                                <td>
                                    @if (item.IsPaid)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Paid</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">Unpaid</span>
                                    }
                                </td>
                                <td class="text-center fw-semibold">@item.DaysPerYear.ToString("0.#")</td>
                                <td class="text-center">
                                    @if (item.RequiresDocument)
                                    {
                                        <i class="bi bi-file-earmark-check text-primary fs-5" title="Document required"></i>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.Status == LeaveTypeStatus.Active)
                                    {
                                        <span class="badge bg-success-subtle text-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger">Inactive</span>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    @if (CurrentUser.HasPermission(Permissions.Leave.Manage))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.LeaveTypeId" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="ToggleStatus" asp-route-id="@item.LeaveTypeId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.Status == LeaveTypeStatus.Active ? "btn-outline-secondary" : "btn-outline-success")"
                                                    title="@(item.Status == LeaveTypeStatus.Active ? "Deactivate" : "Activate")">
                                                <i class="bi @(item.Status == LeaveTypeStatus.Active ? "bi-pause-circle" : "bi-play-circle")"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
