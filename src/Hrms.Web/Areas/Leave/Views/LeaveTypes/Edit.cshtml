@model EditLeaveTypeViewModel
@{
    ViewData["Title"] = "Edit Leave Type";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="d-flex align-items-center mb-3">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3"><i class="bi bi-arrow-left"></i> Back</a>
            <h4 class="fw-bold mb-0">Edit Leave Type</h4>
        </div>

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeaveTypeId" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Leave Type Name <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control" required />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Code" class="form-label fw-semibold">Code <span class="text-danger">*</span></label>
                    <input asp-for="Code" class="form-control font-monospace" required />
                    <span asp-validation-for="Code" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="DaysPerYear" class="form-label fw-semibold">Days Per Year <span class="text-danger">*</span></label>
                    <input asp-for="DaysPerYear" type="number" step="0.5" min="0" class="form-control" required />
                    <span asp-validation-for="DaysPerYear" class="text-danger small"></span>
                    <div class="form-text text-muted">
                        <i class="bi bi-info-circle me-1 text-primary"></i>For an unpaid type, use a large DaysPerYear (for example 365).
                    </div>
                </div>

                <div class="mb-3 form-check form-switch">
                    <input asp-for="IsPaid" class="form-check-input" type="checkbox" role="switch" id="isPaidSwitch" />
                    <label class="form-check-label fw-semibold" for="isPaidSwitch">Is Paid Leave</label>
                </div>

                <div class="mb-4 form-check form-switch">
                    <input asp-for="RequiresDocument" class="form-check-input" type="checkbox" role="switch" id="reqDocSwitch" />
                    <label class="form-check-label fw-semibold" for="reqDocSwitch">Requires Supporting Document</label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle me-1"></i> Update Leave Type</button>
                </div>
            </form>
        </div>
    </div>
</div>
