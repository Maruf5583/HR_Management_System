@model PagedResult<LeaveRecordItemDto>
@{
    ViewData["Title"] = "Leave Records";
    ViewData["Subtitle"] = "Complete historical records of leave requests, direct entries, and review decisions";
    var currentStatus = ViewBag.Status as LeaveRecordStatus?;
    var leaveTypes = ViewBag.LeaveTypes as SelectList;
    var search = ViewBag.Search as string;
    var hasActiveFilters = !string.IsNullOrEmpty(search) || currentStatus.HasValue || (leaveTypes?.SelectedValue != null) || !string.IsNullOrEmpty(ViewBag.FromDate);
}


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-3" role="alert" style="border-radius: 12px; background-color: #ecfdf3; color: #027a48;">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-3" role="alert" style="border-radius: 12px; background-color: #fef3f2; color: #b42318;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Quick Summary Status Pills -->
<div class="quick-summary-pills">
    <a asp-action="Index" asp-route-search="@search" class="quick-summary-pill @(!currentStatus.HasValue ? "active" : "")">
        <span>All Records</span>
    </a>
    <a asp-action="Index" asp-route-status="@LeaveRecordStatus.Approved" asp-route-search="@search" class="quick-summary-pill @(currentStatus == LeaveRecordStatus.Approved ? "active" : "")">
        <span class="status-badge-dot status-active p-0" style="background: transparent;"></span>
        <span>Approved</span>
    </a>
    <a asp-action="Index" asp-route-status="@LeaveRecordStatus.Pending" asp-route-search="@search" class="quick-summary-pill @(currentStatus == LeaveRecordStatus.Pending ? "active" : "")">
        <span class="status-badge-dot status-warning p-0" style="background: transparent;"></span>
        <span>Pending</span>
    </a>
    <a asp-action="Index" asp-route-status="@LeaveRecordStatus.Rejected" asp-route-search="@search" class="quick-summary-pill @(currentStatus == LeaveRecordStatus.Rejected ? "active" : "")">
        <span class="status-badge-dot status-danger p-0" style="background: transparent;"></span>
        <span>Rejected</span>
    </a>
    <a asp-action="Index" asp-route-status="@LeaveRecordStatus.Cancelled" asp-route-search="@search" class="quick-summary-pill @(currentStatus == LeaveRecordStatus.Cancelled ? "active" : "")">
        <span class="status-badge-dot status-neutral p-0" style="background: transparent;"></span>
        <span>Cancelled</span>
    </a>
</div>

<!-- EmplowHR-Inspired Unified Filter Bar -->
<form method="get" asp-action="Index" id="leaveRecordsFilterForm" class="table-filter-bar mb-3">
    @if (currentStatus.HasValue)
    {
        <input type="hidden" name="status" id="hiddenStatus" value="@currentStatus.Value" />
    }

    <!-- Search Input -->
    <div class="table-search-box">
        <i class="bi bi-search search-icon"></i>
        <input type="text" name="search" class="table-search-input" value="@search" placeholder="Search employee name or code..." onkeydown="if(event.key==='Enter'){ this.form.submit(); }" />
    </div>

    <!-- Status Dropdown Pill -->
    <div class="dropdown">
        <button class="filter-pill-dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span>@(currentStatus.HasValue ? currentStatus.Value.ToString() : "All Statuses")</span>
            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
        </button>
        <div class="dropdown-menu filter-dropdown-menu">
            <div class="filter-dropdown-search">
                <i class="bi bi-search"></i>
                <input type="text" class="filter-dropdown-search-input" placeholder="Search status..." autocomplete="off" />
            </div>
            <ul class="filter-dropdown-list list-unstyled mb-0">
                <li>
                    <a class="dropdown-item @(!currentStatus.HasValue ? "active" : "")" href="javascript:void(0)" onclick="setStatusFilter('')">
                        <span>All Statuses</span>
                        @if (!currentStatus.HasValue) { <i class="bi bi-check2"></i> }
                    </a>
                </li>
                @foreach (LeaveRecordStatus st in Enum.GetValues(typeof(LeaveRecordStatus)))
                {
                    <li>
                        <a class="dropdown-item @(currentStatus == st ? "active" : "")" href="javascript:void(0)" onclick="setStatusFilter('@st')">
                            <span>@st</span>
                            @if (currentStatus == st) { <i class="bi bi-check2"></i> }
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Leave Type Dropdown Pill -->
    <div class="dropdown">
        <button class="filter-pill-dropdown" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span>@(leaveTypes?.FirstOrDefault(x => x.Selected)?.Text ?? "All Leave Types")</span>
            <i class="bi bi-chevron-down chevron-icon ms-1"></i>
        </button>
        <div class="dropdown-menu filter-dropdown-menu">
            <div class="filter-dropdown-search">
                <i class="bi bi-search"></i>
                <input type="text" class="filter-dropdown-search-input" placeholder="Search leave type..." autocomplete="off" />
            </div>
            <ul class="filter-dropdown-list list-unstyled mb-0">
                <li>
                    <a class="dropdown-item @(leaveTypes?.SelectedValue == null ? "active" : "")" href="javascript:void(0)" onclick="setLeaveTypeFilter('')">
                        <span>All Leave Types</span>
                        @if (leaveTypes?.SelectedValue == null) { <i class="bi bi-check2"></i> }
                    </a>
                </li>
                @if (leaveTypes != null)
                {
                    foreach (var lt in leaveTypes)
                    {
                        <li>
                            <a class="dropdown-item @(lt.Selected ? "active" : "")" href="javascript:void(0)" onclick="setLeaveTypeFilter('@lt.Value')">
                                <span>@lt.Text</span>
                                @if (lt.Selected) { <i class="bi bi-check2"></i> }
                            </a>
                        </li>
                    }
                }
            </ul>
        </div>
        <input type="hidden" name="leaveTypeId" id="hiddenLeaveTypeId" value="@(leaveTypes?.SelectedValue?.ToString() ?? "")" />
    </div>

    <!-- Reset Filter Button -->
    @if (hasActiveFilters)
    {
        <a asp-action="Index" class="btn-reset-filters" title="Reset all filters">
            <i class="bi bi-arrow-counterclockwise"></i>
            <span>Reset</span>
        </a>
    }

    <div class="d-flex align-items-center gap-3 ms-auto">
        @if (CurrentUser.HasPermission(Permissions.Leave.Manage))
        {
            <a asp-action="Create" class="btn btn-primary px-3 fw-semibold rounded-3 shadow-xs d-inline-flex align-items-center gap-1.5" style="height: 40px; font-size: 0.875rem; white-space: nowrap;">
                <i class="bi bi-plus-lg"></i>
                <span>Add direct record</span>
            </a>
        }
    </div>
</form>

<!-- Table Card -->
<div class="card border-0 shadow-sm" style="border-radius: 14px; border: 1px solid #eaecf0 !important;">
    <div class="card-body p-0">
        <div class="table-responsive" style="min-height: 250px;">
            <table class="table table-hover align-middle mb-0 table-sticky-first">
                <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                    <tr class="text-secondary small fw-semibold" style="font-size: 0.78rem; letter-spacing: 0.01em;">
                        <th class="ps-4 py-2.5">Employee</th>
                        <th class="py-2.5">Leave Type</th>
                        <th class="py-2.5">Date Range</th>
                        <th class="py-2.5 text-center">Days</th>
                        <th class="py-2.5 text-center">Status</th>
                        <th class="py-2.5">Reason / Notes</th>
                        <th class="pe-4 py-2.5 text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-muted"></i>
                                No leave records found matching the filter criteria.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center" style="width: 34px; height: 34px; font-size: 0.82rem;">
                                            @(item.EmployeeName.Length > 0 ? item.EmployeeName.Substring(0, 1).ToUpper() : "E")
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@item.EmployeeName</div>
                                            <span class="badge bg-light text-secondary border font-monospace" style="font-size: 0.72rem;">@item.EmployeeCode</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border px-2 py-1">@item.LeaveTypeName</span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">
                                        @item.StartDate.ToString("dd MMM yyyy")
                                        @if (item.StartDate != item.EndDate)
                                        {
                                            <span> - @item.EndDate.ToString("dd MMM yyyy")</span>
                                        }
                                    </div>
                                    @if (item.IsHalfDay)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-1">Half Day</span>
                                    }
                                </td>
                                <td class="text-center fw-bold text-dark">@item.TotalDays.ToString("0.#")</td>
                                <td class="text-center">
                                    <partial name="_StatusChip" model="@item.Status.ToString()" />
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Reason))
                                    {
                                        <div class="small text-truncate" style="max-width: 200px;" title="@item.Reason">@item.Reason</div>
                                    }
                                    @if (!string.IsNullOrEmpty(item.ReviewNote))
                                    {
                                        <div class="small text-danger text-truncate" style="max-width: 200px;" title="@item.ReviewNote">
                                            <i class="bi bi-chat-left-dots me-1"></i>@item.ReviewNote
                                        </div>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <div class="dropdown">
                                        <button type="button" class="btn btn-sm btn-light border-0 px-2 py-1 text-muted" data-bs-toggle="dropdown" data-bs-popper-config='{"strategy":"fixed"}' aria-expanded="false" title="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1" style="border-radius: 10px; min-width: 140px; z-index: 1060;">
                                            <li>
                                                <a asp-action="Details" asp-route-id="@item.LeaveRecordId" class="dropdown-item py-1.5 small d-flex align-items-center gap-2">
                                                    <i class="bi bi-eye text-muted"></i>
                                                    <span>View Details</span>
                                                </a>
                                            </li>
                                            @if (item.Status == LeaveRecordStatus.Approved && CurrentUser.HasPermission(Permissions.Leave.Manage))
                                            {
                                                <li><hr class="dropdown-divider my-1"></li>
                                                <li>
                                                    <form asp-action="Cancel" asp-route-id="@item.LeaveRecordId" method="post" data-confirm="Are you sure you want to cancel this approved leave? The days will be returned to the employee's remaining balance." data-confirm-title="Cancel Approved Leave" data-confirm-btn="Cancel Leave">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="dropdown-item py-1.5 small text-danger d-flex align-items-center gap-2">
                                                            <i class="bi bi-x-circle"></i>
                                                            <span>Cancel Leave</span>
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @if (Model != null && Model.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <div class="text-muted small">Showing @Model.Items.Count of @Model.TotalCount leave records</div>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-status="@currentStatus"
                           asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString())"
                           asp-route-search="@search"
                           asp-route-page="@(Model.PageNumber - 1)">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-status="@currentStatus"
                               asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString())"
                               asp-route-search="@search"
                               asp-route-page="@p">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                        <a class="page-link" asp-action="Index"
                           asp-route-status="@currentStatus"
                           asp-route-leaveTypeId="@(leaveTypes?.SelectedValue?.ToString())"
                           asp-route-search="@search"
                           asp-route-page="@(Model.PageNumber + 1)">Next</a>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function setStatusFilter(status) {
            let hiddenStatus = document.getElementById('hiddenStatus');
            if (!hiddenStatus) {
                hiddenStatus = document.createElement('input');
                hiddenStatus.type = 'hidden';
                hiddenStatus.name = 'status';
                hiddenStatus.id = 'hiddenStatus';
                document.getElementById('leaveRecordsFilterForm').appendChild(hiddenStatus);
            }
            hiddenStatus.value = status;
            document.getElementById('leaveRecordsFilterForm').submit();
        }

        function setLeaveTypeFilter(id) {
            document.getElementById('hiddenLeaveTypeId').value = id;
            document.getElementById('leaveRecordsFilterForm').submit();
        }
    </script>
}
