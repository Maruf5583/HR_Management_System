@model Hrms.Web.Areas.Leave.Controllers.MyLeavePageViewModel
@{
    ViewData["Title"] = "My Leave";
    string activeTab = (ViewBag.ActiveTab as string) ?? "myleaves";
}

<div class="workspace-container">
    <!-- Top Unified Self-Service Hub Navigation Tabs -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-3">
        <div class="d-inline-flex p-1 bg-white border rounded-3 shadow-xs" style="border-color: #eaecf0 !important;">
            @if (CurrentUser.HasPermission(Permissions.Employees.ViewOwn))
            {
                <a class="btn btn-sm btn-link text-secondary text-decoration-none rounded-2 px-3 py-1.5 fw-medium d-inline-flex align-items-center gap-1.5"
                   asp-area="Employees" asp-controller="Employees" asp-action="MyProfile">
                    <span>Personal Profile</span>
                </a>
            }
            @if (CurrentUser.HasPermission(Permissions.Assets.ViewOwn))
            {
                <a class="btn btn-sm btn-link text-secondary text-decoration-none rounded-2 px-3 py-1.5 fw-medium d-inline-flex align-items-center gap-1.5"
                   asp-area="Assets" asp-controller="Assets" asp-action="My">
                    <span>My Assets</span>
                </a>
            }
            @if (CurrentUser.HasPermission(Permissions.Attendance.ViewOwn))
            {
                <a class="btn btn-sm btn-link text-secondary text-decoration-none rounded-2 px-3 py-1.5 fw-medium d-inline-flex align-items-center gap-1.5"
                   asp-area="Attendance" asp-controller="MyAttendance" asp-action="Index">
                    <span>My Attendance</span>
                </a>
            }
            <a class="btn btn-sm btn-primary text-white rounded-2 px-3 py-1.5 fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs"
               asp-area="Leave" asp-controller="MyLeave" asp-action="Index">
                <span>My Leave</span>
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-xs border-0 rounded-3 mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-xs border-0 rounded-3 mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Summary.HasLinkedEmployee)
    {
        <div class="workspace-card p-5 text-center">
            <div class="workspace-empty-state">
                <i class="bi bi-person-x workspace-empty-icon text-muted"></i>
                <div class="fw-bold text-dark mb-1">No Linked Employee Record Found</div>
                <div class="text-muted small">Your user account is not currently linked to an active employee record. Employee self-service features require an employee profile.</div>
            </div>
        </div>
    }
    else
    {
        <!-- Leave Sub-tabs Navigation -->
        <div class="mb-4">
            <ul class="nav nav-pills bg-white p-1 rounded-3 d-inline-flex border shadow-xs mb-0" id="leaveTabs" role="tablist" style="border-color: #eaecf0 !important;">
                <li class="nav-item" role="presentation">
                    <button class="nav-link rounded-2 px-3 py-1.5 fw-semibold @(activeTab == "myleaves" ? "active" : "")" id="myleaves-tab" data-bs-toggle="pill" data-bs-target="#myleaves" type="button" role="tab">
                        <i class="bi bi-clock-history me-1"></i> My Leaves
                    </button>
                </li>
                @if (CurrentUser.HasPermission(Permissions.Leave.Apply))
                {
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-2 px-3 py-1.5 fw-semibold @(activeTab == "request" ? "active" : "")" id="request-tab" data-bs-toggle="pill" data-bs-target="#request" type="button" role="tab">
                            <i class="bi bi-plus-circle me-1"></i> Request Leave
                        </button>
                    </li>
                }
            </ul>
        </div>

        <div class="tab-content" id="leaveTabsContent">
            <!-- Tab 1: My Leaves -->
            <div class="tab-pane fade @(activeTab == "myleaves" ? "show active" : "")" id="myleaves" role="tabpanel">
                <div class="workspace-grid-2col">
                    <!-- Left Column: Sticky Stacked Leave Balances -->
                    <div class="workspace-col-sticky d-flex flex-column gap-3">
                        <div class="workspace-card">
                            <div class="workspace-card-header">
                                <div class="workspace-card-title">
                                    <i class="bi bi-wallet2 text-primary"></i>
                                    <span>Leave Balances</span>
                                </div>
                                <span class="badge bg-light text-muted border">Year @Model.Summary.CurrentLeaveYear</span>
                            </div>
                            <div class="workspace-card-body p-3">
                                @if (!Model.Summary.Balances.Any())
                                {
                                    <div class="text-center py-4 text-muted small">
                                        No leave balances assigned for @Model.Summary.CurrentLeaveYear.
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2" style="max-height: 480px; overflow-y: auto;">
                                        @foreach (var card in Model.Summary.Balances)
                                        {
                                            <div class="p-3 rounded-3 border bg-light bg-opacity-50" style="border-color: #eaecf0 !important;">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 fw-semibold" style="font-size: 0.72rem;">@card.LeaveTypeCode</span>
                                                    <span class="small @(card.IsPaid ? "text-success" : "text-secondary")" style="font-size: 0.72rem;">@(card.IsPaid ? "Paid Leave" : "Unpaid")</span>
                                                </div>
                                                <div class="fw-bold text-dark small mb-1.5">@card.LeaveTypeName</div>
                                                <div class="d-flex justify-content-between align-items-baseline mb-1">
                                                    <span class="text-muted" style="font-size: 0.74rem;">Remaining</span>
                                                    <span class="fw-bold fs-5 @(card.Remaining > 0 ? "text-success" : "text-secondary")">
                                                        @card.Remaining.ToString("0.#") <small class="text-muted fw-normal" style="font-size: 0.72rem;">days</small>
                                                    </span>
                                                </div>
                                                <div class="progress mb-2" style="height: 5px; border-radius: 3px; background-color: #e2e8f0;">
                                                    @{
                                                        var pct = card.Entitled > 0 ? Math.Min(100, (card.Used / card.Entitled) * 100) : 0;
                                                    }
                                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%"></div>
                                                </div>
                                                <div class="d-flex justify-content-between text-muted" style="font-size: 0.72rem;">
                                                    <span>Entitled: <strong class="text-dark">@card.Entitled.ToString("0.#")</strong></span>
                                                    <span>Used: <strong class="text-dark">@card.Used.ToString("0.#")</strong></span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }

                                @if (CurrentUser.HasPermission(Permissions.Leave.Apply))
                                {
                                    <button type="button" class="btn btn-primary w-100 rounded-3 py-2 fw-semibold shadow-xs mt-3" onclick="document.getElementById('request-tab')?.click()">
                                        <i class="bi bi-plus-circle me-1"></i> Request Leave
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Right Column: Leave History -->
                    <div class="d-flex flex-column gap-3">
                        <div class="workspace-card">
                            <div class="workspace-card-header">
                                <div class="workspace-card-title">
                                    <i class="bi bi-card-list text-primary"></i>
                                    <span>Leave History</span>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <select class="form-select form-select-sm" id="historyStatusFilter" onchange="filterLeaveHistory(this.value)" style="width: auto; min-width: 130px; border-color: #eaecf0 !important;">
                                        <option value="all">All Statuses</option>
                                        <option value="pending">Pending</option>
                                        <option value="approved">Approved</option>
                                        <option value="rejected">Rejected</option>
                                        <option value="cancelled">Cancelled</option>
                                    </select>
                                </div>
                            </div>
                            <div class="workspace-card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0" id="leaveHistoryTable">
                                        <thead class="bg-light text-muted small">
                                            <tr>
                                                <th class="ps-4 py-3" style="width: 140px;">TYPE</th>
                                                <th class="py-3" style="width: 120px;">FROM</th>
                                                <th class="py-3" style="width: 130px;">TO</th>
                                                <th class="py-3 text-center" style="width: 80px;">DAYS</th>
                                                <th class="py-3 text-center" style="width: 110px;">STATUS</th>
                                                <th class="py-3">DETAILS / NOTES</th>
                                                <th class="pe-4 py-3 text-end" style="width: 140px;">ACTIONS</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (!Model.Summary.History.Any())
                                            {
                                                <tr>
                                                    <td colspan="7" class="text-center py-5 text-muted">
                                                        <div class="workspace-empty-state">
                                                            <i class="bi bi-calendar-x workspace-empty-icon text-muted"></i>
                                                            <div class="text-muted">You have not submitted any leave requests yet.</div>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                            else
                                            {
                                                foreach (var item in Model.Summary.History)
                                                {
                                                    string statusKey = item.Status.ToString().ToLowerInvariant();
                                                    <tr data-status="@statusKey">
                                                        <td class="ps-4">
                                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">@item.LeaveTypeName</span>
                                                        </td>
                                                        <td class="fw-medium text-dark small">@item.StartDate.ToString("dd MMM yyyy")</td>
                                                        <td class="fw-medium text-dark small">
                                                            @item.EndDate.ToString("dd MMM yyyy")
                                                            @if (item.IsHalfDay)
                                                            {
                                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle ms-1" style="font-size: 0.68rem;">Half Day</span>
                                                            }
                                                        </td>
                                                        <td class="text-center fw-bold small">@item.TotalDays.ToString("0.#")</td>
                                                        <td class="text-center">
                                                            @switch (item.Status)
                                                            {
                                                                case LeaveRecordStatus.Pending:
                                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                                                    break;
                                                                case LeaveRecordStatus.Approved:
                                                                    <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                                                    break;
                                                                case LeaveRecordStatus.Rejected:
                                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                                                    break;
                                                                case LeaveRecordStatus.Cancelled:
                                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><i class="bi bi-dash-circle me-1"></i>Cancelled</span>
                                                                    break;
                                                            }
                                                        </td>
                                                        <td>
                                                            @if (item.Status == LeaveRecordStatus.Rejected && !string.IsNullOrWhiteSpace(item.ReviewNote))
                                                            {
                                                                <div class="small text-danger fw-medium" title="Rejection Note">
                                                                    <i class="bi bi-exclamation-circle me-1"></i>@item.ReviewNote
                                                                </div>
                                                            }
                                                            else if (!string.IsNullOrWhiteSpace(item.Reason))
                                                            {
                                                                <div class="small text-muted text-truncate" style="max-width: 220px;" title="@item.Reason">@item.Reason</div>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted small">-</span>
                                                            }
                                                        </td>
                                                        <td class="pe-4 text-end">
                                                            <div class="d-inline-flex gap-1 align-items-center">
                                                                <button type="button" class="btn btn-sm btn-light border" data-bs-toggle="modal" data-bs-target="#viewLeaveModal-@item.LeaveRecordId" title="View Leave Details">
                                                                    <i class="bi bi-eye"></i> View
                                                                </button>
                                                                @if (item.Status == LeaveRecordStatus.Pending)
                                                                {
                                                                    <form asp-action="Cancel" asp-route-id="@item.LeaveRecordId" method="post" class="d-inline" data-confirm="Are you sure you want to cancel this pending leave request?" data-confirm-title="Cancel Leave Request" data-confirm-btn="Cancel Request">
                                                                        @Html.AntiForgeryToken()
                                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Request">
                                                                            <i class="bi bi-x-circle"></i> Cancel
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>

                                                            <!-- View Leave Details Modal -->
                                                            <div class="modal fade text-start" id="viewLeaveModal-@item.LeaveRecordId" tabindex="-1" aria-hidden="true">
                                                                <div class="modal-dialog modal-dialog-centered">
                                                                    <div class="modal-content border-0 shadow rounded-4">
                                                                        <div class="modal-header border-bottom py-3">
                                                                            <h6 class="modal-title fw-bold text-dark mb-0">
                                                                                <i class="bi bi-calendar2-check text-primary me-2"></i>Leave Request Details
                                                                            </h6>
                                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                                        </div>
                                                                        <div class="modal-body p-4">
                                                                            <div class="d-flex justify-content-between align-items-center p-3 bg-light rounded-3 mb-3 border">
                                                                                <div>
                                                                                    <div class="small text-muted text-uppercase fw-semibold" style="font-size: 0.72rem;">Leave Type</div>
                                                                                    <div class="fw-bold text-dark small mb-0">@item.LeaveTypeName</div>
                                                                                </div>
                                                                                <div>
                                                                                    @switch (item.Status)
                                                                                    {
                                                                                        case LeaveRecordStatus.Pending:
                                                                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1.5"><i class="bi bi-hourglass-split me-1"></i>Pending</span>
                                                                                            break;
                                                                                        case LeaveRecordStatus.Approved:
                                                                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1.5"><i class="bi bi-check-circle me-1"></i>Approved</span>
                                                                                            break;
                                                                                        case LeaveRecordStatus.Rejected:
                                                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1.5"><i class="bi bi-x-circle me-1"></i>Rejected</span>
                                                                                            break;
                                                                                        case LeaveRecordStatus.Cancelled:
                                                                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-1.5"><i class="bi bi-dash-circle me-1"></i>Cancelled</span>
                                                                                            break;
                                                                                    }
                                                                                </div>
                                                                            </div>

                                                                            <dl class="row g-2 small mb-0">
                                                                                <dt class="col-sm-4 text-muted">From Date:</dt>
                                                                                <dd class="col-sm-8 fw-semibold text-dark">@item.StartDate.ToString("dd MMMM yyyy")</dd>

                                                                                <dt class="col-sm-4 text-muted">To Date:</dt>
                                                                                <dd class="col-sm-8 fw-semibold text-dark">@item.EndDate.ToString("dd MMMM yyyy")</dd>

                                                                                <dt class="col-sm-4 text-muted">Total Days:</dt>
                                                                                <dd class="col-sm-8 fw-bold text-primary">@item.TotalDays.ToString("0.#") Day@(item.TotalDays == 1 ? "" : "s") @(item.IsHalfDay ? "(Half Day)" : "")</dd>

                                                                                <dt class="col-sm-4 text-muted">Reason / Notes:</dt>
                                                                                <dd class="col-sm-8 text-dark">@(string.IsNullOrWhiteSpace(item.Reason) ? "No reason specified" : item.Reason)</dd>

                                                                                @if (!string.IsNullOrWhiteSpace(item.ReviewNote))
                                                                                {
                                                                                    <dt class="col-sm-4 text-danger">HR / Admin Remarks:</dt>
                                                                                    <dd class="col-sm-8 text-danger fw-medium">@item.ReviewNote</dd>
                                                                                }
                                                                            </dl>
                                                                        </div>
                                                                        <div class="modal-footer border-top py-2">
                                                                            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Close</button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 2: Request Leave -->
            @if (CurrentUser.HasPermission(Permissions.Leave.Apply))
            {
                <div class="tab-pane fade @(activeTab == "request" ? "show active" : "")" id="request" role="tabpanel">
                    <div class="workspace-grid-2col">
                        <!-- Left Column: Same Stacked Balances -->
                        <div class="workspace-col-sticky d-flex flex-column gap-3">
                            <div class="workspace-card">
                                <div class="workspace-card-header">
                                    <div class="workspace-card-title">
                                        <i class="bi bi-wallet2 text-primary"></i>
                                        <span>Leave Balances</span>
                                    </div>
                                    <span class="badge bg-light text-muted border">Year @Model.Summary.CurrentLeaveYear</span>
                                </div>
                                <div class="workspace-card-body p-3">
                                    @if (!Model.Summary.Balances.Any())
                                    {
                                        <div class="text-center py-4 text-muted small">
                                            No leave balances assigned for @Model.Summary.CurrentLeaveYear.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-2" style="max-height: 480px; overflow-y: auto;">
                                            @foreach (var card in Model.Summary.Balances)
                                            {
                                                <div class="p-3 rounded-3 border bg-light bg-opacity-50" style="border-color: #eaecf0 !important;">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0.5 fw-semibold" style="font-size: 0.72rem;">@card.LeaveTypeCode</span>
                                                        <span class="small @(card.IsPaid ? "text-success" : "text-secondary")" style="font-size: 0.72rem;">@(card.IsPaid ? "Paid Leave" : "Unpaid")</span>
                                                    </div>
                                                    <div class="fw-bold text-dark small mb-1.5">@card.LeaveTypeName</div>
                                                    <div class="d-flex justify-content-between align-items-baseline mb-1">
                                                        <span class="text-muted" style="font-size: 0.74rem;">Remaining</span>
                                                        <span class="fw-bold fs-5 @(card.Remaining > 0 ? "text-success" : "text-secondary")">
                                                            @card.Remaining.ToString("0.#") <small class="text-muted fw-normal" style="font-size: 0.72rem;">days</small>
                                                        </span>
                                                    </div>
                                                    <div class="progress mb-2" style="height: 5px; border-radius: 3px; background-color: #e2e8f0;">
                                                        @{
                                                            var pct = card.Entitled > 0 ? Math.Min(100, (card.Used / card.Entitled) * 100) : 0;
                                                        }
                                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%"></div>
                                                    </div>
                                                    <div class="d-flex justify-content-between text-muted" style="font-size: 0.72rem;">
                                                        <span>Entitled: <strong class="text-dark">@card.Entitled.ToString("0.#")</strong></span>
                                                        <span>Used: <strong class="text-dark">@card.Used.ToString("0.#")</strong></span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Right Column: Request Form Card -->
                        <div>
                            <div class="workspace-card">
                                <div class="workspace-card-header">
                                    <div class="workspace-card-title">
                                        <i class="bi bi-calendar-plus text-primary"></i>
                                        <span>Submit Leave Request</span>
                                    </div>
                                </div>
                                <div class="workspace-card-body">
                                    <p class="text-muted small mb-4">Request leave for upcoming working days. Requests will be submitted for HR/Admin approval.</p>

                                    <form asp-action="Apply" method="post">
                                        @Html.AntiForgeryToken()

                                        <div class="mb-3">
                                            <label asp-for="Apply.LeaveTypeId" class="form-label fw-semibold small text-muted">Leave Type <span class="text-danger">*</span></label>
                                            <select asp-for="Apply.LeaveTypeId" class="form-select" asp-items="ViewBag.ActiveLeaveTypes" required>
                                                <option value="">Select leave type...</option>
                                            </select>
                                        </div>

                                        <div class="row g-3 mb-3">
                                            <div class="col-md-6">
                                                <label asp-for="Apply.StartDate" class="form-label fw-semibold small text-muted">Start Date <span class="text-danger">*</span></label>
                                                <input asp-for="Apply.StartDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                            </div>
                                            <div class="col-md-6">
                                                <label asp-for="Apply.EndDate" class="form-label fw-semibold small text-muted">End Date <span class="text-danger">*</span></label>
                                                <input asp-for="Apply.EndDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <div class="form-check form-switch">
                                                <input asp-for="Apply.IsHalfDay" class="form-check-input" type="checkbox" id="myIsHalfDaySwitch">
                                                <label class="form-check-label fw-semibold small text-dark" for="myIsHalfDaySwitch">Half Day Request (0.5 Day)</label>
                                            </div>
                                            <div class="text-muted" style="font-size: 0.74rem;">For half day, Start Date and End Date must be identical.</div>
                                        </div>

                                        <div class="mb-4">
                                            <label asp-for="Apply.Reason" class="form-label fw-semibold small text-muted">Reason (Optional)</label>
                                            <textarea asp-for="Apply.Reason" class="form-control" rows="3" placeholder="Provide reason or context for this leave request..." maxlength="1000"></textarea>
                                        </div>

                                        <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                                            <button type="button" class="btn btn-light border px-3 rounded-3" onclick="document.getElementById('myleaves-tab')?.click()">Cancel</button>
                                            <button type="submit" class="btn btn-primary px-4 rounded-3 shadow-xs fw-semibold">
                                                <i class="bi bi-send me-1"></i> Submit Request
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        var switchEl = document.getElementById('myIsHalfDaySwitch');
        var startEl = document.getElementById('Apply_StartDate');
        var endEl = document.getElementById('Apply_EndDate');

        if (switchEl && startEl && endEl) {
            switchEl.addEventListener('change', function () {
                if (this.checked && startEl.value) {
                    endEl.value = startEl.value;
                }
            });
            startEl.addEventListener('change', function () {
                if (switchEl.checked) {
                    endEl.value = this.value;
                }
            });
        }

        function filterLeaveHistory(status) {
            var rows = document.querySelectorAll('#leaveHistoryTable tbody tr[data-status]');
            rows.forEach(function (row) {
                if (status === 'all' || row.getAttribute('data-status') === status) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
}
