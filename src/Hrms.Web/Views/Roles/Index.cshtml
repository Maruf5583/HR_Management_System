@model IReadOnlyList<RoleDto>
@{
    ViewData["Title"] = "Roles Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">Roles & Permissions</h3>
        <p class="text-muted mb-0">System and custom security roles with their assigned claim permissions</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-modern">
        <i class="bi bi-shield-plus me-1"></i> Create Custom Role
    </a>
</div>

<div class="card-modern overflow-hidden">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th class="ps-4">Role Name</th>
                    <th>Description</th>
                    <th>Type</th>
                    <th>Assigned Users</th>
                    <th>Granted Permissions</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded bg-light border text-primary d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                    <i class="bi bi-shield-lock"></i>
                                </div>
                                <span class="fw-bold text-dark">@role.Name</span>
                            </div>
                        </td>
                        <td class="text-muted">@(role.Description ?? "No description provided")</td>
                        <td>
                            @if (role.IsSystem)
                            {
                                <span class="badge badge-soft-primary"><i class="bi bi-lock-fill me-1"></i>System Role</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-secondary">Custom Role</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-people me-1"></i>@role.UserCount users
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-check2-circle text-success me-1"></i>@role.Permissions.Count / @Permissions.All.Count
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-secondary" title="Edit Role & Permissions">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (!role.IsSystem)
                                {
                                    <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-sm btn-outline-danger" title="Delete Role">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
