@model IReadOnlyList<UserDto>
@{
    ViewData["Title"] = "Users Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1">User Accounts</h3>
        <p class="text-muted mb-0">Total active & inactive user accounts registered in HRMS</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-modern">
        <i class="bi bi-person-plus me-1"></i> Add New User
    </a>
</div>

<div class="card-modern overflow-hidden">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th class="ps-4">User Details</th>
                    <th>Role</th>
                    <th>Account Status</th>
                    <th>Last Active (UTC)</th>
                    <th>Created</th>
                    <th class="text-end pe-4">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-light border text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 0.9rem;">
                                    @(user.Email.Length > 0 ? user.Email[0].ToString().ToUpper() : "U")
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">@user.Email</div>
                                    <small class="text-muted font-monospace">@user.Id.ToString().Substring(0, 8)...</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            @foreach (var role in user.Roles)
                            {
                                <span class="badge badge-soft-primary me-1">@role</span>
                            }
                        </td>
                        <td>
                            @if (user.Status == UserStatus.Active)
                            {
                                <span class="badge badge-soft-success"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Active</span>
                            }
                            else
                            {
                                <span class="badge badge-soft-danger"><i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Inactive</span>
                            }
                        </td>
                        <td class="text-muted">
                            @(user.LastLoginAtUtc?.ToString("MMM dd, yyyy HH:mm") ?? "Never logged in")
                        </td>
                        <td class="text-muted">
                            @user.CreatedAtUtc.ToString("MMM dd, yyyy")
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary" title="Edit User">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-warning" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </a>
                                @if (user.Status == UserStatus.Active)
                                {
                                    <form asp-action="SetStatus" asp-route-id="@user.Id" asp-route-status="@UserStatus.Inactive" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to deactivate @user.Email?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate User">
                                            <i class="bi bi-person-x"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="SetStatus" asp-route-id="@user.Id" asp-route-status="@UserStatus.Active" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Activate User">
                                            <i class="bi bi-person-check"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
