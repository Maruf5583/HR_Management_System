@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
    var roles = ViewBag.Roles as List<string> ?? new List<string>();
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
        <div class="card-modern p-4 p-md-5">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-icon" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark tracking-tight">Edit User Account</h4>
                        <p class="text-muted small mb-0">Update login credentials and assigned security role</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-secondary-modern btn-sm" title="Back to user list">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>

            <!-- Current Status Notice -->
            <div class="bg-light p-3 rounded-3 border mb-4 d-flex justify-content-between align-items-center">
                <div>
                    <small class="text-muted d-block">Account Reference ID</small>
                    <span class="font-monospace text-dark small fw-semibold">@Model.Id</span>
                </div>
                <div>
                    @if (Model.Status == UserStatus.Active)
                    {
                        <span class="badge badge-soft-success">
                            <span class="status-dot status-dot-active"></span> Active
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-soft-danger">
                            <span class="status-dot status-dot-inactive"></span> Inactive
                        </span>
                    }
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 shadow-sm small py-2 px-3 mb-4 d-flex align-items-center gap-2" style="border-radius: 10px; background-color: #fef2f2; color: #991b1b; border-left: 3px solid #ef4444 !important;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                </div>
            }

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Status" />

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="RoleName" class="form-label">Assigned Role <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-shield-check"></i></span>
                        <select asp-for="RoleName" class="form-select">
                            <option value="">-- Choose Security Role --</option>
                            @foreach (var role in roles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>
                    <span asp-validation-for="RoleName" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a asp-action="Index" class="btn btn-secondary-modern">Cancel</a>
                    <button type="submit" class="btn btn-primary-modern">
                        <i class="bi bi-check-lg"></i>
                        <span>Save Changes</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
