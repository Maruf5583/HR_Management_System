@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card-modern p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-key me-2 text-warning"></i>Reset Password</h5>
                    <p class="text-muted small mb-0">Set a new password for @Model.Email</p>
                </div>
                <a asp-action="Index" class="btn btn-secondary-modern btn-sm">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="••••••••" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-action="Index" class="btn btn-secondary-modern">Cancel</a>
                    <button type="submit" class="btn btn-warning fw-semibold px-3">Reset Password</button>
                </div>
            </form>
        </div>
    </div>
</div>
