@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset User Password";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card-modern p-4 p-md-5">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="kpi-icon-box bg-warning-subtle text-warning" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark tracking-tight">Reset Password</h4>
                        <p class="text-muted small mb-0">Override login credentials</p>
                    </div>
                </div>
                <a asp-action="Index" class="btn btn-secondary-modern btn-sm" title="Back to user list">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>

            <!-- Target User Banner -->
            <div class="bg-light p-3 rounded-3 border mb-4">
                <small class="text-muted d-block">Target Account</small>
                <div class="d-flex align-items-center gap-2 mt-1">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold" style="width: 26px; height: 26px; font-size: 0.75rem;">
                        @(Model.Email.Length > 0 ? Model.Email[0].ToString().ToUpper() : "U")
                    </div>
                    <strong class="text-dark">@Model.Email</strong>
                </div>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 shadow-sm small py-2 px-3 mb-4 d-flex align-items-center gap-2" style="border-radius: 10px; background-color: #fef2f2; color: #991b1b; border-left: 3px solid #ef4444 !important;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="Email" />

                <div class="mb-4">
                    <label asp-for="NewPassword" class="form-label">New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" autofocus />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    <small class="text-muted" style="font-size: 0.76rem;">Minimum 6 characters. The user must use this new password immediately.</small>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a asp-action="Index" class="btn btn-secondary-modern">Cancel</a>
                    <button type="submit" class="btn btn-warning fw-semibold px-4 text-dark shadow-sm">
                        <i class="bi bi-key-fill me-1"></i>
                        <span>Confirm Reset</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
