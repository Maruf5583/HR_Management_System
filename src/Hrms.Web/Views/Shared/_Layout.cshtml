@inject Hrms.Settings.Contracts.ISettingsReader SettingsReader
@inject Hrms.Leave.Application.Queries.Approvals.IGetApprovalsHandler ApprovalsHandler
@inject Hrms.Employees.Contracts.IEmployeeLookup EmployeeLookup
@inject Hrms.Employees.Application.Services.IBankDetailService BankDetailService
@{
    string companyName = "HRMS";
    string? companyLogo = null;
    string? companyFavicon = null;
    string? userPhotoKey = null;
    try
    {
        var configuredName = await SettingsReader.GetStringAsync(Hrms.Settings.Contracts.SettingKeys.CompanyName);
        if (!string.IsNullOrWhiteSpace(configuredName))
        {
            companyName = configuredName;
        }
    }
    catch
    {
        // Fallback default
    }

    try
    {
        companyLogo = await SettingsReader.GetStringAsync(Hrms.Settings.Contracts.SettingKeys.CompanyLogo);
    }
    catch
    {
        // Optional setting
    }

    try
    {
        companyFavicon = await SettingsReader.GetStringAsync(Hrms.Settings.Contracts.SettingKeys.CompanyFavicon);
    }
    catch
    {
        // Optional setting
    }

    if (CurrentUser.IsAuthenticated)
    {
        try
        {
            userPhotoKey = await EmployeeLookup.GetPhotoKeyForUserAsync(CurrentUser.EmployeeId, CurrentUser.Email);
        }
        catch
        {
            // Fallback default
        }
    }

    string? photoUrl = null;
    if (!string.IsNullOrWhiteSpace(userPhotoKey))
    {
        userPhotoKey = userPhotoKey.Trim();
        photoUrl = userPhotoKey.StartsWith("/") || userPhotoKey.StartsWith("http")
            ? userPhotoKey
            : "/" + (userPhotoKey.StartsWith("uploads/") ? userPhotoKey : "uploads/" + userPhotoKey);
    }

    int pendingBankApprovalsCount = 0;
    if (CurrentUser.IsAuthenticated && CurrentUser.HasPermission(Permissions.Employees.Manage))
    {
        try
        {
            pendingBankApprovalsCount = await BankDetailService.GetPendingCountAsync();
        }
        catch
        {
            // Fallback
        }
    }

    int pendingApprovalsCount = 0;
    if (CurrentUser.IsAuthenticated && CurrentUser.HasPermission(Permissions.Leave.Approve))
    {
        try
        {
            pendingApprovalsCount = await ApprovalsHandler.GetPendingCountAsync();
        }
        catch
        {
            // Fallback
        }
    }

    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var userInitial = !string.IsNullOrEmpty(CurrentUser.Email) ? CurrentUser.Email.Substring(0, 1).ToUpper() : "U";
    var userRoleTitle = CurrentUser.IsInRole("Admin") ? "System Admin" : (CurrentUser.IsInRole("HR") ? "HR Manager" : "Staff Employee");
    var isPeopleActive = (currentArea == "Employees" && currentAction != "MyProfile") || (currentArea == "Assets" && currentAction != "My");
    var isTimeActive = currentArea == "Calendar";
    var isAttendanceActive = currentArea == "Attendance" && currentController != "MyAttendance";
    var isLeaveActive = currentArea == "Leave" && currentController != "MyLeave";
    var isReportsActive = currentArea == "Reports";
    var isAdminActive = currentArea == "Audit" || currentArea == "Settings" || currentController == "Users" || currentController == "Roles";
    var isMeActive = (currentArea == "Employees" && currentAction == "MyProfile") || (currentArea == "Assets" && currentAction == "My") || (currentArea == "Attendance" && currentController == "MyAttendance") || (currentArea == "Leave" && currentController == "MyLeave");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @companyName</title>
    @if (!string.IsNullOrEmpty(companyFavicon))
    {
        <link rel="icon" href="@companyFavicon" />
    }
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&family=Outfit:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 @(CurrentUser.IsAuthenticated ? "app-shell-active" : "")">
    @if (CurrentUser.IsAuthenticated)
    {
        <!-- Mobile Sidebar Backdrop -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="app-shell d-flex w-100 min-vh-100">
            <!-- Left Modern Sidebar Navigation -->
            <aside class="app-sidebar" id="appSidebar">
            <!-- Sidebar Header & Brand -->
            <div class="sidebar-header">
                <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    @if (!string.IsNullOrEmpty(companyLogo))
                    {
                        <img src="@companyLogo" alt="@companyName" class="brand-logo-img me-2" style="max-height: 38px; max-width: 140px; object-fit: contain;" />
                    }
                    else
                    {
                        <span class="brand-icon-box">
                            <i class="bi bi-stack"></i>
                        </span>
                        <span class="fw-bold tracking-tight">@companyName</span>
                    }
                </a>
                <button type="button" class="btn btn-sm btn-light border-0 d-lg-none" id="mobileSidebarClose" title="Close menu" style="width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; border-radius: 8px;">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Sidebar Navigation Links -->
            <div class="sidebar-body">
                <!-- General Section -->
                <ul class="sidebar-nav">
                    <li class="sidebar-nav-item">
                        <a class="sidebar-nav-link @(string.IsNullOrEmpty(currentArea) && currentController == "Home" ? "active" : "")"
                           asp-area="" asp-controller="Home" asp-action="Index"
                           title="Dashboard">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                </ul>

                <!-- ME (Personal Profile & Self Service) -->
                @if (CurrentUser.HasPermission(Permissions.Employees.ViewOwn))
                {
                    <div class="sidebar-section-label">MY WORKSPACE</div>
                    <ul class="sidebar-nav">
                        <li class="sidebar-nav-item">
                            <a class="sidebar-nav-link sidebar-parent-link @(isMeActive ? "active-parent" : "")"
                               data-bs-toggle="collapse"
                               href="javascript:void(0)"
                               data-bs-target="#myHubSubmenu"
                               role="button"
                               aria-expanded="@(isMeActive ? "true" : "false")"
                               aria-controls="myHubSubmenu"
                               title="My Profile &amp; Hub">
                                <i class="bi bi-person-badge"></i>
                                <span class="sidebar-nav-text">My Profile &amp; Hub</span>
                            </a>
                            <div class="collapse @(isMeActive ? "show" : "")" id="myHubSubmenu">
                                <ul class="sidebar-subnav">
                                    <li>
                                        <a class="sidebar-sublink @(currentArea == "Employees" && currentController == "Employees" && currentAction == "MyProfile" ? "active" : "")"
                                           asp-area="Employees" asp-controller="Employees" asp-action="MyProfile">
                                            <i class="bi bi-person"></i>
                                            <span>My Profile</span>
                                        </a>
                                    </li>
                                    @if (CurrentUser.HasPermission(Permissions.Assets.ViewOwn))
                                    {
                                        <li>
                                            <a class="sidebar-sublink @(currentArea == "Assets" && currentController == "Assets" && currentAction == "My" ? "active" : "")"
                                               asp-area="Assets" asp-controller="Assets" asp-action="My">
                                                <i class="bi bi-laptop"></i>
                                                <span>My Assets</span>
                                            </a>
                                        </li>
                                    }
                                    @if (CurrentUser.HasPermission(Permissions.Attendance.ViewOwn))
                                    {
                                        <li>
                                            <a class="sidebar-sublink @(currentArea == "Attendance" && currentController == "MyAttendance" ? "active" : "")"
                                               asp-area="Attendance" asp-controller="MyAttendance" asp-action="Index">
                                                <i class="bi bi-clock"></i>
                                                <span>My Attendance</span>
                                            </a>
                                        </li>
                                    }
                                    @if (CurrentUser.HasPermission(Permissions.Leave.ViewOwn))
                                    {
                                        <li>
                                            <a class="sidebar-sublink @(currentArea == "Leave" && currentController == "MyLeave" ? "active" : "")"
                                               asp-area="Leave" asp-controller="MyLeave" asp-action="Index">
                                                <i class="bi bi-calendar2-check"></i>
                                                <span>My Leave</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </div>
                        </li>
                    </ul>
                }

                @if (!CurrentUser.IsInRole("Employee") || CurrentUser.HasPermission(Permissions.Employees.View) || CurrentUser.HasPermission(Permissions.Employees.Manage) || CurrentUser.HasPermission(Permissions.Assets.Manage))
                {
                    <div class="sidebar-section-label">ORGANIZATION &amp; OPS</div>
                    <ul class="sidebar-nav">
                        <!-- PEOPLE & ORGANIZATION (Collapsible) -->
                        @if (CurrentUser.HasPermission(Permissions.Employees.View) || CurrentUser.HasPermission(Permissions.Employees.Manage) || CurrentUser.HasPermission(Permissions.Assets.Manage))
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link sidebar-parent-link @(isPeopleActive ? "active-parent" : "")"
                                   data-bs-toggle="collapse"
                                   href="javascript:void(0)"
                                   data-bs-target="#peopleSubmenu"
                                   role="button"
                                   aria-expanded="@(isPeopleActive ? "true" : "false")"
                                   aria-controls="peopleSubmenu"
                                   title="People &amp; Org">
                                    <i class="bi bi-people"></i>
                                    <span class="sidebar-nav-text">People &amp; Org</span>
                                </a>
                                <div class="collapse @(isPeopleActive ? "show" : "")" id="peopleSubmenu">
                                    <ul class="sidebar-subnav">
                                        @if (CurrentUser.HasPermission(Permissions.Employees.View))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Employees" && currentController == "Employees" && currentAction == "Index" ? "active" : "")"
                                                   asp-area="Employees" asp-controller="Employees" asp-action="Index">
                                                    <i class="bi bi-people"></i>
                                                    <span>Employees</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Employees.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Employees" && currentController == "Departments" ? "active" : "")"
                                                   asp-area="Employees" asp-controller="Departments" asp-action="Index">
                                                    <i class="bi bi-building"></i>
                                                    <span>Departments</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Employees" && currentController == "Designations" ? "active" : "")"
                                                   asp-area="Employees" asp-controller="Designations" asp-action="Index">
                                                    <i class="bi bi-person-badge"></i>
                                                    <span>Designations</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Employees" && currentController == "Grades" ? "active" : "")"
                                                   asp-area="Employees" asp-controller="Grades" asp-action="Index">
                                                    <i class="bi bi-sort-numeric-up"></i>
                                                    <span>Grades &amp; Scales</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Employees" && currentController == "BankApprovals" ? "active" : "")"
                                                   asp-area="Employees" asp-controller="BankApprovals" asp-action="Index">
                                                    <i class="bi bi-bank"></i>
                                                    <span>Bank Approvals</span>
                                                    @if (pendingBankApprovalsCount > 0)
                                                    {
                                                        <span class="badge bg-danger rounded-pill ms-auto px-2">@pendingBankApprovalsCount</span>
                                                    }
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Assets.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Assets" && currentController == "Assets" && currentAction == "Index" ? "active" : "")"
                                                   asp-area="Assets" asp-controller="Assets" asp-action="Index">
                                                    <i class="bi bi-box-seam"></i>
                                                    <span>Asset Inventory</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        }

                        <!-- TIME & SCHEDULE (Collapsible) -->
                        @if (CurrentUser.HasPermission(Permissions.Shifts.Manage) || CurrentUser.HasPermission(Permissions.Holidays.Manage) || (!CurrentUser.IsInRole("Employee") && CurrentUser.HasPermission(Permissions.Holidays.View)))
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link sidebar-parent-link @(isTimeActive ? "active-parent" : "")"
                                   data-bs-toggle="collapse"
                                   href="javascript:void(0)"
                                   data-bs-target="#timeSubmenu"
                                   role="button"
                                   aria-expanded="@(isTimeActive ? "true" : "false")"
                                   aria-controls="timeSubmenu"
                                   title="Time &amp; Schedule">
                                    <i class="bi bi-calendar3-range"></i>
                                    <span class="sidebar-nav-text">Time &amp; Schedule</span>
                                </a>
                                <div class="collapse @(isTimeActive ? "show" : "")" id="timeSubmenu">
                                    <ul class="sidebar-subnav">
                                        @if (CurrentUser.HasPermission(Permissions.Shifts.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Calendar" && currentController == "Shifts" ? "active" : "")"
                                                   asp-area="Calendar" asp-controller="Shifts" asp-action="Index">
                                                    <i class="bi bi-clock-history"></i>
                                                    <span>Work Shifts</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Calendar" && currentController == "ShiftAssignments" ? "active" : "")"
                                                   asp-area="Calendar" asp-controller="ShiftAssignments" asp-action="Index">
                                                    <i class="bi bi-person-lines-fill"></i>
                                                    <span>Shift Assignments</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Holidays.View))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Calendar" && currentController == "Holidays" ? "active" : "")"
                                                   asp-area="Calendar" asp-controller="Holidays" asp-action="Index">
                                                    <i class="bi bi-calendar-event"></i>
                                                    <span>Holidays</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Calendar" && currentController == "WorkingDays" ? "active" : "")"
                                                   asp-area="Calendar" asp-controller="WorkingDays" asp-action="Index">
                                                    <i class="bi bi-calendar2-week"></i>
                                                    <span>Working Days</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        }

                        <!-- ATTENDANCE (Collapsible) -->
                        @if (CurrentUser.HasPermission(Permissions.Attendance.ViewAll) || CurrentUser.HasPermission(Permissions.Attendance.Manage))
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link sidebar-parent-link @(isAttendanceActive ? "active-parent" : "")"
                                   data-bs-toggle="collapse"
                                   href="javascript:void(0)"
                                   data-bs-target="#attendanceSubmenu"
                                   role="button"
                                   aria-expanded="@(isAttendanceActive ? "true" : "false")"
                                   aria-controls="attendanceSubmenu"
                                   title="Attendance">
                                    <i class="bi bi-clock-history"></i>
                                    <span class="sidebar-nav-text">Attendance</span>
                                </a>
                                <div class="collapse @(isAttendanceActive ? "show" : "")" id="attendanceSubmenu">
                                    <ul class="sidebar-subnav">
                                        @if (CurrentUser.HasPermission(Permissions.Attendance.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Attendance" && currentController == "DailySheet" ? "active" : "")"
                                                   asp-area="Attendance" asp-controller="DailySheet" asp-action="Index">
                                                    <i class="bi bi-calendar-check"></i>
                                                    <span>Daily Sheet</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Attendance" && currentController == "Approvals" ? "active" : "")"
                                                   asp-area="Attendance" asp-controller="Approvals" asp-action="Index">
                                                    <i class="bi bi-check2-circle"></i>
                                                    <span>Approvals</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Attendance.ViewAll))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Attendance" && currentController == "Monthly" ? "active" : "")"
                                                   asp-area="Attendance" asp-controller="Monthly" asp-action="Index">
                                                    <i class="bi bi-grid-3x3"></i>
                                                    <span>Monthly Sheet</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        }

                        <!-- LEAVE MANAGEMENT (Collapsible) -->
                        @if (CurrentUser.HasPermission(Permissions.Leave.Approve) || CurrentUser.HasPermission(Permissions.Leave.ViewAll) || CurrentUser.HasPermission(Permissions.Leave.Manage))
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link sidebar-parent-link @(isLeaveActive ? "active-parent" : "")"
                                   data-bs-toggle="collapse"
                                   href="javascript:void(0)"
                                   data-bs-target="#leaveSubmenu"
                                   role="button"
                                   aria-expanded="@(isLeaveActive ? "true" : "false")"
                                   aria-controls="leaveSubmenu"
                                   title="Leave">
                                    <i class="bi bi-calendar2-check"></i>
                                    <span class="sidebar-nav-text">Leave</span>
                                    @if (pendingApprovalsCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill px-2 ms-auto" style="font-size: 0.68rem;">@pendingApprovalsCount</span>
                                    }
                                </a>
                                <div class="collapse @(isLeaveActive ? "show" : "")" id="leaveSubmenu">
                                    <ul class="sidebar-subnav">
                                        @if (CurrentUser.HasPermission(Permissions.Leave.Approve))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Leave" && currentController == "Approvals" ? "active" : "")"
                                                   asp-area="Leave" asp-controller="Approvals" asp-action="Index">
                                                    <i class="bi bi-clipboard-check"></i>
                                                    <span>Approvals</span>
                                                    @if (pendingApprovalsCount > 0)
                                                    {
                                                        <span class="badge bg-danger rounded-pill ms-auto px-2">@pendingApprovalsCount</span>
                                                    }
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Leave.ViewAll))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Leave" && currentController == "LeaveRecords" ? "active" : "")"
                                                   asp-area="Leave" asp-controller="LeaveRecords" asp-action="Index">
                                                    <i class="bi bi-calendar2-range"></i>
                                                    <span>Leave Records</span>
                                                </a>
                                            </li>
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Leave" && currentController == "LeaveBalances" ? "active" : "")"
                                                   asp-area="Leave" asp-controller="LeaveBalances" asp-action="Index">
                                                    <i class="bi bi-wallet2"></i>
                                                    <span>Leave Balances</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Leave.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Leave" && currentController == "LeaveTypes" ? "active" : "")"
                                                   asp-area="Leave" asp-controller="LeaveTypes" asp-action="Index">
                                                    <i class="bi bi-tags"></i>
                                                    <span>Leave Types</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        }

                        <!-- REPORTS & ANALYTICS (Collapsible) -->
                        @if (CurrentUser.HasPermission(Permissions.Reports.View))
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link sidebar-parent-link @(isReportsActive ? "active-parent" : "")"
                                   data-bs-toggle="collapse"
                                   href="javascript:void(0)"
                                   data-bs-target="#reportsSubmenu"
                                   role="button"
                                   aria-expanded="@(isReportsActive ? "true" : "false")"
                                   aria-controls="reportsSubmenu"
                                   title="Reports">
                                    <i class="bi bi-bar-chart"></i>
                                    <span class="sidebar-nav-text">Reports</span>
                                </a>
                                <div class="collapse @(isReportsActive ? "show" : "")" id="reportsSubmenu">
                                    <ul class="sidebar-subnav">
                                        <li>
                                            <a class="sidebar-sublink @(currentArea == "Reports" && currentController == "Reports" ? "active" : "")"
                                               asp-area="Reports" asp-controller="Reports" asp-action="Index">
                                                <i class="bi bi-file-earmark-bar-graph"></i>
                                                <span>Reports Center</span>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </li>
                        }

                        <!-- ADMINISTRATION & SYSTEM (Collapsible) -->
                        @if (CurrentUser.HasPermission(Permissions.Users.Manage) || CurrentUser.HasPermission(Permissions.Roles.Manage) || CurrentUser.HasPermission(Permissions.Audit.View) || CurrentUser.HasPermission(Permissions.Settings.Manage))
                        {
                            <li class="sidebar-nav-item">
                                <a class="sidebar-nav-link sidebar-parent-link @(isAdminActive ? "active-parent" : "")"
                                   data-bs-toggle="collapse"
                                   href="javascript:void(0)"
                                   data-bs-target="#adminSubmenu"
                                   role="button"
                                   aria-expanded="@(isAdminActive ? "true" : "false")"
                                   aria-controls="adminSubmenu"
                                   title="Administration">
                                    <i class="bi bi-gear"></i>
                                    <span class="sidebar-nav-text">Administration</span>
                                </a>
                                <div class="collapse @(isAdminActive ? "show" : "")" id="adminSubmenu">
                                    <ul class="sidebar-subnav">
                                        @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(string.IsNullOrEmpty(currentArea) && currentController == "Users" ? "active" : "")"
                                                   asp-area="" asp-controller="Users" asp-action="Index">
                                                    <i class="bi bi-person-gear"></i>
                                                    <span>Users</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Roles.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(string.IsNullOrEmpty(currentArea) && currentController == "Roles" ? "active" : "")"
                                                   asp-area="" asp-controller="Roles" asp-action="Index">
                                                    <i class="bi bi-shield-check"></i>
                                                    <span>Roles &amp; Permissions</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Audit.View))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Audit" && currentController == "Audit" ? "active" : "")"
                                                   asp-area="Audit" asp-controller="Audit" asp-action="Index">
                                                    <i class="bi bi-journal-text"></i>
                                                    <span>Audit Logs</span>
                                                </a>
                                            </li>
                                        }
                                        @if (CurrentUser.HasPermission(Permissions.Settings.Manage))
                                        {
                                            <li>
                                                <a class="sidebar-sublink @(currentArea == "Settings" && currentController == "Settings" ? "active" : "")"
                                                   asp-area="Settings" asp-controller="Settings" asp-action="Index">
                                                    <i class="bi bi-gear"></i>
                                                    <span>Settings</span>
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>

            <!-- Sidebar User Profile Footer (Static display, no dropdown) -->
            <div class="sidebar-footer">
                <div class="sidebar-user-card" style="cursor: default;">
                    @if (!string.IsNullOrWhiteSpace(photoUrl))
                    {
                        <img src="@photoUrl" alt="@CurrentUser.Email" class="rounded-circle shadow-sm" style="width: 36px; height: 36px; object-fit: cover; border: 2px solid #e2e8f0;" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                        <div class="sidebar-user-avatar d-none">
                            @userInitial
                        </div>
                    }
                    else
                    {
                        <div class="sidebar-user-avatar">
                            @userInitial
                        </div>
                    }
                    <div class="sidebar-user-info text-truncate flex-grow-1">
                        <div class="fw-semibold text-dark small text-truncate" style="line-height: 1.2;">@CurrentUser.Email</div>
                        <div class="text-muted" style="font-size: 0.72rem;">@userRoleTitle</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- Main Layout Area (Right side of Sidebar) -->
        <div class="app-wrapper">
            <!-- Top Navigation Bar -->
            <header class="app-topbar">
                <div class="topbar-left d-flex align-items-center gap-2.5">
                    <button type="button" class="sidebar-toggle-btn" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="bi bi-list"></i>
                    </button>
                    <div>
                        <h5 class="topbar-page-title mb-0" style="font-size: 0.95rem; font-weight: 600;">@(ViewData["Title"] ?? "Dashboard")</h5>
                        @if (ViewData["Subtitle"] != null)
                        {
                            <div class="topbar-page-subtitle text-muted d-none d-md-block" style="font-size: 0.73rem; line-height: 1.2;">@ViewData["Subtitle"]</div>
                        }
                    </div>
                </div>

                <div class="topbar-right">
                    <!-- Search Input Pill with Shortcut Badge -->
                    <div class="topbar-search-box d-none d-sm-block">
                        <i class="bi bi-search search-icon"></i>
                        <input type="text" class="topbar-search-input" id="globalSearchInput" placeholder="Search..." />
                        <span class="topbar-search-shortcut">⌘K</span>
                    </div>

                    <!-- Notification Bell Dropdown -->
                    <div class="dropdown me-1" id="notificationDropdownContainer">
                        <button type="button" class="topbar-action-icon-btn position-relative" id="notificationBellBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="bi bi-bell"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="notificationBadge" style="font-size: 0.65rem;">
                                0
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 mt-2" style="width: 320px; max-width: calc(100vw - 2rem); border-radius: 14px; overflow: hidden;">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 bg-light border-bottom">
                                <span class="fw-bold small text-dark"><i class="bi bi-bell me-1 text-primary"></i>Notifications</span>
                                <button type="button" class="btn btn-link btn-sm text-decoration-none p-0 small text-primary" id="markAllReadBtn" style="font-size: 0.75rem;">Mark all as read</button>
                            </div>
                            <div id="notificationList" style="max-height: 320px; overflow-y: auto;">
                                <div class="text-center py-4 text-muted small" id="noNotificationsMsg">
                                    <i class="bi bi-bell-slash fs-4 d-block mb-1 text-muted"></i>
                                    No notifications
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- User Avatar Pill Dropdown -->
                    <div class="dropdown">
                        <button class="btn p-0 border-0 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            @if (!string.IsNullOrWhiteSpace(photoUrl))
                            {
                                <img src="@photoUrl" alt="@CurrentUser.Email" class="rounded-circle shadow-sm" style="width: 38px; height: 38px; object-fit: cover; border: 2px solid #e2e8f0;" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                                <div class="sidebar-user-avatar d-none" style="width: 38px; height: 38px; border-radius: 50%;">
                                    @userInitial
                                </div>
                            }
                            else
                            {
                                <div class="sidebar-user-avatar" style="width: 38px; height: 38px; border-radius: 50%;">
                                    @userInitial
                                </div>
                            }
                            <div class="d-none d-xl-block text-start">
                                <div class="fw-semibold text-dark small" style="line-height: 1.1;">@CurrentUser.Email</div>
                                <div class="text-muted" style="font-size: 0.72rem;">@userRoleTitle</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 py-2" style="border-radius: 12px; min-width: 220px; max-width: calc(100vw - 2rem);">
                            <li class="px-3 py-2 border-bottom d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(photoUrl))
                                {
                                    <img src="@photoUrl" alt="@CurrentUser.Email" class="rounded-circle shadow-sm" style="width: 36px; height: 36px; object-fit: cover; border: 1px solid #e2e8f0;" onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none');" />
                                    <div class="sidebar-user-avatar d-none" style="width: 36px; height: 36px; border-radius: 50%; font-size: 0.85rem;">
                                        @userInitial
                                    </div>
                                }
                                else
                                {
                                    <div class="sidebar-user-avatar" style="width: 36px; height: 36px; border-radius: 50%; font-size: 0.85rem;">
                                        @userInitial
                                    </div>
                                }
                                <div class="overflow-hidden">
                                    <small class="text-muted d-block" style="font-size: 0.7rem;">Signed in as</small>
                                    <strong class="d-block text-truncate text-dark" style="max-width: 150px; font-size: 0.82rem;">@CurrentUser.Email</strong>
                                </div>
                            </li>
                            @if (CurrentUser.HasPermission(Permissions.Employees.ViewOwn))
                            {
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Employees" asp-controller="Employees" asp-action="MyProfile">
                                        <i class="bi bi-person text-muted"></i>
                                        <span>My Profile</span>
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="bi bi-key text-muted"></i>
                                    <span>Change Password</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item py-2 text-danger d-flex align-items-center gap-2">
                                        <i class="bi bi-box-arrow-right"></i>
                                        <span>Sign Out</span>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Page Main Body -->
            <main class="flex-grow-1 p-3 p-lg-4 app-main-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border-0 shadow-sm d-flex align-items-center justify-content-between mb-4 fade show" role="alert" style="border-radius: 12px; background-color: #ecfdf3; color: #027a48; border-left: 4px solid #12b76a !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span class="fw-semibold">@TempData["SuccessMessage"]</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center justify-content-between mb-4 fade show" role="alert" style="border-radius: 12px; background-color: #fef3f2; color: #b42318; border-left: 4px solid #f04438 !important;">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                            <span class="fw-semibold">@TempData["ErrorMessage"]</span>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>
    }
    else
    {
        <!-- Unauthenticated View Container -->
        <main class="flex-grow-1">
            @RenderBody()
        </main>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('appSidebar');
            const toggleBtn = document.getElementById('sidebarToggle');
            const backdrop = document.getElementById('sidebarBackdrop');
            const mobileCloseBtn = document.getElementById('mobileSidebarClose');
            const searchInput = document.getElementById('globalSearchInput');

            if (toggleBtn && sidebar) {
                // Restore desktop sidebar collapsed state
                if (window.innerWidth >= 992 && localStorage.getItem('sidebar_collapsed') === 'true') {
                    document.body.classList.add('sidebar-collapsed');
                }

                toggleBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (window.innerWidth < 992) {
                        // Mobile: toggle drawer
                        sidebar.classList.toggle('show');
                        if (backdrop) backdrop.classList.toggle('show');
                    } else {
                        // Desktop: toggle collapsed/hidden sidebar
                        document.body.classList.toggle('sidebar-collapsed');
                        localStorage.setItem('sidebar_collapsed', document.body.classList.contains('sidebar-collapsed') ? 'true' : 'false');
                    }
                });

                // When sidebar is collapsed in desktop mini mode, clicking it (or its items) expands it back to full width
                sidebar.addEventListener('click', function (e) {
                    if (window.innerWidth >= 992 && document.body.classList.contains('sidebar-collapsed')) {
                        document.body.classList.remove('sidebar-collapsed');
                        localStorage.setItem('sidebar_collapsed', 'false');
                    }
                });
            }

            if (mobileCloseBtn && sidebar) {
                mobileCloseBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    sidebar.classList.remove('show');
                    if (backdrop) backdrop.classList.remove('show');
                });
            }

            if (backdrop) {
                backdrop.addEventListener('click', function () {
                    if (sidebar) sidebar.classList.remove('show');
                    backdrop.classList.remove('show');
                });
            }

            // Global Select Form Dropdown Helper
            window.selectFormDropdown = function (hiddenInputId, labelId, value, text, btnId) {
                const input = document.getElementById(hiddenInputId);
                if (input) {
                    input.value = value;
                    input.dispatchEvent(new Event('change', { bubbles: true }));
                }
                const label = document.getElementById(labelId);
                if (label) label.innerText = text;
                if (btnId) {
                    const btn = document.getElementById(btnId);
                    if (btn) {
                        const dropdown = bootstrap.Dropdown.getInstance(btn) || new bootstrap.Dropdown(btn);
                        dropdown.hide();
                    }
                }
            };

            // Keyboard shortcut Ctrl+K / Cmd+K to focus search input
            window.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    if (searchInput) {
                        e.preventDefault();
                        searchInput.focus();
                    }
                }
            });

            // Notifications Polling & UI
            async function loadNotifications() {
                try {
                    const res = await fetch('/Notifications/GetSummary');
                    if (!res.ok) return;
                    const data = await res.json();
                    const badge = document.getElementById('notificationBadge');
                    const list = document.getElementById('notificationList');

                    if (badge) {
                        if (data.unreadCount > 0) {
                            badge.textContent = data.unreadCount > 99 ? '99+' : data.unreadCount;
                            badge.classList.remove('d-none');
                        } else {
                            badge.classList.add('d-none');
                        }
                    }

                    if (list && data.items) {
                        if (data.items.length === 0) {
                            list.innerHTML = `<div class="text-center py-4 text-muted small"><i class="bi bi-bell-slash fs-4 d-block mb-1 text-muted"></i>No notifications</div>`;
                        } else {
                            let html = '';
                            data.items.forEach(item => {
                                const bg = item.isRead ? 'bg-white' : 'bg-primary-subtle bg-opacity-25';
                                const link = item.linkUrl || '#';
                                html += `
                                    <a href="${link}" class="d-block text-decoration-none p-3 border-bottom notification-item ${bg}">
                                        <div class="d-flex justify-content-between align-items-start mb-1">
                                            <strong class="text-dark small" style="font-size: 0.82rem;">${item.title}</strong>
                                            <span class="text-muted" style="font-size: 0.7rem;">${item.timeAgo}</span>
                                        </div>
                                        <p class="text-muted small mb-0" style="font-size: 0.78rem; line-height: 1.3;">${item.message}</p>
                                    </a>
                                `;
                            });
                            list.innerHTML = html;
                        }
                    }
                } catch (e) {
                    console.error('Failed to load notifications', e);
                }
            }

            loadNotifications();
            setInterval(loadNotifications, 30000);

            const markAllBtn = document.getElementById('markAllReadBtn');
            if (markAllBtn) {
                markAllBtn.addEventListener('click', async function (e) {
                    e.preventDefault();
                    e.stopPropagation();
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                    await fetch('/Notifications/MarkAllAsRead', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/x-www-form-urlencoded'
                        }
                    });
                    loadNotifications();
                });
            }

            // Universal Searchable Dropdowns Engine
            // 1. Prevent dropdown close when clicking inside the search box
            document.addEventListener('click', function (e) {
                if (e.target.closest('.filter-dropdown-search')) {
                    e.stopPropagation();
                }
            });

            // 2. Real-time filter items on input
            document.addEventListener('input', function (e) {
                if (e.target.classList.contains('filter-dropdown-search-input')) {
                    const input = e.target;
                    const query = input.value.trim().toLowerCase();
                    const menu = input.closest('.filter-dropdown-menu');
                    if (!menu) return;

                    const list = menu.querySelector('.filter-dropdown-list') || menu;
                    const items = list.querySelectorAll('li:not(.filter-dropdown-search-item)');
                    let matchCount = 0;

                    items.forEach(li => {
                        const text = li.textContent.trim().toLowerCase();
                        if (!query || text.includes(query)) {
                            li.style.display = '';
                            matchCount++;
                        } else {
                            li.style.display = 'none';
                        }
                    });

                    let emptyMsg = menu.querySelector('.filter-dropdown-empty');
                    if (matchCount === 0) {
                        if (!emptyMsg) {
                            emptyMsg = document.createElement('div');
                            emptyMsg.className = 'filter-dropdown-empty';
                            emptyMsg.innerHTML = '<i class="bi bi-search d-block mb-1 text-muted"></i>No matching options';
                            list.appendChild(emptyMsg);
                        }
                        emptyMsg.style.display = 'block';
                    } else if (emptyMsg) {
                        emptyMsg.style.display = 'none';
                    }
                }
            });

            // 3. Auto-focus search input when dropdown opens
            document.addEventListener('shown.bs.dropdown', function (e) {
                const target = e.target;
                const menu = target.querySelector ? (target.querySelector('.filter-dropdown-menu') || target.nextElementSibling) : null;
                if (menu && menu.classList && menu.classList.contains('filter-dropdown-menu')) {
                    const searchInput = menu.querySelector('.filter-dropdown-search-input');
                    if (searchInput) {
                        searchInput.value = '';
                        const items = menu.querySelectorAll('li:not(.filter-dropdown-search-item)');
                        items.forEach(li => li.style.display = '');
                        const emptyMsg = menu.querySelector('.filter-dropdown-empty');
                        if (emptyMsg) emptyMsg.style.display = 'none';
                        setTimeout(() => searchInput.focus(), 60);
                    }
                }
            });

            // 4. Universal Auto-Close: Ensure only one dropdown remains open at a time across the entire application
            document.addEventListener('show.bs.dropdown', function (e) {
                const currentToggle = e.target;
                document.querySelectorAll('.dropdown-menu.show').forEach(menu => {
                    const parentDropdown = menu.closest('.dropdown');
                    const toggle = parentDropdown ? parentDropdown.querySelector('[data-bs-toggle="dropdown"]') : null;
                    if (toggle && toggle !== currentToggle) {
                        try {
                            const instance = bootstrap.Dropdown.getInstance(toggle);
                            if (instance) {
                                instance.hide();
                            }
                        } catch (err) {}
                        menu.classList.remove('show');
                        toggle.classList.remove('show');
                        toggle.setAttribute('aria-expanded', 'false');
                    }
                });
            });

            // 5. Global HRMS Confirmation Modal Handler
            window.hrmsConfirm = function (message, onConfirm, options = {}) {
                const modalEl = document.getElementById('globalConfirmModal');
                if (!modalEl) {
                    if (confirm(message)) onConfirm();
                    return;
                }
                document.getElementById('globalConfirmModalMessage').innerHTML = message;
                document.getElementById('globalConfirmModalTitleText').innerText = options.title || 'Confirm Action';
                const submitBtn = document.getElementById('globalConfirmModalSubmitBtn');
                submitBtn.className = options.btnClass || 'btn btn-sm btn-danger px-3 fw-semibold';
                submitBtn.innerText = options.btnText || 'Confirm';

                const bsModal = bootstrap.Modal.getOrCreateInstance(modalEl);
                
                const newSubmitBtn = submitBtn.cloneNode(true);
                submitBtn.parentNode.replaceChild(newSubmitBtn, submitBtn);

                newSubmitBtn.addEventListener('click', function () {
                    bsModal.hide();
                    if (typeof onConfirm === 'function') onConfirm();
                });

                bsModal.show();
            };

            // Intercept form submissions with data-confirm
            document.addEventListener('submit', function (e) {
                const form = e.target;
                const confirmMsg = form.getAttribute('data-confirm');
                if (confirmMsg && !form.dataset.confirmed) {
                    e.preventDefault();
                    window.hrmsConfirm(confirmMsg, () => {
                        form.dataset.confirmed = 'true';
                        form.submit();
                    }, {
                        title: form.getAttribute('data-confirm-title') || 'Confirm Action',
                        btnText: form.getAttribute('data-confirm-btn') || 'Confirm'
                    });
                }
            });

            // Intercept button/link clicks with data-confirm
            document.addEventListener('click', function (e) {
                const btn = e.target.closest('[data-confirm]');
                if (btn && btn.tagName === 'A' && !btn.dataset.confirmed) {
                    e.preventDefault();
                    window.hrmsConfirm(btn.getAttribute('data-confirm'), () => {
                        btn.dataset.confirmed = 'true';
                        window.location.href = btn.href;
                    }, {
                        title: btn.getAttribute('data-confirm-title') || 'Confirm Action',
                        btnText: btn.getAttribute('data-confirm-btn') || 'Confirm'
                    });
                }
            });
        });
    </script>

    <!-- Global Confirmation Modal -->
    <div class="modal fade" id="globalConfirmModal" tabindex="-1" aria-hidden="true" style="white-space: normal;">
        <div class="modal-dialog modal-dialog-centered text-start" style="max-width: 440px;">
            <div class="modal-content border-0 shadow" style="border-radius: 14px;">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-bold text-danger d-flex align-items-center gap-2" id="globalConfirmModalTitle">
                        <i class="bi bi-exclamation-triangle fs-5" id="globalConfirmModalIcon"></i>
                        <span id="globalConfirmModalTitleText">Confirm Action</span>
                    </h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3" style="white-space: normal; word-break: break-word;">
                    <p class="text-secondary mb-0" id="globalConfirmModalMessage" style="font-size: 0.95rem; line-height: 1.5;"></p>
                </div>
                <div class="modal-footer border-0 pt-0 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-sm btn-light px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-sm btn-danger px-3 fw-semibold" id="globalConfirmModalSubmitBtn">Confirm</button>
                </div>
            </div>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
