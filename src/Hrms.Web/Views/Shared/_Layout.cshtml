@inject Hrms.Settings.Contracts.ISettingsReader SettingsReader
@{
    string companyName = "HRMS";
    try
    {
        var configuredName = await SettingsReader.GetStringAsync(Hrms.Settings.Contracts.SettingKeys.CompanyName);
        if (!string.IsNullOrWhiteSpace(configuredName))
        {
            companyName = configuredName;
        }
    }
    catch
    {
        // Fallback to default
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @companyName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="d-flex flex-column min-vh-100">
    @if (CurrentUser.IsAuthenticated)
    {
        var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var userInitial = !string.IsNullOrEmpty(CurrentUser.Email) ? CurrentUser.Email.Substring(0, 1).ToUpper() : "U";

        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container-fluid px-lg-4 px-3">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon"><i class="bi bi-layers-fill"></i></span>
                    <span class="fw-bold tracking-tight">@companyName <span class="brand-badge ms-1">Enterprise Platform</span></span>
                </a>
                <button class="navbar-toggler border-0 shadow-none text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navContent">
                    <i class="bi bi-list fs-2"></i>
                </button>
                <div class="collapse navbar-collapse" id="navContent">
                    <ul class="navbar-nav me-auto ms-lg-3 gap-1">
                        <li class="nav-item">
                            <a class="nav-link @(string.IsNullOrEmpty(currentArea) && currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-1x2"></i> <span>Dashboard</span>
                            </a>
                        </li>
                        @if (CurrentUser.HasPermission(Permissions.Employees.View) || CurrentUser.HasPermission(Permissions.Employees.Manage))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentArea == "Employees" && currentAction != "MyProfile" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-people-fill"></i> <span>Employees</span>
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0 mt-2 py-2" style="border-radius: 14px; min-width: 210px;">
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Employees" asp-controller="Employees" asp-action="Index">
                                            <i class="bi bi-people text-primary"></i>
                                            <span>Employees Directory</span>
                                        </a>
                                    </li>
                                    @if (CurrentUser.HasPermission(Permissions.Employees.Manage))
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Employees" asp-controller="Departments" asp-action="Index">
                                                <i class="bi bi-building text-primary"></i>
                                                <span>Departments</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Employees" asp-controller="Designations" asp-action="Index">
                                                <i class="bi bi-person-badge text-primary"></i>
                                                <span>Designations</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Employees" asp-controller="Grades" asp-action="Index">
                                                <i class="bi bi-sort-numeric-up text-primary"></i>
                                                <span>Grades & Scales</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (CurrentUser.HasPermission(Permissions.Employees.ViewOwn))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentArea == "Employees" && currentController == "Employees" && currentAction == "MyProfile" ? "active" : "")" asp-area="Employees" asp-controller="Employees" asp-action="MyProfile">
                                    <i class="bi bi-person-circle"></i> <span>My Profile</span>
                                </a>
                            </li>
                        }
                        @if (CurrentUser.HasPermission(Permissions.Holidays.View) || CurrentUser.HasPermission(Permissions.Shifts.Manage) || CurrentUser.HasPermission(Permissions.Holidays.Manage))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(currentArea == "Calendar" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-calendar3"></i> <span>Calendar</span>
                                </a>
                                <ul class="dropdown-menu shadow-lg border-0 mt-2 py-2" style="border-radius: 14px; min-width: 220px;">
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Calendar" asp-controller="Holidays" asp-action="Index">
                                            <i class="bi bi-calendar-event text-primary"></i>
                                            <span>Holidays Calendar</span>
                                        </a>
                                    </li>
                                    @if (CurrentUser.HasPermission(Permissions.Shifts.Manage))
                                    {
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Calendar" asp-controller="Shifts" asp-action="Index">
                                                <i class="bi bi-clock-history text-primary"></i>
                                                <span>Work Shifts</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Calendar" asp-controller="ShiftAssignments" asp-action="Index">
                                                <i class="bi bi-person-lines-fill text-primary"></i>
                                                <span>Shift Assignments</span>
                                            </a>
                                        </li>
                                    }
                                    @if (CurrentUser.HasPermission(Permissions.Holidays.Manage))
                                    {
                                        <li><hr class="dropdown-divider my-1"></li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Calendar" asp-controller="WorkingDays" asp-action="Index">
                                                <i class="bi bi-calendar2-week text-primary"></i>
                                                <span>Working Days & Weekend</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(string.IsNullOrEmpty(currentArea) && currentController == "Users" ? "active" : "")" asp-area="" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-people"></i> <span>Users</span>
                                </a>
                            </li>
                        }
                        @if (CurrentUser.HasPermission(Permissions.Roles.Manage))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(string.IsNullOrEmpty(currentArea) && currentController == "Roles" ? "active" : "")" asp-area="" asp-controller="Roles" asp-action="Index">
                                    <i class="bi bi-shield-check"></i> <span>Roles & Permissions</span>
                                </a>
                            </li>
                        }
                        @if (CurrentUser.HasPermission(Permissions.Settings.Manage))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentArea == "Settings" && currentController == "Settings" ? "active" : "")" asp-area="Settings" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear"></i> <span>Settings</span>
                                </a>
                            </li>
                        }
                        @if (CurrentUser.HasPermission(Permissions.Audit.View))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentArea == "Audit" && currentController == "Audit" ? "active" : "")" asp-area="Audit" asp-controller="Audit" asp-action="Index">
                                    <i class="bi bi-clock-history"></i> <span>Audit Logs</span>
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-avatar-btn text-white d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <div class="avatar-circle">
                                    @userInitial
                                </div>
                                <div class="d-none d-md-block text-start">
                                    <div class="fw-semibold text-white small" style="line-height: 1.1;">@CurrentUser.Email</div>
                                    <div class="text-white-50" style="font-size: 0.72rem;">
                                        @if (CurrentUser.IsInRole("Admin"))
                                        {
                                            <span>System Admin</span>
                                        }
                                        else if (CurrentUser.IsInRole("HR"))
                                        {
                                            <span>HR Manager</span>
                                        }
                                        else
                                        {
                                            <span>Staff Employee</span>
                                        }
                                    </div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2 py-2" style="border-radius: 14px; min-width: 220px;">
                                <li class="px-3 py-2 border-bottom">
                                    <small class="text-muted d-block font-monospace">Signed in as</small>
                                    <strong class="d-block text-truncate text-dark" style="max-width: 190px;">@CurrentUser.Email</strong>
                                </li>
                                @if (CurrentUser.HasPermission(Permissions.Employees.ViewOwn))
                                {
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="Employees" asp-controller="Employees" asp-action="MyProfile">
                                            <i class="bi bi-person-circle text-muted"></i>
                                            <span>My Profile</span>
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item py-2 d-flex align-items-center gap-2" asp-area="" asp-controller="Account" asp-action="ChangePassword">
                                        <i class="bi bi-key text-muted"></i>
                                        <span>Change Password</span>
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider my-1"></li>
                                <li>
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item py-2 text-danger d-flex align-items-center gap-2">
                                            <i class="bi bi-box-arrow-right"></i>
                                            <span>Sign Out</span>
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    }

    <main class="flex-grow-1 @(CurrentUser.IsAuthenticated ? "container-fluid px-lg-4 px-3 py-4" : "")">
        @if (CurrentUser.IsAuthenticated)
        {
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 shadow-sm d-flex align-items-center justify-content-between mb-4 fade show" role="alert" style="border-radius: 12px; background-color: #ecfdf5; color: #065f46; border-left: 4px solid #10b981 !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span class="fw-semibold">@TempData["SuccessMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 shadow-sm d-flex align-items-center justify-content-between mb-4 fade show" role="alert" style="border-radius: 12px; background-color: #fef2f2; color: #991b1b; border-left: 4px solid #ef4444 !important;">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        <span class="fw-semibold">@TempData["ErrorMessage"]</span>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        }

        @RenderBody()
    </main>

    @if (CurrentUser.IsAuthenticated)
    {
        <footer class="app-footer">
            <div class="container-fluid px-lg-4 px-3 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                <div>
                    <span class="fw-semibold text-dark">@companyName</span> &bull; Organizational Workforce Management
                </div>
            </div>
        </footer>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
