@model LoginViewModel
@inject Hrms.Settings.Contracts.ISettingsReader SettingsReader
@{
    ViewData["Title"] = "Sign In";
    Layout = null;

    string companyName = "HRMS Enterprise";
    try
    {
        var configuredName = await SettingsReader.GetStringAsync(Hrms.Settings.Contracts.SettingKeys.CompanyName);
        if (!string.IsNullOrWhiteSpace(configuredName))
        {
            companyName = configuredName;
        }
    }
    catch
    {
        // Fallback default
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - @companyName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-bg">
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-icon mx-auto mb-3" style="width: 52px; height: 52px; font-size: 1.6rem; border-radius: 14px;">
                <i class="bi bi-layers-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-1 tracking-tight">@companyName</h3>
            <p class="text-muted small mb-0">Sign in to manage and view organizational records</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 shadow-sm small py-2 px-3 mb-3 d-flex align-items-center gap-2" style="border-radius: 10px; background-color: #fef2f2; color: #991b1b; border-left: 3px solid #ef4444 !important;">
                <i class="bi bi-exclamation-circle-fill fs-5"></i>
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <form asp-action="Login" method="post" id="loginForm">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted ps-3"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" id="emailInput" class="form-control border-start-0 ps-2" placeholder="user@hrms.local" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted ps-3"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" id="passwordInput" class="form-control border-start-0 border-end-0 ps-2" placeholder="••••••••" />
                    <button type="button" class="btn btn-outline-secondary border-start-0 bg-white text-muted" id="togglePasswordBtn" style="border-color: #cbd5e1;" onclick="togglePasswordVisibility()">
                        <i class="bi bi-eye" id="passwordEyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMeCheck" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small user-select-none" for="rememberMeCheck">Remember this device</label>
                </div>
            </div>

            <div class="d-grid mb-4">
                <button type="submit" class="btn btn-primary-modern py-2 fw-semibold" id="submitBtn">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign In</span>
                </button>
            </div>
        </form>

        <div class="border-top pt-3 mt-2">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Demo Credentials:</span>
                <span class="badge bg-light text-muted border font-monospace" style="font-size: 0.68rem;">1-Click Fill</span>
            </div>
            <div class="d-flex flex-column gap-2">
                <div class="quick-cred-badge" onclick="fillCreds('admin@hrms.local', 'Admin@123456', this)">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-primary text-white px-2 py-1"><i class="bi bi-shield-fill-check me-1"></i>Admin</span>
                        <span class="text-dark fw-medium small">admin@hrms.local</span>
                    </div>
                    <span class="font-monospace text-muted small">Admin@123456</span>
                </div>
                <div class="quick-cred-badge" onclick="fillCreds('hr@hrms.local', 'Hr@123456', this)">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-person-badge-fill me-1"></i>HR</span>
                        <span class="text-dark fw-medium small">hr@hrms.local</span>
                    </div>
                    <span class="font-monospace text-muted small">Hr@123456</span>
                </div>
                <div class="quick-cred-badge" onclick="fillCreds('employee@hrms.local', 'Employee@123456', this)">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-secondary text-white px-2 py-1"><i class="bi bi-person-fill me-1"></i>Employee</span>
                        <span class="text-dark fw-medium small">employee@hrms.local</span>
                    </div>
                    <span class="font-monospace text-muted small">Employee@123456</span>
                </div>
            </div>
        </div>

        <div class="text-center mt-4 pt-2">
            <small class="text-muted" style="font-size: 0.72rem;">
                <i class="bi bi-shield-lock me-1 text-primary"></i>Enterprise Authentication &bull; ASP.NET Core Identity
            </small>
        </div>
    </div>

    <script>
        function fillCreds(email, password, element) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
            
            // Subtle click animation feedback
            element.style.transform = 'scale(0.98)';
            setTimeout(() => {
                element.style.transform = '';
            }, 150);
        }

        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('passwordEyeIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }
    </script>
</body>
</html>
