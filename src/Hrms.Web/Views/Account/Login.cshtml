@model LoginViewModel
@inject Hrms.Settings.Contracts.ISettingsReader SettingsReader
@{
    ViewData["Title"] = "Sign In";
    Layout = null;

    string companyName = "EuitSols";
    try
    {
        var configuredName = await SettingsReader.GetStringAsync(Hrms.Settings.Contracts.SettingKeys.CompanyName);
        if (!string.IsNullOrWhiteSpace(configuredName) && configuredName != "Company Name")
        {
            companyName = configuredName;
        }
    }
    catch
    {
        // Fallback default
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - @companyName</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        :root {
            /* Sidebar Matching Purple/Violet Palette */
            --primary: #7c3aed;
            --primary-hover: #6d28d9;
            --primary-active: #5b21b6;
            --primary-focus: rgba(124, 58, 237, 0.16);
            --primary-light: #f4f3ff;
            --primary-border: #e9d5ff;
            --primary-gradient: linear-gradient(135deg, #7c3aed 0%, #6366f1 100%);
            
            --slate-900: #101828;
            --slate-800: #1d2939;
            --slate-700: #344054;
            --slate-600: #475467;
            --slate-500: #667085;
            --slate-400: #98a2b3;
            --slate-300: #d0d5dd;
            --slate-200: #eaecf0;
            --slate-100: #f2f4f7;
            
            /* Input styling matching the prototype */
            --input-bg: #f0f4f8;
            --input-border: #e2e8f0;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #ffffff;
            color: var(--slate-900);
            min-height: 100vh;
            margin: 0;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 3rem 1.5rem 1.5rem;
            -webkit-font-smoothing: antialiased;
        }

        .login-container {
            width: 100%;
            max-width: 440px;
            margin: auto 0;
        }

        /* Top Brand Logo & Title */
        .brand-header {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            margin-bottom: 0.65rem;
        }

        .brand-logo-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            background: var(--primary-gradient);
            color: #ffffff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 6px 16px rgba(124, 58, 237, 0.3);
            flex-shrink: 0;
        }

        .brand-logo-title {
            font-size: 2rem;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: var(--slate-900);
            margin: 0;
            line-height: 1;
        }

        .login-subtitle {
            text-align: center;
            font-size: 1rem;
            font-weight: 500;
            color: var(--slate-700);
            margin-bottom: 2.25rem;
        }

        /* Form Controls */
        .form-group-custom {
            margin-bottom: 1.25rem;
        }

        .custom-label {
            display: block;
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--slate-700);
            margin-bottom: 0.45rem;
        }

        .req-star {
            color: #f04438;
            margin-left: 2px;
        }

        .custom-input {
            width: 100%;
            height: 50px;
            padding: 0.65rem 1.15rem;
            font-size: 0.95rem;
            color: var(--slate-900);
            background-color: var(--input-bg);
            border: 1px solid var(--input-border);
            border-radius: 10px;
            transition: all 0.15s ease-in-out;
            outline: none;
        }

        .custom-input::placeholder {
            color: #94a3b8;
            font-size: 0.92rem;
        }

        .custom-input:focus {
            background-color: #ffffff;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--primary-focus);
        }

        .password-wrapper {
            position: relative;
        }

        .password-toggle-btn {
            position: absolute;
            right: 14px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--slate-400);
            cursor: pointer;
            padding: 4px;
            font-size: 1.15rem;
            line-height: 1;
            transition: color 0.15s ease;
        }

        .password-toggle-btn:hover {
            color: var(--primary);
        }

        .forgot-link-wrapper {
            display: flex;
            justify-content: flex-end;
            margin-top: 0.5rem;
            margin-bottom: 1.35rem;
        }

        .forgot-password-link {
            font-size: 0.88rem;
            font-weight: 600;
            color: var(--primary);
            text-decoration: none;
            transition: color 0.15s ease;
        }

        .forgot-password-link:hover {
            color: var(--primary-hover);
            text-decoration: underline;
        }

        /* Login Button matching Sidebar Primary */
        .btn-login {
            width: 100%;
            height: 50px;
            background: var(--primary);
            color: #ffffff;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 14px rgba(124, 58, 237, 0.25);
        }

        .btn-login:hover {
            background: var(--primary-hover);
            box-shadow: 0 6px 18px rgba(124, 58, 237, 0.35);
            transform: translateY(-1px);
            color: #ffffff;
        }

        .btn-login:active {
            background: var(--primary-active);
            transform: translateY(0);
        }

        /* Error Banner */
        .error-banner {
            background-color: #fef2f2;
            border: 1px solid #fee2e2;
            border-left: 4px solid #ef4444;
            color: #991b1b;
            border-radius: 10px;
            padding: 0.75rem 1rem;
            margin-bottom: 1.25rem;
            font-size: 0.88rem;
            display: flex;
            align-items: flex-start;
            gap: 10px;
        }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 1rem;
        }

        .custom-checkbox {
            accent-color: var(--primary);
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

        /* 1-Click Demo Credentials Pill Helpers */
        .demo-section {
            margin-top: 2.25rem;
            padding-top: 1.25rem;
            border-top: 1px dashed var(--slate-200);
        }

        .demo-cred-card {
            padding: 0.5rem 0.85rem;
            background: #fafafc;
            border: 1px solid var(--slate-200);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.15s ease;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0.45rem;
            font-size: 0.82rem;
        }

        .demo-cred-card:hover {
            background: #f4f3ff;
            border-color: #d8b4fe;
            transform: translateX(2px);
        }

        /* Footer */
        .login-footer {
            text-align: center;
            font-size: 0.85rem;
            color: var(--slate-400);
            margin-top: 2rem;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <!-- Brand Header matching prototype with sidebar palette -->
        <div class="brand-header">
            <div class="brand-logo-icon">
                <i class="bi bi-stack"></i>
            </div>
            <h1 class="brand-logo-title">@companyName</h1>
        </div>
        
        <p class="login-subtitle">Enter your details to sign in.</p>

        <!-- Error Summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-banner">
                <i class="bi bi-exclamation-triangle-fill fs-5 text-danger flex-shrink-0 mt-1"></i>
                <div asp-validation-summary="All" class="mb-0"></div>
            </div>
        }

        <!-- Login Form -->
        <form asp-action="Login" method="post" id="loginForm">
            <input type="hidden" asp-for="ReturnUrl" />

            <!-- Email Field -->
            <div class="form-group-custom">
                <label asp-for="Email" class="custom-label">Email<span class="req-star">*</span></label>
                <input asp-for="Email" id="emailInput" class="custom-input" placeholder="user@hrms.local" autofocus />
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Password Field -->
            <div class="form-group-custom mb-2">
                <label asp-for="Password" class="custom-label">Password<span class="req-star">*</span></label>
                <div class="password-wrapper">
                    <input asp-for="Password" id="passwordInput" class="custom-input pe-5" placeholder="••••••••" />
                    <button type="button" class="password-toggle-btn" id="togglePasswordBtn" onclick="togglePasswordVisibility()" title="Toggle visibility">
                        <i class="bi bi-eye" id="passwordEyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Forgot Password Link -->
            <div class="forgot-link-wrapper">
                <a href="javascript:void(0)" onclick="showForgotPasswordInfo()" class="forgot-password-link">Forget password?</a>
            </div>

            <!-- Remember Me -->
            <div class="remember-row">
                <input asp-for="RememberMe" class="custom-checkbox" id="rememberMeCheck" />
                <label asp-for="RememberMe" class="text-muted small user-select-none mb-0" for="rememberMeCheck" style="cursor: pointer;">Remember this device</label>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-login" id="submitBtn">
                <span>Login</span>
            </button>
        </form>

        <!-- 1-Click Demo Credentials (Fast access) -->
        <div class="demo-section">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold" style="font-size: 0.78rem;">Quick Demo Fill:</span>
                <span class="badge font-monospace text-muted border bg-light" style="font-size: 0.68rem;">1-Click</span>
            </div>
            
            <div class="demo-cred-card" onclick="fillCreds('admin@hrms.local', 'Admin@123456', this)">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-white px-2 py-1" style="background-color: var(--primary); font-size: 0.72rem;">Admin</span>
                    <span class="fw-medium text-dark">admin@hrms.local</span>
                </div>
                <span class="font-monospace text-muted small">Admin@123456</span>
            </div>

            <div class="demo-cred-card" onclick="fillCreds('hr@hrms.local', 'Hr@123456', this)">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-white px-2 py-1" style="background-color: #6366f1; font-size: 0.72rem;">HR</span>
                    <span class="fw-medium text-dark">hr@hrms.local</span>
                </div>
                <span class="font-monospace text-muted small">Hr@123456</span>
            </div>

            <div class="demo-cred-card" onclick="fillCreds('employee@hrms.local', 'Employee@123456', this)">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge text-white px-2 py-1" style="background-color: #64748b; font-size: 0.72rem;">Employee</span>
                    <span class="fw-medium text-dark">employee@hrms.local</span>
                </div>
                <span class="font-monospace text-muted small">Employee@123456</span>
            </div>
        </div>
    </div>

    <!-- Bottom Copyright matching prototype -->
    <footer class="login-footer">
        &copy; @DateTime.UtcNow.Year @companyName. All rights reserved.
    </footer>

    <!-- Info Toast for Forgot Password -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1080">
        <div id="forgotPasswordToast" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 10px;">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-warning fs-5"></i>
                    <span>Please contact your system administrator or HR department to reset your password.</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function fillCreds(email, password, element) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
            
            element.style.transform = 'scale(0.98)';
            setTimeout(() => {
                element.style.transform = '';
            }, 150);
        }

        function togglePasswordVisibility() {
            const passwordInput = document.getElementById('passwordInput');
            const eyeIcon = document.getElementById('passwordEyeIcon');
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                eyeIcon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                eyeIcon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        function showForgotPasswordInfo() {
            const toastEl = document.getElementById('forgotPasswordToast');
            const toast = new bootstrap.Toast(toastEl, { delay: 5000 });
            toast.show();
        }
    </script>
</body>
</html>
