@model LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Standalone full-page login for clean modern aesthetic
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In - HRMS Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="login-bg">
    <div class="login-card">
        <div class="text-center mb-4">
            <div class="brand-icon mb-2" style="width: 48px; height: 48px; font-size: 1.5rem; border-radius: 12px;">
                <i class="bi bi-layers-fill"></i>
            </div>
            <h4 class="fw-bold text-dark mt-2 mb-1">HRMS Portal</h4>
            <p class="text-muted small">Sign in to manage and view organizational records</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 shadow-sm small py-2 px-3 mb-3" style="border-radius: 10px; background-color: #fee2e2; color: #b91c1c;">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" id="emailInput" class="form-control border-start-0 ps-0" placeholder="user@hrms.local" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                    <input asp-for="Password" id="passwordInput" class="form-control border-start-0 ps-0" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-4 d-flex justify-content-between align-items-center">
                <div class="form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted small">Keep me signed in</label>
                </div>
            </div>

            <div class="d-grid mb-4">
                <button type="submit" class="btn btn-primary-modern py-2">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </button>
            </div>
        </form>

        <div class="border-top pt-3 mt-2">
            <p class="text-muted small text-center mb-2 fw-semibold">Quick Sign-In Demo Credentials:</p>
            <div class="d-flex flex-column gap-1">
                <div class="quick-cred-badge d-flex justify-content-between align-items-center" onclick="fillCreds('admin@hrms.local', 'Admin@123456')">
                    <span><strong>Admin:</strong> admin@hrms.local</span>
                    <span class="badge bg-primary">Admin@123456</span>
                </div>
                <div class="quick-cred-badge d-flex justify-content-between align-items-center" onclick="fillCreds('hr@hrms.local', 'Hr@123456')">
                    <span><strong>HR:</strong> hr@hrms.local</span>
                    <span class="badge bg-info text-dark">Hr@123456</span>
                </div>
                <div class="quick-cred-badge d-flex justify-content-between align-items-center" onclick="fillCreds('employee@hrms.local', 'Employee@123456')">
                    <span><strong>Employee:</strong> employee@hrms.local</span>
                    <span class="badge bg-secondary">Employee@123456</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        function fillCreds(email, password) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = password;
        }
    </script>
</body>
</html>
