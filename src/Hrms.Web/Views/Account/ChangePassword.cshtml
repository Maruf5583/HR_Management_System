@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card-modern p-4">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-key me-2 text-primary"></i>Change Password</h5>
                    <p class="text-muted small mb-0">Update your account login credentials</p>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-modern btn-sm">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <form asp-action="ChangePassword" method="post">
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                    <input asp-for="CurrentPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-modern">Cancel</a>
                    <button type="submit" class="btn btn-primary-modern">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</div>
