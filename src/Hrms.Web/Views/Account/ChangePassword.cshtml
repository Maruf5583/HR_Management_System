@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
        <div class="card-modern p-4 p-md-5">
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-icon" style="width: 44px; height: 44px; font-size: 1.25rem;">
                        <i class="bi bi-key-fill"></i>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0 text-dark tracking-tight">Change Password</h4>
                        <p class="text-muted small mb-0">Update your account authentication secret</p>
                    </div>
                </div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-modern btn-sm" title="Back to dashboard">
                    <i class="bi bi-arrow-left"></i>
                </a>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger border-0 shadow-sm small py-2 px-3 mb-4 d-flex align-items-center gap-2" style="border-radius: 10px; background-color: #fef2f2; color: #991b1b; border-left: 3px solid #ef4444 !important;">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div asp-validation-summary="ModelOnly" class="mb-0"></div>
                </div>
            }

            <form asp-action="ChangePassword" method="post">
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="CurrentPassword" class="form-control" placeholder="••••••••" autofocus />
                    </div>
                    <span asp-validation-for="CurrentPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label">New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="NewPassword" class="form-control" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small mt-1 d-block"></span>
                    <small class="text-muted" style="font-size: 0.76rem;">Minimum 6 characters with mixed characters.</small>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <span class="input-group-text bg-white text-muted"><i class="bi bi-check2-circle"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-secondary-modern">Cancel</a>
                    <button type="submit" class="btn btn-primary-modern">
                        <i class="bi bi-check-lg"></i>
                        <span>Update Password</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
