@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card-modern p-5">
            <div class="stat-icon bg-danger-subtle text-danger mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Denied</h3>
            <p class="text-muted mt-2 mb-4">
                You do not have the required role or permission claim to access this resource. Please contact your system administrator if you believe this is an error.
            </p>
            <div>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary-modern">
                    <i class="bi bi-house me-1"></i> Return to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
