@model Hrms.Reports.Application.Models.EmployeeDashboardDto
@{
    var prevMonthDate = new DateOnly(Model.Calendar.Year, Model.Calendar.Month, 1).AddMonths(-1);
    var nextMonthDate = new DateOnly(Model.Calendar.Year, Model.Calendar.Month, 1).AddMonths(1);
    var daysOfWeek = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };
}

<style>
    /* Employee Dashboard Styling */
    .emp-greet-title {
        font-size: 1.85rem;
        font-weight: 800;
        color: #1e1b4b;
        letter-spacing: -0.5px;
    }
    .emp-greet-name {
        color: #5b45b2;
        border-bottom: 3px solid #7c3aed;
        padding-bottom: 2px;
    }
    .emp-clock-badge {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 8px 16px;
        font-weight: 700;
        color: #1e293b;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .emp-card {
        background: #ffffff;
        border-radius: 18px;
        border: 1px solid #edf2f7;
        box-shadow: 0 4px 12px rgba(91, 69, 178, 0.04);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .emp-card:hover {
        box-shadow: 0 8px 24px rgba(91, 69, 178, 0.08);
    }
    .emp-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
    }
    .emp-card-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }

    /* Circular Progress Chart */
    .circular-chart {
        display: block;
        max-width: 110px;
        max-height: 110px;
    }
    .circle-bg {
        fill: none;
        stroke: #f1f5f9;
        stroke-width: 3.8;
    }
    .circle {
        fill: none;
        stroke-width: 3.8;
        stroke-linecap: round;
        transition: stroke-dasharray 0.6s ease;
    }
    .circle-purple {
        stroke: #5b45b2;
    }
    .circle-green {
        stroke: #10b981;
    }
    .circle-orange {
        stroke: #f59e0b;
    }
    .percentage {
        fill: #0f172a;
        font-family: inherit;
        font-weight: 800;
        font-size: 0.55em;
        text-anchor: middle;
    }
    .percentage-sub {
        fill: #64748b;
        font-family: inherit;
        font-weight: 500;
        font-size: 0.28em;
        text-anchor: middle;
    }

    /* Stat Box in Grid */
    .emp-stat-box {
        background: #f8fafc;
        border-radius: 12px;
        padding: 10px 14px;
        border: 1px solid #f1f5f9;
    }
    .emp-stat-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
        margin-bottom: 4px;
        font-weight: 600;
    }
    .emp-stat-val {
        font-size: 1.15rem;
        font-weight: 800;
        color: #0f172a;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    /* Team Attendance Matrix */
    .team-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: #ede9fe;
        color: #5b45b2;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.85rem;
    }
    .day-pill {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 700;
    }
    .day-pill-present {
        background-color: #dcfce7;
        color: #15803d;
    }
    .day-pill-leave {
        background-color: #ede9fe;
        color: #6d28d9;
    }
    .day-pill-absent {
        background-color: #fee2e2;
        color: #b91c1c;
    }
    .day-pill-weekend {
        background-color: #f1f5f9;
        color: #64748b;
    }
    .day-pill-holiday {
        background-color: #fef3c7;
        color: #b45309;
    }
    .day-pill-none {
        color: #cbd5e1;
    }

    /* Calendar Grid */
    .cal-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
    }
    .cal-header-cell {
        text-align: center;
        font-size: 0.72rem;
        font-weight: 700;
        color: #64748b;
        padding-bottom: 6px;
    }
    .cal-cell {
        aspect-ratio: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: 0.8rem;
        font-weight: 600;
        color: #334155;
        background: #ffffff;
        border: 1px solid #f1f5f9;
        position: relative;
        cursor: default;
        transition: all 0.15s ease;
    }
    .cal-cell:hover {
        transform: scale(1.06);
        z-index: 2;
    }
    .cal-cell-empty {
        background: transparent;
        border: none;
    }
    .cal-cell-today {
        border: 2px solid #5b45b2 !important;
        font-weight: 800;
        color: #5b45b2;
    }
    .cal-cell-present {
        background: #dcfce7;
        color: #15803d;
        border-color: #bbf7d0;
    }
    .cal-cell-late {
        background: #fef3c7;
        color: #b45309;
        border-color: #fde68a;
    }
    .cal-cell-leave {
        background: #ede9fe;
        color: #6d28d9;
        border-color: #ddd6fe;
    }
    .cal-cell-weekend {
        background: #f8fafc;
        color: #94a3b8;
        border-color: #e2e8f0;
    }
    .cal-cell-holiday {
        background: #ffedd5;
        color: #c2410c;
        border-color: #fed7aa;
        font-weight: 800;
    }
    .cal-cell-absent {
        background: #fee2e2;
        color: #b91c1c;
        border-color: #fecaca;
    }
    .cal-dot {
        width: 4px;
        height: 4px;
        border-radius: 50%;
        margin-top: 2px;
    }

    /* History Table */
    .history-circle-icon {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 3px solid #10b981;
        display: inline-block;
    }
    .history-circle-icon-orange {
        border-color: #f59e0b;
    }
</style>

<!-- Welcome Greeting Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <h1 class="emp-greet-title mb-1">
            Hello, <span class="emp-greet-name">@Model.FullName</span>
        </h1>
        <p class="text-muted mb-0 small">
            <i class="bi bi-briefcase me-1 text-primary"></i>@Model.DesignationTitle &nbsp;•&nbsp; 
            <i class="bi bi-building me-1 text-primary"></i>@Model.DepartmentName &nbsp;•&nbsp;
            <span class="text-dark fw-semibold">@Model.TodayDateFormatted</span>
        </p>
    </div>
    <div class="emp-clock-badge">
        <i class="bi bi-clock-history fs-5 text-primary"></i>
        <div>
            <span id="empLiveClock" class="fs-6">@Model.CurrentTimeFormatted</span>
            <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem;">Asia/Dhaka</small>
        </div>
    </div>
</div>

<!-- Row 1: Top 3 Cards (Today, Shift Overview, Leave Entitlement) -->
<div class="row g-4 mb-4">
    <!-- Card 1: Today Status -->
    <div class="col-lg-4">
        <div class="emp-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="emp-card-header">
                    <h5 class="emp-card-title">Today</h5>
                    @switch (Model.Today.Status)
                    {
                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Present:
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Present</span>
                            break;
                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Late:
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill">Late</span>
                            break;
                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.OnLeave:
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">On Leave</span>
                            break;
                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Holiday:
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill">Holiday</span>
                            break;
                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Weekend:
                            <span class="badge bg-light text-muted border px-3 py-1 rounded-pill">Weekend</span>
                            break;
                        default:
                            <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill">@Model.Today.StatusText</span>
                            break;
                    }
                </div>

                <div class="d-flex align-items-center justify-content-between my-3 gap-3">
                    <!-- Circular Gauge -->
                    <div style="flex-shrink: 0;">
                        <svg viewBox="0 0 36 36" class="circular-chart">
                            <path class="circle-bg"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="circle circle-purple"
                                  stroke-dasharray="@Model.Today.ProgressPercent, 100"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <text x="18" y="18.5" class="percentage">@Model.Today.ProgressPercent%</text>
                            <text x="18" y="24" class="percentage-sub">of day</text>
                        </svg>
                    </div>

                    <!-- Time & Check-in Details -->
                    <div>
                        <span class="text-muted small fw-semibold">Time left:</span>
                        <h3 class="fw-extrabold text-dark mb-1">@Model.Today.TimeLeftFormatted</h3>
                        @if (Model.Today.IsCheckedIn)
                        {
                            <small class="text-muted d-block">
                                <i class="bi bi-box-arrow-in-right text-success me-1"></i>Checked in at <strong>@Model.Today.CheckInFormatted</strong>
                            </small>
                            @if (Model.Today.IsCheckedOut)
                            {
                                <small class="text-muted d-block">
                                    <i class="bi bi-box-arrow-right text-danger me-1"></i>Checked out at <strong>@Model.Today.CheckOutFormatted</strong>
                                </small>
                            }
                        }
                        else
                        {
                            <small class="text-muted d-block">
                                <i class="bi bi-info-circle me-1"></i>@(string.IsNullOrEmpty(Model.Today.Note) ? "Not checked in yet today" : Model.Today.Note)
                            </small>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-area="Attendance" asp-controller="MyAttendance" asp-action="Index" class="btn btn-outline-primary w-100 py-2 rounded-3 fw-semibold d-flex align-items-center justify-content-center gap-2">
                    <i class="bi bi-calendar2-check"></i>
                    <span>View Attendance History</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Card 2: Shift Overview -->
    <div class="col-lg-4">
        <div class="emp-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="emp-card-header">
                    <h5 class="emp-card-title">Shift overview</h5>
                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1">This month</span>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <div class="emp-stat-box">
                            <div class="emp-stat-label">Average Hours</div>
                            <div class="emp-stat-val">
                                <span>@Model.ShiftOverview.AverageHoursFormatted</span>
                                <i class="bi bi-arrow-up-short text-success fs-5"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="emp-stat-box">
                            <div class="emp-stat-label">Average Check-in</div>
                            <div class="emp-stat-val">
                                <span>@Model.ShiftOverview.AverageCheckInFormatted</span>
                                <i class="bi bi-check2 text-primary fs-5"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="emp-stat-box">
                            <div class="emp-stat-label">On-time Arrival</div>
                            <div class="emp-stat-val text-success">
                                <span>@Model.ShiftOverview.OnTimeArrivalRate%</span>
                                <i class="bi bi-arrow-up-short fs-5"></i>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="emp-stat-box">
                            <div class="emp-stat-label">Average Check-out</div>
                            <div class="emp-stat-val">
                                <span>@Model.ShiftOverview.AverageCheckOutFormatted</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="p-2 px-3 rounded-3 bg-light text-primary small fw-semibold d-flex align-items-center justify-content-between">
                <span><i class="bi bi-clock me-1"></i> @Model.ShiftOverview.ShiftName</span>
                <span class="text-dark fw-bold">@Model.ShiftOverview.TimingFormatted</span>
            </div>
        </div>
    </div>

    <!-- Card 3: Leave Entitlement (Donut Ring & Balances) -->
    <div class="col-lg-4">
        <div class="emp-card p-4 h-100 d-flex flex-column justify-content-between">
            <div>
                <div class="emp-card-header">
                    <h5 class="emp-card-title">Leave Entitlement</h5>
                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1">Year @DateTime.Now.Year</span>
                </div>

                <div class="d-flex align-items-center justify-content-between my-2 gap-3">
                    <!-- Circular Donut Ring -->
                    <div style="flex-shrink: 0;">
                        <svg viewBox="0 0 36 36" class="circular-chart">
                            <path class="circle-bg"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <path class="circle circle-green"
                                  stroke-dasharray="@Model.LeaveSummary.RemainingPercentage, 100"
                                  d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
                            <text x="18" y="17.5" class="percentage">@Model.LeaveSummary.TotalRemaining</text>
                            <text x="18" y="23" class="percentage-sub">Days Left</text>
                        </svg>
                    </div>

                    <!-- Breakdown Legend -->
                    <div class="w-100">
                        @if (Model.LeaveSummary.Balances.Count > 0)
                        {
                            <ul class="list-unstyled mb-0 small">
                                @foreach (var b in Model.LeaveSummary.Balances.Take(3))
                                {
                                    <li class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="rounded-circle @b.ColorClass" style="width: 8px; height: 8px; background-color: currentColor; display: inline-block;"></span>
                                            <span class="text-dark fw-medium">@b.Name</span>
                                        </span>
                                        <span class="text-muted fw-semibold">@b.Used / @b.Entitled</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted small">No leave policy balances assigned for @DateTime.Now.Year.</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                <small class="text-muted">
                    Total: <strong>@Model.LeaveSummary.TotalEntitled</strong> | Used: <strong>@Model.LeaveSummary.TotalUsed</strong>
                </small>
                <a asp-area="Leave" asp-controller="MyLeave" asp-action="Index" class="btn btn-sm btn-link text-decoration-none fw-semibold p-0">
                    Apply Leave <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Middle Section (My Team on Left, Interactive Calendar on Right) -->
<div class="row g-4 mb-4">
    <!-- Left: My Team (Department Peers) -->
    <div class="col-lg-8">
        <div class="emp-card p-4 h-100">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h5 class="emp-card-title">My Team</h5>
                    <small class="text-muted">@Model.DepartmentName Department Colleagues</small>
                </div>
                <div class="d-flex flex-wrap align-items-center gap-3 small">
                    <span class="d-inline-flex align-items-center gap-1 text-muted">
                        <span class="day-pill day-pill-present" style="width: 14px; height: 14px; font-size: 0;"></span> In office
                    </span>
                    <span class="d-inline-flex align-items-center gap-1 text-muted">
                        <span class="day-pill day-pill-leave" style="width: 14px; height: 14px; font-size: 0;"></span> On leave
                    </span>
                    <span class="d-inline-flex align-items-center gap-1 text-muted">
                        <span class="day-pill day-pill-absent" style="width: 14px; height: 14px; font-size: 0;"></span> Absent
                    </span>
                </div>
            </div>

            @if (Model.TeamMembers.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <thead>
                            <tr class="text-muted small border-bottom">
                                <th style="font-weight: 600;">Member</th>
                                <th class="text-center" style="font-weight: 600; width: 44px;">Mon</th>
                                <th class="text-center" style="font-weight: 600; width: 44px;">Tue</th>
                                <th class="text-center" style="font-weight: 600; width: 44px;">Wed</th>
                                <th class="text-center" style="font-weight: 600; width: 44px;">Thu</th>
                                <th class="text-center" style="font-weight: 600; width: 44px;">Fri</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Model.TeamMembers)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="team-avatar">@m.Initial</div>
                                            <div>
                                                <div class="fw-bold text-dark small">@m.FullName</div>
                                                <div class="text-muted" style="font-size: 0.72rem;">@m.Designation</div>
                                            </div>
                                        </div>
                                    </td>
                                    @for (int day = 0; day < 5; day++)
                                    {
                                        var code = m.WeeklyStatusCodes.ContainsKey(day) ? m.WeeklyStatusCodes[day] : "-";
                                        var pillClass = code switch
                                        {
                                            "P" => "day-pill-present",
                                            "L" => "day-pill-leave",
                                            "A" => "day-pill-absent",
                                            "W" => "day-pill-weekend",
                                            "H" => "day-pill-holiday",
                                            _ => "day-pill-none"
                                        };
                                        <td class="text-center">
                                            <span class="day-pill @pillClass">@code</span>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-people fs-2 text-secondary opacity-50 d-block mb-1"></i>
                    No department colleagues found.
                </div>
            }
        </div>
    </div>

    <!-- Right: Interactive Calendar Widget (Holidays, Weekends, Attendance) -->
    <div class="col-lg-4">
        <div class="emp-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="emp-card-title">@Model.Calendar.MonthName</h5>
                <div class="btn-group btn-group-sm">
                    <a asp-action="Index" asp-route-year="@prevMonthDate.Year" asp-route-month="@prevMonthDate.Month" class="btn btn-outline-secondary rounded-circle me-1" style="width: 28px; height: 28px; padding: 0; line-height: 26px;" title="Previous Month">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                    <a asp-action="Index" asp-route-year="@nextMonthDate.Year" asp-route-month="@nextMonthDate.Month" class="btn btn-outline-secondary rounded-circle" style="width: 28px; height: 28px; padding: 0; line-height: 26px;" title="Next Month">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>

            <!-- Calendar Days Header -->
            <div class="cal-grid mb-1">
                @foreach (var d in daysOfWeek)
                {
                    <div class="cal-header-cell">@d</div>
                }
            </div>

            <!-- Calendar Cells -->
            <div class="cal-grid">
                <!-- Leading empty offset days -->
                @for (int i = 0; i < Model.Calendar.FirstDayOfWeekOffset; i++)
                {
                    <div class="cal-cell cal-cell-empty"></div>
                }

                <!-- Days of the Month -->
                @for (int dayNum = 1; dayNum <= Model.Calendar.TotalDaysInMonth; dayNum++)
                {
                    var cellDate = new DateOnly(Model.Calendar.Year, Model.Calendar.Month, dayNum);
                    var isToday = cellDate == DateOnly.FromDateTime(DateTime.Today);
                    var isWeekend = Model.Calendar.WeeklyOffDays.Contains(cellDate.DayOfWeek);
                    var isHoliday = Model.Calendar.Holidays.ContainsKey(cellDate);
                    var holidayName = isHoliday ? Model.Calendar.Holidays[cellDate] : null;

                    var hasAttendance = Model.Calendar.AttendanceByDate.ContainsKey(cellDate);
                    var att = hasAttendance ? Model.Calendar.AttendanceByDate[cellDate] : null;

                    string cellClass = "cal-cell";
                    string tooltipText = cellDate.ToString("dd MMM yyyy");

                    if (isToday) cellClass += " cal-cell-today";

                    if (isHoliday)
                    {
                        cellClass += " cal-cell-holiday";
                        tooltipText += $" - Holiday: {holidayName}";
                    }
                    else if (hasAttendance && att != null)
                    {
                        switch (att.Status)
                        {
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Present:
                                cellClass += " cal-cell-present";
                                tooltipText += $" - Present ({att.WorkedHours})";
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Late:
                                cellClass += " cal-cell-late";
                                tooltipText += $" - Late ({att.WorkedHours})";
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.OnLeave:
                                cellClass += " cal-cell-leave";
                                tooltipText += " - On Leave";
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Absent:
                                cellClass += " cal-cell-absent";
                                tooltipText += " - Absent";
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Weekend:
                                cellClass += " cal-cell-weekend";
                                tooltipText += " - Weekend Off";
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Holiday:
                                cellClass += " cal-cell-holiday";
                                tooltipText += $" - Holiday: {holidayName}";
                                break;
                        }
                    }
                    else if (isWeekend)
                    {
                        cellClass += " cal-cell-weekend";
                        tooltipText += " - Weekend Off";
                    }

                    <div class="@cellClass" data-bs-toggle="tooltip" title="@tooltipText">
                        <span>@dayNum</span>
                    </div>
                }
            </div>

            <!-- Calendar Color Key / Legend -->
            <div class="d-flex flex-wrap align-items-center justify-content-between mt-3 pt-2 border-top text-muted" style="font-size: 0.72rem;">
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #10b981;"></span> Present
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #f59e0b;"></span> Holiday
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #94a3b8;"></span> Weekend
                </span>
                <span class="d-inline-flex align-items-center gap-1">
                    <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #7c3aed;"></span> Leave
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Row 3: Bottom Working History Card -->
<div class="row g-4">
    <div class="col-12">
        <div class="emp-card p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="emp-card-title">Working History</h5>
                    <small class="text-muted">Recent Daily Attendance Logs</small>
                </div>
                <div class="d-flex align-items-center gap-3 small text-muted">
                    <span class="d-inline-flex align-items-center gap-1">
                        <span class="history-circle-icon" style="width: 12px; height: 12px; border-width: 2px;"></span> On target / Overtime
                    </span>
                    <span class="d-inline-flex align-items-center gap-1">
                        <span class="history-circle-icon history-circle-icon-orange" style="width: 12px; height: 12px; border-width: 2px;"></span> Under-time
                    </span>
                </div>
            </div>

            @if (Model.WorkingHistory.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr class="text-muted small">
                                <th style="font-weight: 600;">Date</th>
                                <th style="font-weight: 600;">Arrival Time</th>
                                <th style="font-weight: 600;">Departure Time</th>
                                <th style="font-weight: 600;">Effective Time</th>
                                <th class="text-center" style="font-weight: 600;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var h in Model.WorkingHistory)
                            {
                                <tr>
                                    <td class="fw-semibold text-dark">@h.DateFormatted</td>
                                    <td>@h.CheckInFormatted</td>
                                    <td>@h.CheckOutFormatted</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="history-circle-icon @(h.IsOnTarget ? "" : "history-circle-icon-orange")"></span>
                                            <div>
                                                <div class="fw-bold text-dark small">@h.EffectiveTimeFormatted</div>
                                                <small class="text-muted" style="font-size: 0.72rem;">@h.TargetComparisonText</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @switch (h.Status)
                                        {
                                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Present:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill">Present</span>
                                                break;
                                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Late:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-1 rounded-pill">Late</span>
                                                break;
                                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.OnLeave:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">On Leave</span>
                                                break;
                                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Weekend:
                                                <span class="badge bg-light text-muted border px-3 py-1 rounded-pill">Weekend</span>
                                                break;
                                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Holiday:
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-3 py-1 rounded-pill">Holiday</span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-secondary border px-3 py-1 rounded-pill">@h.StatusText</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-muted" style="font-size: 0.75rem;">
                    <i class="bi bi-info-circle me-1"></i>Daily expected target: @Model.ShiftOverview.TimingFormatted. Effective time = departure - arrival - break minutes.
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    <i class="bi bi-clock-history fs-2 text-secondary opacity-50 d-block mb-1"></i>
                    No attendance records logged yet for this period.
                </div>
            }
        </div>
    </div>
</div>

<script>
    // Live ticking clock in Asia/Dhaka time
    (function () {
        function updateClock() {
            var el = document.getElementById('empLiveClock');
            if (!el) return;
            var now = new Date();
            var options = { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
            el.textContent = now.toLocaleTimeString('en-US', options);
        }
        setInterval(updateClock, 1000);
    })();
</script>
