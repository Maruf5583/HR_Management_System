@model Hrms.Reports.Application.Models.EmployeeDashboardDto
@{
    var prevMonthDate = new DateOnly(Model.Calendar.Year, Model.Calendar.Month, 1).AddMonths(-1);
    var nextMonthDate = new DateOnly(Model.Calendar.Year, Model.Calendar.Month, 1).AddMonths(1);
    var daysOfWeek = new[] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" };

    // Group consecutive holidays by name
    var groupedHolidays = new List<(string Name, DateOnly Start, DateOnly End, int Days)>();
    var sortedHolidays = Model.Calendar.Holidays.OrderBy(kv => kv.Key).ToList();
    if (sortedHolidays.Count > 0)
    {
        var curName = sortedHolidays[0].Value;
        var curStart = sortedHolidays[0].Key;
        var curEnd = sortedHolidays[0].Key;

        for (int i = 1; i < sortedHolidays.Count; i++)
        {
            var h = sortedHolidays[i];
            if (h.Value.Equals(curName, StringComparison.OrdinalIgnoreCase) && h.Key == curEnd.AddDays(1))
            {
                curEnd = h.Key;
            }
            else
            {
                groupedHolidays.Add((curName, curStart, curEnd, curEnd.DayNumber - curStart.DayNumber + 1));
                curName = h.Value;
                curStart = h.Key;
                curEnd = h.Key;
            }
        }
        groupedHolidays.Add((curName, curStart, curEnd, curEnd.DayNumber - curStart.DayNumber + 1));
    }
}

<div class="workspace-container">
    <!-- Greeting & Live Clock Row -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="fw-bold text-dark mb-1" style="font-size: 1.65rem; letter-spacing: -0.01em;">
                Hello, <span class="text-primary border-bottom border-2 border-primary pb-1">@Model.FullName</span>
            </h1>
            <p class="text-muted mb-0 small">
                <i class="bi bi-briefcase me-1 text-primary"></i>@Model.DesignationTitle &nbsp;&bull;&nbsp; 
                <i class="bi bi-building me-1 text-primary"></i>@Model.DepartmentName &nbsp;&bull;&nbsp;
                <span class="text-dark fw-semibold">@Model.TodayDateFormatted</span>
            </p>
        </div>
        <div class="bg-white border rounded-3 px-3 py-2 shadow-xs d-inline-flex align-items-center gap-2" style="border-color: #eaecf0 !important;">
            <i class="bi bi-clock-history fs-5 text-primary"></i>
            <div>
                <span id="empLiveClock" class="fw-bold text-dark fs-6 font-monospace">@Model.CurrentTimeFormatted</span>
                <small class="text-muted d-block text-uppercase" style="font-size: 0.65rem; letter-spacing: 0.05em;">Asia/Dhaka</small>
            </div>
        </div>
    </div>

    <!-- Row 1: Three Equal-Width Action Cards -->
    <div class="row g-4 mb-4">
        <!-- Card 1: Today Status -->
        <div class="col-lg-4 d-flex">
            <div class="workspace-card w-100 h-100 d-flex flex-column justify-content-between">
                <div class="d-flex flex-column flex-grow-1">
                    <div class="workspace-card-header">
                        <h6 class="workspace-card-title">Today</h6>
                        @switch (Model.Today.Status)
                        {
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Present:
                                <span class="badge-status-dot badge-status-active">Present</span>
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Late:
                                <span class="badge-status-dot badge-status-warning">Late</span>
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.OnLeave:
                                <span class="badge-status-dot" style="background-color: #f4f3ff; color: #7c3aed; border: 1px solid #e9d5ff;">On Leave</span>
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Holiday:
                                <span class="badge-status-dot badge-status-warning">Holiday</span>
                                break;
                            case Hrms.Attendance.Domain.Enums.AttendanceStatus.Weekend:
                                <span class="badge-status-dot badge-status-neutral">Weekend</span>
                                break;
                            default:
                                <span class="badge-status-dot badge-status-neutral">@Model.Today.StatusText</span>
                                break;
                        }
                    </div>

                    <div class="workspace-card-body flex-grow-1 d-flex flex-column justify-content-between">
                        @if (Model.Today.Status == Hrms.Attendance.Domain.Enums.AttendanceStatus.Holiday)
                        {
                            var todayHolidayName = Model.Calendar.Holidays.TryGetValue(DateOnly.FromDateTime(DateTime.Today), out var hName) && !string.IsNullOrWhiteSpace(hName)
                                ? hName
                                : (!string.IsNullOrWhiteSpace(Model.Today.Note) ? Model.Today.Note : "Statutory Holiday");
                            <div class="p-3 rounded-3 bg-warning-subtle border border-warning-subtle mb-3">
                                <div class="d-flex align-items-center gap-2 text-warning-emphasis fw-bold mb-1">
                                    <i class="bi bi-calendar-event"></i>
                                    <span>Public Holiday</span>
                                </div>
                                <div class="text-dark fw-semibold small">
                                    @todayHolidayName
                                </div>
                                <div class="text-muted" style="font-size: 0.74rem;">Office closed for standard scheduled operations.</div>
                            </div>
                        }
                        else if (Model.Today.Status == Hrms.Attendance.Domain.Enums.AttendanceStatus.Weekend)
                        {
                            <div class="p-3 rounded-3 bg-light border border-light-subtle mb-3 text-center">
                                <i class="bi bi-sun fs-3 text-secondary d-block mb-1"></i>
                                <div class="fw-bold text-dark small">Weekly Rest Day</div>
                                <div class="text-muted" style="font-size: 0.74rem;">Non-working scheduled weekend.</div>
                            </div>
                        }
                        else
                        {
                            <div class="p-3 rounded-3 bg-light border border-light-subtle mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Shift Schedule:</span>
                                    <span class="fw-bold text-dark small">@Model.ShiftOverview.ShiftName</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-muted small">Working Hours:</span>
                                    <span class="fw-semibold text-primary small">@Model.ShiftOverview.TimingFormatted</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">Check-in Status:</span>
                                    @if (Model.Today.IsCheckedIn)
                                    {
                                        <span class="text-success fw-semibold small font-monospace">@Model.Today.CheckInFormatted</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary small">Not clocked in</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="small text-muted py-1">
                            <i class="bi bi-info-circle me-1 text-secondary"></i>
                            <span>Attendance activity is synced in real-time</span>
                        </div>
                    </div>
                </div>

                <div class="p-3 pt-0">
                    <a asp-area="Attendance" asp-controller="MyAttendance" asp-action="Index" class="btn btn-sm btn-light border text-secondary fw-semibold w-100 py-2 rounded-3 shadow-xs d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-calendar2-check text-primary"></i>
                        <span>View Attendance History</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 2: Shift Overview (2x2 compact stats) -->
        <div class="col-lg-4 d-flex">
            <div class="workspace-card w-100 h-100 d-flex flex-column justify-content-between">
                <div class="d-flex flex-column flex-grow-1">
                    <div class="workspace-card-header">
                        <h6 class="workspace-card-title">Shift Overview</h6>
                        <span class="badge bg-light text-secondary border fw-medium" style="font-size: 0.7rem;">This Month</span>
                    </div>

                    <div class="workspace-card-body flex-grow-1 d-flex flex-column justify-content-between">
                        <div class="workspace-stat-grid mb-2.5">
                            <div class="workspace-stat-tile py-2 px-2.5">
                                <div class="workspace-stat-label" style="font-size: 0.68rem;">Average Hours</div>
                                <div class="workspace-stat-value fs-6 mb-0">@Model.ShiftOverview.AverageHoursFormatted</div>
                            </div>
                            <div class="workspace-stat-tile py-2 px-2.5">
                                <div class="workspace-stat-label" style="font-size: 0.68rem;">On-time Arrival</div>
                                <div class="workspace-stat-value fs-6 text-success mb-0">@Model.ShiftOverview.OnTimeArrivalRate%</div>
                            </div>
                            <div class="workspace-stat-tile py-2 px-2.5">
                                <div class="workspace-stat-label" style="font-size: 0.68rem;">Avg Check-in</div>
                                <div class="workspace-stat-value fs-6 mb-0">@Model.ShiftOverview.AverageCheckInFormatted</div>
                            </div>
                            <div class="workspace-stat-tile py-2 px-2.5">
                                <div class="workspace-stat-label" style="font-size: 0.68rem;">Avg Check-out</div>
                                <div class="workspace-stat-value fs-6 mb-0">@Model.ShiftOverview.AverageCheckOutFormatted</div>
                            </div>
                        </div>

                        <div class="p-2 px-2.5 rounded-3 bg-light border text-muted small fw-medium d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-clock me-1 text-primary"></i> @Model.ShiftOverview.ShiftName</span>
                            <span class="text-dark fw-bold">@Model.ShiftOverview.TimingFormatted</span>
                        </div>
                    </div>
                </div>

                <div class="p-3 pt-0">
                    <a asp-area="Attendance" asp-controller="MyAttendance" asp-action="Index" asp-route-tab="shifts" class="btn btn-sm btn-light border text-secondary fw-semibold w-100 py-2 rounded-3 shadow-xs d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-calendar3 text-primary"></i>
                        <span>Shift Details & Roster</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Card 3: Leave Balance -->
        <div class="col-lg-4 d-flex">
            <div class="workspace-card w-100 h-100 d-flex flex-column justify-content-between">
                <div class="d-flex flex-column flex-grow-1">
                    <div class="workspace-card-header">
                        <h6 class="workspace-card-title">Leave Entitlement</h6>
                        <span class="badge bg-light text-secondary border fw-medium" style="font-size: 0.7rem;">Year @DateTime.Now.Year</span>
                    </div>

                    <div class="workspace-card-body flex-grow-1 d-flex flex-column justify-content-between">
                        @if (Model.LeaveSummary.Balances.Count > 0)
                        {
                            <div class="d-flex flex-column gap-2 mb-2">
                                @foreach (var b in Model.LeaveSummary.Balances.Take(3))
                                {
                                    var pct = b.Entitled > 0 ? Math.Min(100, (int)Math.Round((double)b.Used / (double)b.Entitled * 100)) : 0;
                                    <div>
                                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                                            <span class="fw-semibold text-dark">@b.Name</span>
                                            <span class="text-muted" style="font-size: 0.72rem;">Used <strong>@b.Used.ToString("0.#")</strong> of @b.Entitled.ToString("0.#")</span>
                                        </div>
                                        <div class="progress" style="height: 5px; background-color: #f2f4f7; border-radius: 9999px;">
                                            <div class="progress-bar bg-primary" role="progressbar" style="width: @pct%;"></div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-3 text-muted small">
                                <i class="bi bi-wallet2 text-secondary opacity-50 d-block fs-3 mb-1"></i>
                                No leave policies assigned for @DateTime.Now.Year.
                            </div>
                        }

                        <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top">
                            <span>Remaining: <strong class="text-success">@Model.LeaveSummary.TotalRemaining.ToString("0.#") days</strong></span>
                            <span>Total Entitled: <strong>@Model.LeaveSummary.TotalEntitled.ToString("0.#")</strong></span>
                        </div>
                    </div>
                </div>

                <div class="p-3 pt-0">
                    <a asp-area="Leave" asp-controller="MyLeave" asp-action="Index" class="btn btn-sm btn-primary fw-semibold w-100 py-2 rounded-3 shadow-xs d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-plus-circle"></i>
                        <span>Apply Leave</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: 2-Column Responsive Layout (align-items: start) -->
    <div class="row g-4 align-items-start">
        <!-- Left Flexible Column: Working History (last 5-7 days) + My Team -->
        <div class="col-lg-8 d-flex flex-column gap-4">
            <!-- 1. Working History -->
            <div class="workspace-card">
                <div class="workspace-card-header">
                    <div>
                        <h6 class="workspace-card-title">Working History</h6>
                        <small class="text-muted" style="font-size: 0.74rem;">Recent Daily Attendance Logs (Last 7 Days)</small>
                    </div>
                    <a asp-area="Attendance" asp-controller="MyAttendance" asp-action="Index" class="btn btn-sm btn-light border text-secondary px-2.5 py-1 rounded-2 shadow-xs" style="font-size: 0.78rem;">
                        View All
                    </a>
                </div>

                <div class="workspace-card-body p-0">
                    @{
                        var recentLogs = Model.WorkingHistory.Take(7).ToList();
                    }
                    @if (recentLogs.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                                    <tr class="text-secondary small fw-semibold" style="font-size: 0.76rem;">
                                        <th class="ps-3 py-2.5">Date</th>
                                        <th class="py-2.5">Arrival</th>
                                        <th class="py-2.5">Departure</th>
                                        <th class="py-2.5">Effective Time</th>
                                        <th class="py-2.5 text-center">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in recentLogs)
                                    {
                                        var isMissingCheckOut = string.IsNullOrWhiteSpace(h.CheckOutFormatted) 
                                            || h.CheckOutFormatted.Trim() == "-" 
                                            || h.CheckOutFormatted.Trim() == "--" 
                                            || h.CheckOutFormatted.Trim() == "—";
                                        <tr>
                                            <td class="ps-3 fw-semibold text-dark small">@h.DateFormatted</td>
                                            <td class="small font-monospace">@h.CheckInFormatted</td>
                                            <td class="small font-monospace">
                                                @if (!isMissingCheckOut)
                                                {
                                                    <span>@h.CheckOutFormatted</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-0.5 rounded-pill" style="font-size: 0.7rem;">
                                                        <i class="bi bi-exclamation-circle me-1"></i>Missing check-out
                                                    </span>
                                                }
                                            </td>
                                            <td class="small">
                                                @if (!isMissingCheckOut)
                                                {
                                                    <span class="fw-semibold text-dark font-monospace">@h.EffectiveTimeFormatted</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic" style="font-size: 0.74rem;">Not available</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (isMissingCheckOut)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-0.5 rounded-pill" style="font-size: 0.7rem;">Missing Out</span>
                                                }
                                                else
                                                {
                                                    @switch (h.Status)
                                                    {
                                                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Present:
                                                            <span class="badge-status-dot badge-status-active">Present</span>
                                                            break;
                                                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Late:
                                                            <span class="badge-status-dot badge-status-warning">Late</span>
                                                            break;
                                                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.OnLeave:
                                                            <span class="badge-status-dot" style="background-color: #f4f3ff; color: #7c3aed; border: 1px solid #e9d5ff;">On Leave</span>
                                                            break;
                                                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Weekend:
                                                            <span class="badge-status-dot badge-status-neutral">Weekend</span>
                                                            break;
                                                        case Hrms.Attendance.Domain.Enums.AttendanceStatus.Holiday:
                                                            <span class="badge-status-dot badge-status-warning">Holiday</span>
                                                            break;
                                                        default:
                                                            <span class="badge-status-dot badge-status-neutral">@h.StatusText</span>
                                                            break;
                                                    }
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="workspace-empty-state">
                            <i class="bi bi-clock-history workspace-empty-icon"></i>
                            <div class="small fw-medium">No logs yet.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- 2. My Team (Up to 5 members + View all) -->
            <div class="workspace-card">
                <div class="workspace-card-header">
                    <div>
                        <h6 class="workspace-card-title">My Team</h6>
                        <small class="text-muted" style="font-size: 0.74rem;">@Model.DepartmentName Department</small>
                    </div>
                    @if (CurrentUser.HasPermission(Permissions.Employees.View))
                    {
                        <a asp-area="Employees" asp-controller="Employees" asp-action="Index" class="btn btn-sm btn-light border text-secondary px-2.5 py-1 rounded-2 shadow-xs" style="font-size: 0.78rem;">
                            View All
                        </a>
                    }
                </div>

                <div class="workspace-card-body p-0">
                    @{
                        var teamSample = Model.TeamMembers.Take(5).ToList();
                    }
                    @if (teamSample.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead style="background-color: #f8fafc; border-bottom: 1px solid #eaecf0;">
                                    <tr class="text-secondary small fw-semibold" style="font-size: 0.76rem;">
                                        <th class="ps-3 py-2">Member</th>
                                        <th class="py-2 text-center" style="width: 44px;">Mon</th>
                                        <th class="py-2 text-center" style="width: 44px;">Tue</th>
                                        <th class="py-2 text-center" style="width: 44px;">Wed</th>
                                        <th class="py-2 text-center" style="width: 44px;">Thu</th>
                                        <th class="py-2 text-center" style="width: 44px;">Fri</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in teamSample)
                                    {
                                        <tr>
                                            <td class="ps-3 py-2">
                                                <div class="d-flex align-items-center gap-2">
                                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-primary bg-primary-subtle border border-primary-subtle" style="width: 32px; height: 32px; font-size: 0.78rem; flex-shrink: 0;">
                                                        @m.Initial
                                                    </div>
                                                    <div>
                                                        <span class="fw-semibold text-dark d-block text-truncate" style="font-size: 0.82rem; max-width: 180px;">@m.FullName</span>
                                                        <small class="text-muted d-block text-truncate" style="font-size: 0.72rem; max-width: 180px;">@m.Designation</small>
                                                    </div>
                                                </div>
                                            </td>
                                            @for (int day = 0; day < 5; day++)
                                            {
                                                var code = m.WeeklyStatusCodes.ContainsKey(day) ? m.WeeklyStatusCodes[day] : "-";
                                                var pillClass = code switch
                                                {
                                                    "P" => "bg-success-subtle text-success border-success-subtle",
                                                    "L" => "bg-primary-subtle text-primary border-primary-subtle",
                                                    "A" => "bg-danger-subtle text-danger border-danger-subtle",
                                                    "W" => "bg-light text-muted border-light-subtle",
                                                    "H" => "bg-warning-subtle text-warning-emphasis border-warning-subtle",
                                                    _ => "bg-light text-muted"
                                                };
                                                <td class="text-center py-2">
                                                    <span class="badge border fw-bold @pillClass" style="width: 26px; height: 26px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 0.7rem;">@code</span>
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="workspace-empty-state">
                            <i class="bi bi-people workspace-empty-icon"></i>
                            <div class="small fw-medium">No department colleagues found.</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Sticky Column: Calendar Widget + Upcoming Holidays -->
        <div class="col-lg-4 workspace-col-sticky">
            <!-- 1. Month Calendar -->
            <div class="workspace-card">
                <div class="workspace-card-header">
                    <h6 class="workspace-card-title">@Model.Calendar.MonthName</h6>
                    <div class="btn-group btn-group-sm">
                        <a asp-action="Index" asp-route-year="@prevMonthDate.Year" asp-route-month="@prevMonthDate.Month" class="btn btn-sm btn-light border text-secondary px-2 py-0.5 rounded-2 shadow-xs" title="Previous Month">
                            <i class="bi bi-chevron-left"></i>
                        </a>
                        <a asp-action="Index" asp-route-year="@nextMonthDate.Year" asp-route-month="@nextMonthDate.Month" class="btn btn-sm btn-light border text-secondary px-2 py-0.5 rounded-2 shadow-xs" title="Next Month">
                            <i class="bi bi-chevron-right"></i>
                        </a>
                    </div>
                </div>

                <div class="workspace-card-body">
                    <!-- Calendar Days Header -->
                    <div class="cal-grid mb-1" style="display: grid !important; grid-template-columns: repeat(7, 1fr) !important; gap: 4px !important;">
                        @foreach (var d in daysOfWeek)
                        {
                            <div class="cal-header-cell" style="text-align: center; font-size: 0.72rem; font-weight: 600; color: #64748b; padding: 4px 0;">@d</div>
                        }
                    </div>

                    <!-- Calendar Cells -->
                    <div class="cal-grid" style="display: grid !important; grid-template-columns: repeat(7, 1fr) !important; gap: 4px !important;">
                        @for (int i = 0; i < Model.Calendar.FirstDayOfWeekOffset; i++)
                        {
                            <div class="cal-cell cal-cell-empty"></div>
                        }

                        @for (int dayNum = 1; dayNum <= Model.Calendar.TotalDaysInMonth; dayNum++)
                        {
                            var cellDate = new DateOnly(Model.Calendar.Year, Model.Calendar.Month, dayNum);
                            var isToday = cellDate == DateOnly.FromDateTime(DateTime.Today);
                            var isWeekend = Model.Calendar.WeeklyOffDays.Contains(cellDate.DayOfWeek);
                            var isHoliday = Model.Calendar.Holidays.ContainsKey(cellDate);
                            var holidayName = isHoliday ? Model.Calendar.Holidays[cellDate] : null;

                            var hasAttendance = Model.Calendar.AttendanceByDate.ContainsKey(cellDate);
                            var att = hasAttendance ? Model.Calendar.AttendanceByDate[cellDate] : null;

                            string cellClass = "cal-cell";
                            string tooltipText = cellDate.ToString("dd MMM yyyy");

                            if (isToday) cellClass += " cal-cell-today";

                            if (isHoliday)
                            {
                                cellClass += " cal-cell-holiday";
                                tooltipText += $" - Holiday: {holidayName}";
                            }
                            else if (hasAttendance && att != null)
                            {
                                switch (att.Status)
                                {
                                    case Hrms.Attendance.Domain.Enums.AttendanceStatus.Present:
                                        cellClass += " cal-cell-present";
                                        tooltipText += $" - Present ({att.WorkedHours})";
                                        break;
                                    case Hrms.Attendance.Domain.Enums.AttendanceStatus.Late:
                                        cellClass += " cal-cell-late";
                                        tooltipText += $" - Late ({att.WorkedHours})";
                                        break;
                                    case Hrms.Attendance.Domain.Enums.AttendanceStatus.OnLeave:
                                        cellClass += " cal-cell-leave";
                                        tooltipText += " - On Leave";
                                        break;
                                    case Hrms.Attendance.Domain.Enums.AttendanceStatus.Absent:
                                        cellClass += " cal-cell-absent";
                                        tooltipText += " - Absent";
                                        break;
                                    case Hrms.Attendance.Domain.Enums.AttendanceStatus.Weekend:
                                        cellClass += " cal-cell-weekend";
                                        tooltipText += " - Weekend Off";
                                        break;
                                    case Hrms.Attendance.Domain.Enums.AttendanceStatus.Holiday:
                                        cellClass += " cal-cell-holiday";
                                        tooltipText += $" - Holiday: {holidayName}";
                                        break;
                                }
                            }
                            else if (isWeekend)
                            {
                                cellClass += " cal-cell-weekend";
                                tooltipText += " - Weekend Off";
                            }

                            <div class="@cellClass" data-bs-toggle="tooltip" title="@tooltipText" style="cursor: pointer; min-height: 32px; display: flex; align-items: center; justify-content: center; border-radius: 6px;" onclick="selectCalendarDay(this, '@cellDate.ToString("dddd, dd MMMM yyyy")', '@tooltipText')">
                                <span>@dayNum</span>
                            </div>
                        }
                    </div>

                    <!-- Legend -->
                    <div class="d-flex flex-wrap align-items-center justify-content-between mt-3 pt-2 border-top text-muted" style="font-size: 0.72rem;">
                        <span class="d-inline-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #10b981;"></span> Present
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #f59e0b;"></span> Holiday
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #94a3b8;"></span> Weekend
                        </span>
                        <span class="d-inline-flex align-items-center gap-1">
                            <span class="d-inline-block rounded-circle" style="width: 8px; height: 8px; background-color: #7c3aed;"></span> Leave
                        </span>
                    </div>

                    <!-- Day Info Inspector -->
                    <div id="calDayInspector" class="mt-2 p-2 px-3 rounded-3 bg-light border text-muted small d-none">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong id="calSelectedDate" class="text-dark d-block" style="font-size: 0.78rem;"></strong>
                                <span id="calSelectedDetail" class="text-muted" style="font-size: 0.74rem;"></span>
                            </div>
                            <button type="button" class="btn-close" style="font-size: 0.6rem;" onclick="document.getElementById('calDayInspector').classList.add('d-none');"></button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. Upcoming Holidays (Grouped consecutive days, max 3) -->
            <div class="workspace-card">
                <div class="workspace-card-header">
                    <h6 class="workspace-card-title">Holidays in @Model.Calendar.MonthName</h6>
                    <span class="badge bg-light text-secondary border fw-medium" style="font-size: 0.7rem;">@Model.Calendar.Holidays.Count total days</span>
                </div>

                <div class="workspace-card-body p-3">
                    @if (groupedHolidays.Count > 0)
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var g in groupedHolidays.Take(3))
                            {
                                var dateRange = g.Days > 1 
                                    ? $"{g.Start.ToString("dd MMM")} - {g.End.ToString("dd MMM")}"
                                    : g.Start.ToString("dd MMM yyyy");

                                <div class="p-2.5 rounded-3 bg-light border border-light-subtle d-flex justify-content-between align-items-center gap-2">
                                    <div class="overflow-hidden">
                                        <div class="fw-semibold text-dark small text-truncate">@g.Name</div>
                                        <div class="text-muted font-monospace" style="font-size: 0.72rem;">@dateRange</div>
                                    </div>
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle rounded-pill px-2.5 py-1 fw-bold" style="font-size: 0.72rem; flex-shrink: 0;">
                                        @g.Days day@(g.Days > 1 ? "s" : "")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="workspace-empty-state py-3">
                            <i class="bi bi-calendar-check workspace-empty-icon"></i>
                            <div class="small fw-medium">No public holidays this month.</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        function updateClock() {
            var el = document.getElementById('empLiveClock');
            if (!el) return;
            var now = new Date();
            var options = { timeZone: 'Asia/Dhaka', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true };
            el.textContent = now.toLocaleTimeString('en-US', options);
        }
        setInterval(updateClock, 1000);
    })();

    function selectCalendarDay(el, dateText, detailText) {
        var inspector = document.getElementById('calDayInspector');
        var dateEl = document.getElementById('calSelectedDate');
        var detailEl = document.getElementById('calSelectedDetail');
        if (inspector && dateEl && detailEl) {
            dateEl.textContent = dateText;
            detailEl.textContent = detailText;
            inspector.classList.remove('d-none');
        }
    }
</script>
