@{
    ViewData["Title"] = "Dashboard";
    var userInitial = !string.IsNullOrEmpty(CurrentUser.Email) ? CurrentUser.Email.Substring(0, 1).ToUpper() : "U";
    var grantedCount = Permissions.All.Count(p => CurrentUser.HasPermission(p));
    var userRoleTitle = CurrentUser.IsInRole("Admin") ? "System Administrator" : (CurrentUser.IsInRole("HR") ? "HR Manager" : "Employee");
}

<!-- Prototype Inspired Top Notification Banner -->
<div class="proto-alert-banner">
    <div class="proto-alert-banner-text">
        <i class="bi bi-info-circle-fill fs-5 text-warning"></i>
        <span>Welcome back! System operations and schedules are active in <strong>Asia/Dhaka</strong> standard time zone.</span>
    </div>
    @if (CurrentUser.HasPermission(Permissions.Employees.ViewOwn))
    {
        <a asp-area="Employees" asp-controller="Employees" asp-action="MyProfile" class="btn btn-sm btn-dark px-3 fw-semibold text-white text-nowrap" style="border-radius: 8px;">
            <i class="bi bi-person-circle me-1"></i> View Profile
        </a>
    }
</div>

<!-- Overview KPI Stat Cards (Matching Prototype Grid) -->
<div class="row g-3 mb-4">
    <!-- Card 1: Total Employees -->
    <div class="col-sm-6 col-xl">
        <div class="proto-stat-card">
            <div class="proto-stat-top">
                <span class="proto-stat-title">Total Workforce</span>
                <div class="proto-stat-icon-box proto-icon-purple">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div>
                <div class="proto-stat-value">Staff</div>
                <div class="proto-stat-subtitle">
                    @if (CurrentUser.HasPermission(Permissions.Employees.View))
                    {
                        <a asp-area="Employees" asp-controller="Employees" asp-action="Index" class="text-decoration-none text-primary fw-semibold d-inline-flex align-items-center gap-1">
                            <span>View Directory</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <span>Active Organization</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Card 2: Departments & Structure -->
    <div class="col-sm-6 col-xl">
        <div class="proto-stat-card">
            <div class="proto-stat-top">
                <span class="proto-stat-title">Organization</span>
                <div class="proto-stat-icon-box proto-icon-green">
                    <i class="bi bi-building"></i>
                </div>
            </div>
            <div>
                <div class="proto-stat-value">Structure</div>
                <div class="proto-stat-subtitle">
                    @if (CurrentUser.HasPermission(Permissions.Employees.Manage))
                    {
                        <a asp-area="Employees" asp-controller="Departments" asp-action="Index" class="text-decoration-none text-success fw-semibold d-inline-flex align-items-center gap-1">
                            <span>Manage Depts</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Operational</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Card 3: Shifts & Schedules -->
    <div class="col-sm-6 col-xl">
        <div class="proto-stat-card">
            <div class="proto-stat-top">
                <span class="proto-stat-title">Work Shifts</span>
                <div class="proto-stat-icon-box proto-icon-cyan">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div>
                <div class="proto-stat-value">Calendar</div>
                <div class="proto-stat-subtitle">
                    @if (CurrentUser.HasPermission(Permissions.Shifts.Manage))
                    {
                        <a asp-area="Calendar" asp-controller="Shifts" asp-action="Index" class="text-decoration-none text-info fw-semibold d-inline-flex align-items-center gap-1">
                            <span>Shift Roster</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <span>Shift Tracking</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Card 4: Holidays -->
    <div class="col-sm-6 col-xl">
        <div class="proto-stat-card">
            <div class="proto-stat-top">
                <span class="proto-stat-title">Company Holidays</span>
                <div class="proto-stat-icon-box proto-icon-orange">
                    <i class="bi bi-calendar-event"></i>
                </div>
            </div>
            <div>
                <div class="proto-stat-value">Holidays</div>
                <div class="proto-stat-subtitle">
                    @if (CurrentUser.HasPermission(Permissions.Holidays.View))
                    {
                        <a asp-area="Calendar" asp-controller="Holidays" asp-action="Index" class="text-decoration-none text-warning fw-semibold d-inline-flex align-items-center gap-1">
                            <span>View Calendar</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                    }
                    else
                    {
                        <span>Annual schedule</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Card 5: Role & Permissions -->
    <div class="col-sm-6 col-xl">
        <div class="proto-stat-card">
            <div class="proto-stat-top">
                <span class="proto-stat-title">Access Policy</span>
                <div class="proto-stat-icon-box proto-icon-rose">
                    <i class="bi bi-shield-check"></i>
                </div>
            </div>
            <div>
                <div class="proto-stat-value">@grantedCount <span class="fs-6 fw-normal text-muted">/ @Permissions.All.Count</span></div>
                <div class="proto-stat-subtitle">
                    <span class="badge badge-soft-primary">@userRoleTitle</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Lower Sections: Action Required & System Privileges -->
<div class="row g-4">
    <!-- Quick Security & Operational Actions -->
    <div class="col-lg-5">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="proto-stat-icon-box proto-icon-purple" style="width: 32px; height: 32px; font-size: 1rem;">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>
                    <h6 class="fw-bold mb-0 text-dark">Quick Actions</h6>
                </div>
                <span class="badge badge-soft-secondary font-monospace">Authorized</span>
            </div>

            <div class="p-3">
                <div class="list-group list-group-flush">
                    @if (CurrentUser.HasPermission(Permissions.Employees.Manage))
                    {
                        <a asp-area="Employees" asp-controller="Employees" asp-action="Create" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 rounded-3 mb-2 border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="proto-stat-icon-box proto-icon-green" style="width: 36px; height: 36px; font-size: 1.05rem;">
                                    <i class="bi bi-person-plus-fill"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">Onboard New Employee</div>
                                    <div class="text-muted" style="font-size: 0.74rem;">Register staff details and assign grade</div>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    }

                    @if (CurrentUser.HasPermission(Permissions.Shifts.Manage))
                    {
                        <a asp-area="Calendar" asp-controller="ShiftAssignments" asp-action="Assign" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 rounded-3 mb-2 border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="proto-stat-icon-box proto-icon-cyan" style="width: 36px; height: 36px; font-size: 1.05rem;">
                                    <i class="bi bi-clock"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">Assign Employee Shift</div>
                                    <div class="text-muted" style="font-size: 0.74rem;">Schedule shifts with effective dates</div>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    }

                    @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                    {
                        <a asp-area="" asp-controller="Users" asp-action="Create" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 rounded-3 mb-2 border">
                            <div class="d-flex align-items-center gap-3">
                                <div class="proto-stat-icon-box proto-icon-purple" style="width: 36px; height: 36px; font-size: 1.05rem;">
                                    <i class="bi bi-person-gear"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark small">Create User Account</div>
                                    <div class="text-muted" style="font-size: 0.74rem;">Provide system credentials for staff</div>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    }

                    <a asp-area="" asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3 rounded-3 border">
                        <div class="d-flex align-items-center gap-3">
                            <div class="proto-stat-icon-box proto-icon-rose" style="width: 36px; height: 36px; font-size: 1.05rem;">
                                <i class="bi bi-key-fill"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">Change Password</div>
                                <div class="text-muted" style="font-size: 0.74rem;">Update personal security secret</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Permission Claims Matrix -->
    <div class="col-lg-7">
        <div class="card-modern h-100">
            <div class="card-modern-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="proto-stat-icon-box proto-icon-purple" style="width: 32px; height: 32px; font-size: 1rem;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0 text-dark">Your Assigned Permissions</h6>
                        <small class="text-muted" style="font-size: 0.75rem;">Verified claims bound to your authentication cookie</small>
                    </div>
                </div>
                <span class="badge badge-soft-primary font-monospace">@grantedCount Claims Active</span>
            </div>

            <div class="p-3">
                <div class="d-flex flex-wrap gap-2" style="max-height: 290px; overflow-y: auto;">
                    @foreach (var permission in Permissions.All)
                    {
                        if (CurrentUser.HasPermission(permission))
                        {
                            <span class="badge badge-soft-success font-monospace" style="font-size: 0.76rem; padding: 0.4em 0.75em;">
                                <i class="bi bi-check2"></i> @permission
                            </span>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
