@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card-modern p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <span class="badge badge-soft-primary mb-2">Authenticated Session</span>
                <h3 class="fw-bold mb-1">Welcome back, @CurrentUser.Email</h3>
                <p class="text-muted mb-0">Human Resource Management System — Identity & Role Management</p>
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                {
                    <a asp-controller="Users" asp-action="Create" class="btn btn-primary-modern">
                        <i class="bi bi-person-plus me-1"></i> New User
                    </a>
                }
                @if (CurrentUser.HasPermission(Permissions.Roles.Manage))
                {
                    <a asp-controller="Roles" asp-action="Create" class="btn btn-secondary-modern">
                        <i class="bi bi-shield-plus me-1"></i> New Role
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card card-hover">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Role Status</span>
                    <h4 class="fw-bold mt-1 mb-0">
                        @if (CurrentUser.IsInRole("Admin"))
                        {
                            <span class="text-primary"><i class="bi bi-shield-fill-check me-1"></i>Administrator</span>
                        }
                        else if (CurrentUser.IsInRole("HR"))
                        {
                            <span class="text-info"><i class="bi bi-person-badge-fill me-1"></i>HR Manager</span>
                        }
                        else
                        {
                            <span class="text-secondary"><i class="bi bi-person-fill me-1"></i>Employee</span>
                        }
                    </h4>
                </div>
                <div class="stat-icon bg-primary-subtle text-primary">
                    <i class="bi bi-person-check"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top small text-muted">
                System role privileges enabled
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card card-hover">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">User Directory</span>
                    <h4 class="fw-bold mt-1 mb-0">Identity Module</h4>
                </div>
                <div class="stat-icon bg-success-subtle text-success">
                    <i class="bi bi-people"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top small text-muted">
                <a asp-controller="Users" asp-action="Index" class="text-decoration-none fw-semibold">
                    View active directory <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="stat-card card-hover">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Access Control</span>
                    <h4 class="fw-bold mt-1 mb-0">Claims & Policies</h4>
                </div>
                <div class="stat-icon bg-warning-subtle text-warning">
                    <i class="bi bi-key"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top small text-muted">
                <a asp-controller="Roles" asp-action="Index" class="text-decoration-none fw-semibold">
                    Manage permission sets <i class="bi bi-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card-modern p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-shield-lock me-2 text-primary"></i>Your Granted Permissions</h5>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var permission in Permissions.All)
                {
                    if (CurrentUser.HasPermission(permission))
                    {
                        <span class="badge badge-soft-success font-monospace">@permission</span>
                    }
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card-modern p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-gear me-2 text-primary"></i>Security Quick Links</h5>
            <div class="list-group list-group-flush">
                <a asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0">
                    <div>
                        <strong>Change Password</strong>
                        <div class="text-muted small">Update your account login password</div>
                    </div>
                    <i class="bi bi-chevron-right text-muted"></i>
                </a>
                @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                {
                    <a asp-controller="Users" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0">
                        <div>
                            <strong>Manage Users</strong>
                            <div class="text-muted small">Create, edit, reset password, activate or deactivate accounts</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                }
                @if (CurrentUser.HasPermission(Permissions.Roles.Manage))
                {
                    <a asp-controller="Roles" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0">
                        <div>
                            <strong>Manage Roles & Permissions</strong>
                            <div class="text-muted small">Assign permission claims to roles</div>
                        </div>
                        <i class="bi bi-chevron-right text-muted"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
