@model Hrms.Reports.Application.Models.DashboardSummaryDto?
@{
    ViewData["Title"] = "Dashboard";
    var userInitial = !string.IsNullOrEmpty(CurrentUser.Email) ? CurrentUser.Email.Substring(0, 1).ToUpper() : "U";
    var grantedCount = Permissions.All.Count(p => CurrentUser.HasPermission(p));
    var userRoleTitle = CurrentUser.IsInRole("Admin") ? "System Administrator" : (CurrentUser.IsInRole("HR") ? "HR Manager" : "Employee");
}

<!-- Top Notification Banner -->
<div class="proto-alert-banner">
    <div class="proto-alert-banner-text">
        <i class="bi bi-info-circle-fill fs-5 text-warning"></i>
        <span>Welcome back! System operations and schedules are active in <strong>Asia/Dhaka</strong> standard time zone.</span>
    </div>
    @if (CurrentUser.HasPermission(Permissions.Employees.ViewOwn))
    {
        <a asp-area="Employees" asp-controller="Employees" asp-action="MyProfile" class="btn btn-sm btn-dark px-3 fw-semibold text-white text-nowrap" style="border-radius: 8px;">
            <i class="bi bi-person-circle me-1"></i> View Profile
        </a>
    }
</div>

@if (Model != null)
{
    <!-- Management KPI Stat Cards -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Total Employees -->
        <div class="col-sm-6 col-xl">
            <div class="proto-stat-card">
                <div class="proto-stat-top">
                    <span class="proto-stat-title">Total Workforce</span>
                    <div class="proto-stat-icon-box proto-icon-purple">
                        <i class="bi bi-people-fill"></i>
                    </div>
                </div>
                <div>
                    <div class="proto-stat-value">@Model.TotalActiveEmployees</div>
                    <div class="proto-stat-subtitle">
                        @if (CurrentUser.HasPermission(Permissions.Employees.View))
                        {
                            <a asp-area="Employees" asp-controller="Employees" asp-action="Index" class="text-decoration-none text-primary fw-semibold d-inline-flex align-items-center gap-1">
                                <span>Directory</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <span>Active Staff</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 2: Today's Attendance -->
        <div class="col-sm-6 col-xl">
            <div class="proto-stat-card">
                <div class="proto-stat-top">
                    <span class="proto-stat-title">Today's Present</span>
                    <div class="proto-stat-icon-box proto-icon-green">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
                <div>
                    <div class="proto-stat-value text-success">@Model.TodayPresent <span class="fs-6 fw-normal text-muted">/ @Model.TotalActiveEmployees</span></div>
                    <div class="proto-stat-subtitle">
                        @if (Model.TodayLate > 0)
                        {
                            <span class="text-danger fw-semibold">(@Model.TodayLate Late)</span>
                        }
                        else
                        {
                            <span class="text-success"><i class="bi bi-check-circle-fill me-1"></i>On Schedule</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 3: Pending Approvals -->
        <div class="col-sm-6 col-xl">
            <div class="proto-stat-card">
                <div class="proto-stat-top">
                    <span class="proto-stat-title">Leave Approvals</span>
                    <div class="proto-stat-icon-box proto-icon-orange">
                        <i class="bi bi-clipboard-check"></i>
                    </div>
                </div>
                <div>
                    <div class="proto-stat-value @(Model.PendingLeaveApprovals > 0 ? "text-danger" : "text-dark")">@Model.PendingLeaveApprovals</div>
                    <div class="proto-stat-subtitle">
                        @if (CurrentUser.HasPermission(Permissions.Leave.Approve))
                        {
                            <a asp-area="Leave" asp-controller="Approvals" asp-action="Index" class="text-decoration-none text-warning fw-semibold d-inline-flex align-items-center gap-1">
                                <span>Review Queue</span>
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        }
                        else
                        {
                            <span>Pending Requests</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 4: Hardware & Assets -->
        <div class="col-sm-6 col-xl">
            <div class="proto-stat-card">
                <div class="proto-stat-top">
                    <span class="proto-stat-title">Assigned Assets</span>
                    <div class="proto-stat-icon-box proto-icon-cyan">
                        <i class="bi bi-laptop"></i>
                    </div>
                </div>
                <div>
                    <div class="proto-stat-value">@Model.TotalAssignedAssets</div>
                    <div class="proto-stat-subtitle">
                        <span class="text-muted">@Model.TotalAvailableAssets Available</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Card 5: Role & Policy -->
        <div class="col-sm-6 col-xl">
            <div class="proto-stat-card">
                <div class="proto-stat-top">
                    <span class="proto-stat-title">Access Policy</span>
                    <div class="proto-stat-icon-box proto-icon-rose">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
                <div>
                    <div class="proto-stat-value">@grantedCount <span class="fs-6 fw-normal text-muted">/ @Permissions.All.Count</span></div>
                    <div class="proto-stat-subtitle">
                        <span class="badge badge-soft-primary">@userRoleTitle</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Attendance Real-Time Breakdown Strip -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-pie-chart text-primary fs-5"></i>
                    <h6 class="fw-bold mb-0 text-dark">Today's Attendance Status Breakdown (@Model.TodayDate.ToString("dddd, MMMM dd, yyyy"))</h6>
                </div>
                @if (CurrentUser.HasPermission(Permissions.Attendance.Manage))
                {
                    <a asp-area="Attendance" asp-controller="DailySheet" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-pencil-square me-1"></i> Open Daily Sheet
                    </a>
                }
            </div>

            <div class="row g-2 text-center">
                <div class="col-4 col-md-2">
                    <div class="p-2 rounded-3 bg-success-subtle text-success border border-success-subtle">
                        <span class="small fw-semibold d-block">Present</span>
                        <h4 class="fw-bold mb-0 mt-1">@Model.TodayPresent</h4>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div class="p-2 rounded-3 bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                        <span class="small fw-semibold d-block">Late</span>
                        <h4 class="fw-bold mb-0 mt-1">@Model.TodayLate</h4>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div class="p-2 rounded-3 bg-info-subtle text-info-emphasis border border-info-subtle">
                        <span class="small fw-semibold d-block">Half Day</span>
                        <h4 class="fw-bold mb-0 mt-1">@Model.TodayHalfDay</h4>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div class="p-2 rounded-3 bg-danger-subtle text-danger border border-danger-subtle">
                        <span class="small fw-semibold d-block">Absent</span>
                        <h4 class="fw-bold mb-0 mt-1">@Model.TodayAbsent</h4>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div class="p-2 rounded-3 bg-primary-subtle text-primary border border-primary-subtle">
                        <span class="small fw-semibold d-block">On Leave</span>
                        <h4 class="fw-bold mb-0 mt-1">@Model.TodayOnLeave</h4>
                    </div>
                </div>
                <div class="col-4 col-md-2">
                    <div class="p-2 rounded-3 bg-light text-muted border">
                        <span class="small fw-semibold d-block">Off / Holiday</span>
                        <h4 class="fw-bold mb-0 mt-1">@Model.TodayWeekendOrHoliday</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Basic Employee KPI Grid -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-xl">
            <div class="proto-stat-card">
                <div class="proto-stat-top">
                    <span class="proto-stat-title">Access Policy</span>
                    <div class="proto-stat-icon-box proto-icon-rose">
                        <i class="bi bi-shield-check"></i>
                    </div>
                </div>
                <div>
                    <div class="proto-stat-value">@grantedCount <span class="fs-6 fw-normal text-muted">/ @Permissions.All.Count</span></div>
                    <div class="proto-stat-subtitle">
                        <span class="badge badge-soft-primary">@userRoleTitle</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Lower Sections: Recent Check-ins & Upcoming Holidays -->
<div class="row g-4">
    <!-- Today's Recent Check-ins -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history text-primary"></i>
                    <h6 class="fw-bold mb-0 text-dark">Today's Check-in Feed</h6>
                </div>
                @if (CurrentUser.HasPermission(Permissions.Reports.View))
                {
                    <a asp-area="Reports" asp-controller="Reports" asp-action="Attendance" class="btn btn-sm btn-outline-secondary">
                        Full Attendance Report
                    </a>
                }
            </div>
            <div class="card-body p-0">
                @if (Model != null && Model.RecentAttendances.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted small">
                                <tr>
                                    <th class="ps-3 py-2">EMPLOYEE</th>
                                    <th class="py-2">DEPARTMENT</th>
                                    <th class="py-2">CHECK IN</th>
                                    <th class="py-2 text-center">STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RecentAttendances)
                                {
                                    <tr>
                                        <td class="ps-3 py-2">
                                            <div class="fw-semibold text-dark small">@item.FullName</div>
                                            <span class="text-muted" style="font-size: 0.75rem;">@item.EmployeeCode</span>
                                        </td>
                                        <td class="small">@item.Department</td>
                                        <td class="small">@(item.CheckIn?.ToString("HH:mm") ?? "-")</td>
                                        <td class="text-center">
                                            @switch (item.Status)
                                            {
                                                case Hrms.Attendance.Domain.Enums.AttendanceStatus.Present:
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Present</span>
                                                    break;
                                                case Hrms.Attendance.Domain.Enums.AttendanceStatus.Late:
                                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">Late (@item.LateMinutes m)</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-muted border">@item.Status</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-clock fs-1 d-block mb-2 text-secondary opacity-50"></i>
                        No check-ins recorded yet for today.
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Upcoming Holidays & Fast Shortcuts -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar-event text-warning"></i>
                    <h6 class="fw-bold mb-0 text-dark">Upcoming Holidays (30 Days)</h6>
                </div>
                @if (CurrentUser.HasPermission(Permissions.Holidays.View))
                {
                    <a asp-area="Calendar" asp-controller="Holidays" asp-action="Index" class="btn btn-sm btn-link text-decoration-none">View All</a>
                }
            </div>
            <div class="card-body p-3 pt-0">
                @if (Model != null && Model.UpcomingHolidays.Count > 0)
                {
                    <div class="list-group list-group-flush">
                        @foreach (var h in Model.UpcomingHolidays)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2 border-0 border-bottom">
                                <div>
                                    <div class="fw-semibold text-dark small">@h.Name</div>
                                    <small class="text-muted">@h.HolidayDate.ToString("MMMM dd, yyyy") (@h.Type)</small>
                                </div>
                                <span class="badge bg-light text-primary border">In @h.DaysUntil days</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small py-3 text-center">
                        No official holidays in the next 30 days.
                    </div>
                }
            </div>
        </div>

        <!-- Quick Access Shortcuts -->
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 py-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-lightning-charge-fill text-primary"></i>
                    <h6 class="fw-bold mb-0 text-dark">Quick Navigation</h6>
                </div>
            </div>
            <div class="card-body p-3 pt-0">
                <div class="d-grid gap-2">
                    @if (CurrentUser.HasPermission(Permissions.Reports.View))
                    {
                        <a asp-area="Reports" asp-controller="Reports" asp-action="Index" class="btn btn-light text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-file-earmark-bar-graph me-2 text-primary"></i>Reports Center & Excel Export</span>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    }
                    @if (CurrentUser.HasPermission(Permissions.Employees.Manage))
                    {
                        <a asp-area="Employees" asp-controller="Employees" asp-action="Create" class="btn btn-light text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-plus me-2 text-success"></i>Onboard New Employee</span>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    }
                    @if (CurrentUser.HasPermission(Permissions.Attendance.Manage))
                    {
                        <a asp-area="Attendance" asp-controller="DailySheet" asp-action="Index" class="btn btn-light text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-calendar-check me-2 text-info"></i>Daily Attendance Sheet</span>
                            <i class="bi bi-chevron-right text-muted small"></i>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
