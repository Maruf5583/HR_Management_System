@{
    ViewData["Title"] = "Dashboard";
    var userInitial = !string.IsNullOrEmpty(CurrentUser.Email) ? CurrentUser.Email.Substring(0, 1).ToUpper() : "U";
    var grantedCount = Permissions.All.Count(p => CurrentUser.HasPermission(p));
}

<!-- Welcome Hero Banner -->
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card-modern p-4 p-md-5 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4" style="background: radial-gradient(circle at right top, #eef2ff 0%, #ffffff 60%);">
            <div class="d-flex align-items-center gap-3">
                <div class="avatar-circle shadow" style="width: 56px; height: 56px; font-size: 1.5rem;">
                    @userInitial
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge badge-soft-primary">
                            <span class="status-dot status-dot-active"></span> Authenticated Session
                        </span>
                        @if (CurrentUser.IsInRole("Admin"))
                        {
                            <span class="badge bg-primary text-white"><i class="bi bi-shield-fill-check me-1"></i>Administrator</span>
                        }
                        else if (CurrentUser.IsInRole("HR"))
                        {
                            <span class="badge bg-info text-dark"><i class="bi bi-person-badge-fill me-1"></i>HR Manager</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary text-white"><i class="bi bi-person-fill me-1"></i>Employee</span>
                        }
                    </div>
                    <h2 class="fw-bold text-dark mb-1 tracking-tight">Welcome, @CurrentUser.Email</h2>
                    <p class="text-muted small mb-0">Human Resource Management System &bull; Identity & Access Management Module</p>
                </div>
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                {
                    <a asp-controller="Users" asp-action="Create" class="btn btn-primary-modern">
                        <i class="bi bi-person-plus-fill"></i>
                        <span>New User</span>
                    </a>
                }
                @if (CurrentUser.HasPermission(Permissions.Roles.Manage))
                {
                    <a asp-controller="Roles" asp-action="Create" class="btn btn-secondary-modern">
                        <i class="bi bi-shield-plus"></i>
                        <span>New Role</span>
                    </a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Overview KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="kpi-card card-hover h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="kpi-label">Security Role</span>
                    <div class="kpi-value mt-1 text-primary">
                        @if (CurrentUser.IsInRole("Admin"))
                        {
                            <span>Admin</span>
                        }
                        else if (CurrentUser.IsInRole("HR"))
                        {
                            <span>HR</span>
                        }
                        else
                        {
                            <span>Employee</span>
                        }
                    </div>
                </div>
                <div class="kpi-icon-box bg-primary-subtle text-primary">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
            </div>
            <div class="small text-muted mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                <span>Assigned Role Privileges</span>
                <span class="badge badge-soft-success">Active</span>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpi-card card-hover h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="kpi-label">User Directory</span>
                    <div class="kpi-value mt-1 text-dark">Identity</div>
                </div>
                <div class="kpi-icon-box bg-success-subtle text-success">
                    <i class="bi bi-people-fill"></i>
                </div>
            </div>
            <div class="small text-muted mt-3 pt-3 border-top">
                @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                {
                    <a asp-controller="Users" asp-action="Index" class="text-decoration-none fw-semibold text-primary d-inline-flex align-items-center gap-1">
                        <span>Manage User Accounts</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
                else
                {
                    <span>Account credentials managed</span>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpi-card card-hover h-100">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="kpi-label">Your Permissions</span>
                    <div class="kpi-value mt-1 text-indigo" style="color: #4338ca;">
                        @grantedCount <span class="fs-5 fw-normal text-muted">/ @Permissions.All.Count</span>
                    </div>
                </div>
                <div class="kpi-icon-box bg-indigo-subtle text-indigo" style="background-color: #e0e7ff; color: #4338ca;">
                    <i class="bi bi-key-fill"></i>
                </div>
            </div>
            <div class="small text-muted mt-3 pt-3 border-top">
                @if (CurrentUser.HasPermission(Permissions.Roles.Manage))
                {
                    <a asp-controller="Roles" asp-action="Index" class="text-decoration-none fw-semibold text-primary d-inline-flex align-items-center gap-1">
                        <span>Configure Role Claims</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                }
                else
                {
                    <span>Active claim policies in effect</span>
                }
            </div>
        </div>
    </div>
</div>

<!-- Lower Sections: Permissions Matrix & Quick Access -->
<div class="row g-4">
    <!-- Active Permissions List -->
    <div class="col-lg-7">
        <div class="card-modern p-4 h-100">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-shield-check text-primary fs-5"></i>
                    <h5 class="fw-bold mb-0 text-dark">Your Active Permission Claims</h5>
                </div>
                <span class="badge badge-soft-primary font-monospace">@grantedCount Active Claims</span>
            </div>
            <div class="d-flex flex-wrap gap-2 pt-1" style="max-height: 280px; overflow-y: auto;">
                @foreach (var permission in Permissions.All)
                {
                    if (CurrentUser.HasPermission(permission))
                    {
                        <span class="badge badge-soft-success font-monospace" style="font-size: 0.76rem;">
                            <i class="bi bi-check2"></i> @permission
                        </span>
                    }
                }
            </div>
        </div>
    </div>

    <!-- Quick Navigation Links -->
    <div class="col-lg-5">
        <div class="card-modern p-4 h-100">
            <div class="d-flex align-items-center gap-2 border-bottom pb-3 mb-3">
                <i class="bi bi-lightning-charge text-warning fs-5"></i>
                <h5 class="fw-bold mb-0 text-dark">Quick Security Actions</h5>
            </div>
            <div class="list-group list-group-flush">
                <a asp-controller="Account" asp-action="ChangePassword" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                    <div class="d-flex align-items-center gap-3">
                        <div class="stat-icon bg-light border text-primary" style="width: 38px; height: 38px; border-radius: 10px;">
                            <i class="bi bi-key"></i>
                        </div>
                        <div>
                            <div class="fw-bold text-dark small">Change Password</div>
                            <div class="text-muted" style="font-size: 0.76rem;">Update your authentication secret</div>
                        </div>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                </a>

                @if (CurrentUser.HasPermission(Permissions.Users.Manage))
                {
                    <a asp-controller="Users" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-light border text-success" style="width: 38px; height: 38px; border-radius: 10px;">
                                <i class="bi bi-people"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">Manage Users</div>
                                <div class="text-muted" style="font-size: 0.76rem;">Create, reset passwords, activate or deactivate</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                }

                @if (CurrentUser.HasPermission(Permissions.Roles.Manage))
                {
                    <a asp-controller="Roles" asp-action="Index" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0 py-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-icon bg-light border text-indigo" style="width: 38px; height: 38px; border-radius: 10px; color: #4338ca;">
                                <i class="bi bi-shield-check"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark small">Manage Roles & Permissions</div>
                                <div class="text-muted" style="font-size: 0.76rem;">Assign policy claims and customize roles</div>
                            </div>
                        </div>
                        <i class="bi bi-chevron-right text-muted small"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>
